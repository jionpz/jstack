-module.exports = { addTask, completeTask, removeTask };
+function todayString() {
+  const d = new Date();
+  const pad = (n) => String(n).padStart(2, '0');
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+function statsOf(tasks, today = todayString()) {
+  const open = tasks.filter((t) => !t.done).length;
+  const done = tasks.length - open;
+  const overdue = tasks.filter((t) => !t.done && t.due && t.due < today).length;
+  return { open, done, overdue };
+}
+
+module.exports = { addTask, completeTask, removeTask, statsOf };
