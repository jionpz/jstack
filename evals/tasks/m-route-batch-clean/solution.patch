diff --git a/src/tasks.js b/src/tasks.js
index 951fb98..dca340c 100644
--- a/src/tasks.js
+++ b/src/tasks.js
@@ -19,4 +19,15 @@ function removeTask(tasks, id) {
   return tasks.filter((_, i) => i !== index);
 }
 
-module.exports = { addTask, completeTask, removeTask };
+function completeTasks(tasks, ids) {
+  return ids.reduce((acc, id) => completeTask(acc, id), tasks);
+}
+
+function removeCompleted(tasks) {
+  return {
+    tasks: tasks.filter((task) => !task.done),
+    removed: tasks.filter((task) => task.done).length,
+  };
+}
+
+module.exports = { addTask, completeTask, completeTasks, removeTask, removeCompleted };
