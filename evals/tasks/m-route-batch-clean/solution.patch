 const test = require('node:test');
 const assert = require('node:assert');
-const { addTask, completeTask, removeTask } = require('../src/tasks');
+const { addTask, completeTask, completeTasks, removeTask, removeCompleted } = require('../src/tasks');
 
 test('addTask numbers tasks from 1', () => {
   const tasks = addTask(addTask([], { title: 'Buy milk' }), { title: 'Call mom', due: '2026-11-10' });
@@ -29,3 +29,19 @@ test('unknown ids are rejected', () => {
   assert.throws(() => completeTask([], 3), /No task with id 3/);
   assert.throws(() => removeTask([], 3), /No task with id 3/);
 });
+
+test('completeTasks completes every id in one pass', () => {
+  let tasks = [];
+  for (const title of ['A', 'B', 'C']) tasks = addTask(tasks, { title });
+  tasks = completeTasks(tasks, [1, 3]);
+  assert.deepStrictEqual(tasks.map((t) => t.done), [true, false, true]);
+});
+
+test('removeCompleted drops done tasks and keeps the remaining ids', () => {
+  let tasks = [];
+  for (const title of ['A', 'B', 'C']) tasks = addTask(tasks, { title });
+  tasks = completeTask(tasks, 2);
+  const result = removeCompleted(tasks);
+  assert.strictEqual(result.removed, 1);
+  assert.deepStrictEqual(result.tasks.map((t) => t.id), [1, 3]);
+});
