diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..738da38
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,22 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { isRealDate, addDays, addMonthsClamped } = require('../src/dates');
+
+test('isRealDate rejects impossible and malformed dates', () => {
+  assert.equal(isRealDate('2026-02-28'), true);
+  assert.equal(isRealDate('2028-02-29'), true);
+  assert.equal(isRealDate('2026-02-30'), false);
+  assert.equal(isRealDate('2026-13-01'), false);
+  assert.equal(isRealDate('2026-1-01'), false);
+});
+
+test('addDays crosses month and year boundaries', () => {
+  assert.equal(addDays('2026-12-30', 7), '2027-01-06');
+  assert.equal(addDays('2026-03-01', -1), '2026-02-28');
+});
+
+test('addMonthsClamped keeps the original day of month', () => {
+  assert.equal(addMonthsClamped('2030-01-31', 31, 1), '2030-02-28');
+  assert.equal(addMonthsClamped('2030-02-28', 31, 1), '2030-03-31');
+  assert.equal(addMonthsClamped('2030-04-30', 31, 1), '2030-05-31');
+});
