new file mode 100644
index 0000000..5676278
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,46 @@
+const DAY_MS = 86400000;
+
+function pad(n) {
+  return String(n).padStart(2, '0');
+}
+
+function daysInMonth(year, month) {
+  return new Date(Date.UTC(year, month, 0)).getUTCDate();
+}
+
+function todayString() {
+  const now = new Date();
+  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
+}
+
+function isRealDate(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const [year, month, day] = value.split('-').map(Number);
+  if (month < 1 || month > 12) return false;
+  return day >= 1 && day <= daysInMonth(year, month);
+}
+
+function formatUtc(ms) {
+  const d = new Date(ms);
+  return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
+}
+
+function addDays(date, days) {
+  const [year, month, day] = date.split('-').map(Number);
+  return formatUtc(Date.UTC(year, month - 1, day + days));
+}
+
+function addMonthsClamped(date, anchorDay, months) {
+  const [year, month] = date.split('-').map(Number);
+  const total = year * 12 + (month - 1) + months;
+  const nextYear = Math.floor(total / 12);
+  const nextMonth = (total % 12) + 1;
+  const day = Math.min(anchorDay, daysInMonth(nextYear, nextMonth));
+  return `${nextYear}-${pad(nextMonth)}-${pad(day)}`;
+}
+
+function dayOfMonth(date) {
+  return Number(date.slice(8, 10));
+}
+
+module.exports = { DAY_MS, todayString, isRealDate, addDays, addMonthsClamped, dayOfMonth };
