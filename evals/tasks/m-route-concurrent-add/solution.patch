-module.exports = { defaultFile, load, save };
+function sleep(ms) {
+  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
+}
+
+function withLock(file, fn) {
+  const lock = `${file}.lock`;
+  const started = Date.now();
+  let fd;
+  for (;;) {
+    try {
+      fd = fs.openSync(lock, 'wx');
+      break;
+    } catch (err) {
+      if (err.code !== 'EEXIST') throw err;
+      try {
+        if (Date.now() - fs.statSync(lock).mtimeMs > 10000) {
+          fs.unlinkSync(lock);
+          continue;
+        }
+      } catch {
+        // The holder released the lock between openSync and statSync; retry.
+      }
+      if (Date.now() - started > 5000) throw new Error(`Could not lock ${file}`);
+      sleep(5);
+    }
+  }
+  try {
+    return fn();
+  } finally {
+    fs.closeSync(fd);
+    try {
+      fs.unlinkSync(lock);
+    } catch {
+      // Already removed.
+    }
+  }
+}
+
+module.exports = { defaultFile, load, save, withLock };
diff --git b/test/store.test.js b/test/store.test.js
new file mode 100644
index 0000000..eef4182
--- /dev/null
+++ b/test/store.test.js
@@ -0,0 +1,27 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const store = require('../src/store');
+
+function tempFile() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tasknotes-'));
+  return path.join(dir, 'tasks.json');
+}
+
+test('withLock serializes and removes the lock file', () => {
+  const file = tempFile();
+  const result = store.withLock(file, () => {
+    assert.ok(fs.existsSync(`${file}.lock`), 'lock should be held inside the critical section');
+    return 42;
+  });
+  assert.strictEqual(result, 42);
+  assert.ok(!fs.existsSync(`${file}.lock`), 'lock should be released');
+});
+
+test('withLock releases the lock when the work throws', () => {
+  const file = tempFile();
+  assert.throws(() => store.withLock(file, () => { throw new Error('boom'); }), /boom/);
+  assert.ok(!fs.existsSync(`${file}.lock`), 'lock should be released after an error');
+});
