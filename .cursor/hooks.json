{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "\"${CURSOR_PROJECT_DIR}/.jstack/vendor/plugins/flow\"/hooks/guard.sh",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PROJECT_DIR}/.jstack/vendor/plugins/flow\"/hooks/prompt.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PROJECT_DIR}/.jstack/vendor/plugins/flow\"/hooks/stop.sh",
        "timeout": 10,
        "loop_limit": 3
      }
    ]
  }
}
