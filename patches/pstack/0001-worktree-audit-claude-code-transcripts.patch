diff --git a/skills/poteto-mode/scripts/worktree-audit.sh b/skills/poteto-mode/scripts/worktree-audit.sh
index 47e0891..784ea50 100755
--- a/skills/poteto-mode/scripts/worktree-audit.sh
+++ b/skills/poteto-mode/scripts/worktree-audit.sh
@@ -69,9 +69,16 @@ elif raw=$(gh pr list --author "@me" --state all --limit 1000 \
 fi
 [ -s "$prs" ] || echo "[]" > "$prs"
 
-# Transcripts dir: ~/.cursor/projects/<slugified-repo-path>/agent-transcripts.
-slug=$(printf '%s' "$main_wt" | sed 's#^/##; s#/#-#g')
-transcripts="$HOME/.cursor/projects/$slug/agent-transcripts"
+# Transcript folders: ~/.claude/projects/<slug>, where <slug> is the path with
+# every character other than a letter or digit changed to "-". A session started
+# inside a worktree gets that worktree's own folder, so search both.
+cc_slug() { printf '%s' "$1" | sed 's#[^A-Za-z0-9]#-#g'; }
+transcript_dirs() {
+	for p in "$@"; do
+		d="$HOME/.claude/projects/$(cc_slug "$p")"
+		if [ -d "$d" ]; then printf '%s\n' "$d"; fi
+	done
+}
 now=$(date +%s)
 
 echo "# base: $base"
@@ -111,8 +118,9 @@ git worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r wt;
 	# Most recent chat whose transcript operated in this worktree. Match path
 	# followed by "/" or a quote so glint-482 does not match glint-482-r37.
 	last="-"; last_ts=0
-	if [ -d "$transcripts" ]; then
-		f=$(rg -l -e "${wt}/" -e "${wt}\"" "$transcripts" 2>/dev/null \
+	dirs=$(transcript_dirs "$main_wt" "$wt" | sort -u)
+	if [ -n "$dirs" ]; then
+		f=$(printf '%s\n' "$dirs" | tr '\n' '\0' | xargs -0 rg -l -e "${wt}/" -e "${wt}\"" 2>/dev/null \
 			| xargs stat "${stat_fmt[@]}" 2>/dev/null | sort -rn | head -1)
 		if [ -n "$f" ]; then last_ts=$(echo "$f" | awk '{print $1}')
 			last=$(fmt_day "$last_ts" 2>/dev/null); fi
