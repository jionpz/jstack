{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "JSTACK_CURSOR_HOOK_SOURCE=claude-project exec \"${CLAUDE_PROJECT_DIR}/.jstack/vendor/plugins/flow/hooks/prompt.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "JSTACK_CURSOR_HOOK_SOURCE=claude-project exec \"${CLAUDE_PROJECT_DIR}/.jstack/vendor/plugins/flow/hooks/guard.sh\" --stage-only",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "JSTACK_CURSOR_HOOK_SOURCE=claude-project exec \"${CLAUDE_PROJECT_DIR}/.jstack/vendor/plugins/flow/hooks/stop.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
