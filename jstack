#!/usr/bin/env bash
# jstack：维护并安装 jstack marketplace。它发布两个插件：
#   pstack  原版 pstack 的 Claude Code 版（cursor/plugins）
#   spec    Matt Pocock skills 里负责需求澄清和任务拆解的几个（mattpocock/skills），产出交给 pstack 执行
#   flow    jstack 自己写的衔接层（src/flow），按任务大小把 spec 和 pstack 接起来
#
#   ./jstack install [--scope user|project|local]  安装全部插件，已装则刷新
#   ./jstack sync [插件 [ref]]                     拉取上游（不写插件就全部同步，ref 默认 main），然后 build
#   ./jstack build                                 用 upstream/ + patches/（flow 用 src/flow）重建 plugins/
#   ./jstack check                                 校验构建产物、锁文件、Cursor 残留、frontmatter、skill 依赖、manifest
#
# upstream/<插件> 是上游原样副本，plugins/<插件> 是构建产物，两者都不要手改。
# 要改 pstack 或 spec，就在 patches/<插件>/ 下加补丁；flow 没有上游，直接改 src/flow。
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
MARKETPLACE=jstack
PLUGINS="pstack spec flow"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

die() { printf 'jstack: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
json_get() { sed -n "s/^ *\"$1\": *\"\([^\"]*\)\".*/\1/p" "$2" | head -1; }

# 切换到插件 $1：设置它的上游仓库、上游路径、只取哪些文件（PICK，空表示整个路径）和本地目录。
use_plugin() {
	PLUGIN=$1 PICK= OWN=
	VENDOR="$ROOT/upstream/$PLUGIN"
	LOCK="$ROOT/upstream/$PLUGIN.lock.json"
	case $PLUGIN in
	pstack)
		UPSTREAM_REPO=https://github.com/cursor/plugins.git
		UPSTREAM_PATH=harness/pstack/claude-code
		;;
	spec)
		# 只取需求澄清、任务拆解的 5 个 skill（grill-with-docs 到 handoff），加上它们运行时要用的：
		# grilling 到 prototype 由它们通过 Skill 工具调用（check 会核对），setup-matt-pocock-skills
		# 是 to-spec、to-tickets、wayfinder 要求先运行的配置。实现交给 /pstack:poteto-mode，所以不取
		# implement、implement-spec 这类实现编排。增删时同步改 patches/spec/0001 里的 skills 清单。
		UPSTREAM_REPO=https://github.com/mattpocock/skills.git
		UPSTREAM_PATH=.
		PICK="LICENSE
			skills/engineering/grill-with-docs
			skills/engineering/to-spec
			skills/engineering/to-tickets
			skills/engineering/wayfinder
			skills/productivity/handoff
			skills/productivity/grilling
			skills/engineering/domain-modeling
			skills/engineering/research
			skills/engineering/prototype
			skills/engineering/setup-matt-pocock-skills"
		;;
	flow)
		# jstack 自己的插件，没有上游：源码在 src/flow，版本基数取它自己的 plugin.json。
		OWN=1 VENDOR="$ROOT/src/$PLUGIN" LOCK="$ROOT/src/$PLUGIN/.claude-plugin/plugin.json"
		;;
	*) die "没有插件 $PLUGIN，可选：$PLUGINS" ;;
	esac
	PATCHES="$ROOT/patches/$PLUGIN"
	OUT="$ROOT/plugins/$PLUGIN"
}

# 目录 $1 的内容哈希，文件路径和内容都算在内；其余参数是额外的 find 过滤条件。
tree_hash() {
	local dir=$1
	shift
	(cd "$dir" && find . -type f ! -name .DS_Store ! -path '*/node_modules/*' "$@" -print0 |
		LC_ALL=C sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -d' ' -f1)
}

# 列出文件 frontmatter 里不在名单 $1 中的顶层键，每行"文件: 键"。不存在的文件跳过。
fm_unknown_keys() {
	local allow=$1 f
	shift
	for f in "$@"; do
		[ -f "$f" ] || continue
		awk 'NR==1 && $0!="---"{exit} NR>1 && /^---$/{exit} NR>1 && /^[A-Za-z_][A-Za-z0-9_-]*:/{sub(/:.*/,""); print}' "$f" |
			grep -vxE "$allow" | sed "s|^|${f#"$ROOT"/}: |" || true
	done
}

# 把 upstream/ 加补丁构建到 $1。版本号写成 <上游版本>+jstack.<内容哈希>：
# 内容一变版本就变，从 GitHub 安装的机器才收得到更新。上游版本取自锁文件，
# 因为 spec 不收上游的 plugin.json，它的 manifest 由补丁新建。
build_into() {
	local dest=$1 patch manifest version hash
	version=$(json_get version "$LOCK" 2>/dev/null || true)
	[ -d "$VENDOR" ] && [ -n "$version" ] || die "缺少 ${VENDOR#"$ROOT"/} 或它的版本号$([ -n "$OWN" ] || echo "，先运行 ./jstack sync $PLUGIN")"
	mkdir -p "$dest"
	rsync -a --delete --exclude node_modules "$VENDOR/" "$dest/"
	for patch in "$PATCHES"/*.patch; do
		[ -e "$patch" ] || continue
		(cd "$dest" && git apply --check "$patch" 2>/dev/null && git apply "$patch") ||
			die "补丁 $(basename "$patch") 打不上，说明上游改了这段。对照 upstream/$PLUGIN 重做这个补丁；如果上游已经修好，就删掉它。"
	done
	manifest="$dest/.claude-plugin/plugin.json"
	[ -f "$manifest" ] || die "upstream/$PLUGIN 里没有 .claude-plugin/plugin.json，patches/$PLUGIN 也没有新建它"
	hash=$(tree_hash "$dest" ! -path ./.claude-plugin/plugin.json | cut -c1-7)
	sed "s/^\( *\"version\": *\"\)[^\"]*\"/\1$version+jstack.$hash\"/" "$manifest" >"$manifest.tmp"
	mv "$manifest.tmp" "$manifest"
	[ "$(json_get version "$manifest")" = "$version+jstack.$hash" ] || die "$PLUGIN 的 plugin.json 里没有 version"
}

build_plugin() {
	local patches
	build_into "$WORK/build/$PLUGIN"
	mkdir -p "$OUT"
	# 插件从这里原地加载，只改动内容变了的文件；node_modules 是 bun 在运行时装的，保留。
	rsync -rlpc --delete --exclude node_modules "$WORK/build/$PLUGIN/" "$OUT/"
	patches=("$PATCHES"/*.patch)
	[ -e "${patches[0]}" ] || patches=()
	say "✓ 已构建 plugins/$PLUGIN，版本 $(json_get version "$OUT/.claude-plugin/plugin.json")，打了 ${#patches[@]} 个补丁"
}

cmd_build() {
	local p
	for p in $PLUGINS; do
		use_plugin "$p"
		build_plugin
	done
}

sync_plugin() {
	local ref=$1 src="$WORK/upstream-$PLUGIN" stage="$WORK/pick-$PLUGIN" sha version changed path
	say "拉取 $UPSTREAM_REPO @ $ref ..."
	git init -q "$src"
	git -C "$src" remote add origin "$UPSTREAM_REPO"
	[ "$UPSTREAM_PATH" = . ] || git -C "$src" sparse-checkout set "$UPSTREAM_PATH"
	git -C "$src" fetch -q --depth 1 --filter=blob:none origin "$ref"
	git -C "$src" -c advice.detachedHead=false checkout -q FETCH_HEAD
	sha=$(git -C "$src" rev-parse HEAD)
	src="$src/$UPSTREAM_PATH"
	[ -f "$src/.claude-plugin/plugin.json" ] ||
		die "上游 ${sha:0:7} 里没有 $UPSTREAM_PATH/.claude-plugin/plugin.json，可能上游改了目录结构"
	version=$(json_get version "$src/.claude-plugin/plugin.json")
	if [ -n "$PICK" ]; then
		# 只取 PICK 列出的文件和目录，保留它们在上游的相对路径。
		for path in $PICK; do
			[ -e "$src/$path" ] || die "上游 ${sha:0:7} 里没有 $path，可能被改名或删掉了"
			mkdir -p "$stage/$(dirname "$path")"
			cp -R "$src/$path" "$stage/$(dirname "$path")/"
		done
		src=$stage
	fi
	mkdir -p "$VENDOR"
	# 按内容比对（-c），不同步 mtime：新 clone 的文件时间都是当前时间，按时间比会把每个文件都算成变化。
	# macOS 自带的 openrsync 仍会把每个文件列成 ".f..T...."（只是时间不同），计数时要排除这种行。
	changed=$(rsync -rlpci --delete "$src/" "$VENDOR/" | grep -cvE '^\.[^ ]\.\.[tT]\.* ' || true)
	cat >"$LOCK" <<EOF
{
  "repo": "$UPSTREAM_REPO",
  "path": "$UPSTREAM_PATH",
  "ref": "$ref",
  "sha": "$sha",
  "version": "$version",
  "tree": "$(tree_hash "$VENDOR")",
  "synced": "$(date -u +%Y-%m-%d)"
}
EOF
	if [ "$changed" = 0 ]; then
		say "上游 $PLUGIN 没有变化（$version @ ${sha:0:7}）"
	else
		printf '| %s | %s | %s | `%s` | %s 处文件变化 |\n' "$(date -u +%Y-%m-%d)" "$PLUGIN" "$version" "${sha:0:7}" "$changed" >>"$ROOT/SYNC-LOG.md"
		say "上游 $PLUGIN 有 $changed 处文件变化（$version @ ${sha:0:7}），已记入 SYNC-LOG.md"
	fi
	build_plugin
}

cmd_sync() {
	local p
	[ $# -le 2 ] || die "用法：./jstack sync [插件 [ref]]"
	for p in ${1:-$PLUGINS}; do
		use_plugin "$p"
		[ -z "$OWN" ] || { [ -z "${1:-}" ] || die "$p 没有上游，直接改 src/$p"; continue; }
		sync_plugin "${2:-main}"
	done
}

cmd_check() {
	local rc=0 p hits failed=
	for p in $PLUGINS; do
		use_plugin "$p"
		build_into "$WORK/check/$p"
		if diff -rq -x node_modules "$WORK/check/$p" "$OUT" >"$WORK/diff" 2>&1 &&
			diff <(cd "$WORK/check/$p" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) \
				<(cd "$OUT" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) >/dev/null; then
			say "✓ plugins/$PLUGIN 与 upstream/ 加 patches/ 的构建结果一致（$(json_get version "$OUT/.claude-plugin/plugin.json")）"
		else
			say "✗ plugins/$PLUGIN 与构建结果不一致：可能被手改过，或改了补丁后没有运行 ./jstack build"
			sed 's/^/  /' "$WORK/diff" | head -20
			rc=1
		fi
		# 锁文件记着 sync 写入时副本的内容哈希。对不上，说明副本被手改过，或者不是用 sync 更新的。
		if [ -n "$OWN" ]; then
			say "- $PLUGIN 没有上游，跳过锁文件校验"
		elif [ "$(json_get tree "$LOCK")" = "$(tree_hash "$VENDOR")" ]; then
			say "✓ upstream/$PLUGIN 与锁文件一致（$(json_get version "$LOCK") @ $(json_get sha "$LOCK" | cut -c1-7)）"
		else
			say "✗ upstream/$PLUGIN 与 upstream/$PLUGIN.lock.json 记录的内容对不上：副本只能由 ./jstack sync 写入"
			rc=1
		fi
		# 上游 adapter 只翻译 Markdown 里的 Cursor 名称，脚本里写死的 Cursor 路径要靠补丁修。
		if hits=$(grep -rnIE '(\$HOME|~)/\.cursor/|agent-transcripts' --exclude='*.md' --exclude-dir=node_modules "$OUT"); then
			say "✗ plugins/$PLUGIN 的脚本里还有写死的 Cursor 路径，需要补丁："
			printf '%s\n' "$hits" | sed "s|$ROOT/||; s/^/  /" | head -20
			rc=1
		else
			say "✓ plugins/$PLUGIN 的脚本里没有写死的 Cursor 路径"
		fi
		# frontmatter 由 Claude Code 自己解析，也不经过 adapter。不认识的键会被静默忽略，claude plugin validate
		# 也不报，例如 Cursor 的 is_background。名单取自 https://code.claude.com/docs/en/claude-directory，
		# 插件 agent 会忽略的 permissionMode、hooks、mcpServers、initialPrompt 不在名单里。
		# skill 名单多放了 icon 和 color：它们是 Cursor 界面用的，Claude Code 忽略了也不影响行为。
		# pstack 的 skill 在 skills/<名字>/，spec 沿用上游的 skills/<分类>/<名字>/。
		hits=$(
			fm_unknown_keys 'name|description|when_to_use|argument-hint|arguments|disable-model-invocation|user-invocable|allowed-tools|disallowed-tools|model|effort|context|agent|background|hooks|paths|shell|metadata|license|compatibility|icon|color' \
				"$OUT"/skills/*/SKILL.md "$OUT"/skills/*/*/SKILL.md
			fm_unknown_keys 'name|description|tools|disallowedTools|model|maxTurns|autoCompactWindow|skills|memory|background|effort|isolation|color|omitClaudeMd|experimental' \
				"$OUT"/agents/*.md
		)
		if [ -n "$hits" ]; then
			say "✗ plugins/$PLUGIN 的 frontmatter 里有 Claude Code 不认识的键，会被静默忽略，需要补丁："
			printf '%s\n' "$hits" | sed 's/^/  /' | head -20
			rc=1
		else
			say "✓ plugins/$PLUGIN 的 skill 和 agent frontmatter 都是 Claude Code 认识的键"
		fi
		# spec 只收了上游的一部分 skill。收录的 skill 写着 'Call the Skill tool ... "<名字>"' 时，
		# 被调用的 skill 也必须加载得到：在 skills/<名字>/ 下，或者列在 plugin.json 的 skills 里。
		hits=$(grep -rhoE 'Skill tool[^.]*' --include='*.md' "$OUT" | grep -oE '"[a-z0-9-]+"' | tr -d '"' | sort -u |
			while read -r s; do
				[ -f "$OUT/skills/$s/SKILL.md" ] || grep -qE "\"\./skills/([^\"]*/)?$s\"" "$OUT/.claude-plugin/plugin.json" || echo "$s"
			done || true)
		if [ -n "$hits" ]; then
			say "✗ plugins/$PLUGIN 里的 skill 要调用这些 skill，但插件没有收录：$(echo $hits)"
			rc=1
		else
			say "✓ plugins/$PLUGIN 里的 skill 调用的 skill 都已收录"
		fi
	done
	if command -v claude >/dev/null; then
		claude plugin validate "$ROOT" >"$WORK/validate" 2>&1 || failed=1
		for p in $PLUGINS; do
			claude plugin validate "$ROOT/plugins/$p" >>"$WORK/validate" 2>&1 || failed=1
		done
		if [ -z "$failed" ]; then
			say "✓ claude plugin validate 通过（marketplace 和全部插件）"
		else
			say "✗ claude plugin validate 未通过："
			sed 's/^/  /' "$WORK/validate"
			rc=1
		fi
	else
		say "- 没找到 claude CLI，跳过 manifest 校验"
	fi
	return $rc
}

cmd_install() {
	local scope=user p conflicts tool installed markets
	while [ $# -gt 0 ]; do
		case $1 in
		--scope) scope=${2:?--scope 后面要跟 user、project 或 local}; shift 2 ;;
		--scope=*) scope=${1#*=}; shift ;;
		*) die "未知参数：$1" ;;
		esac
	done
	command -v claude >/dev/null || die "需要 Claude Code CLI（claude）"
	for p in $PLUGINS; do
		[ -f "$ROOT/plugins/$p/.claude-plugin/plugin.json" ] || { cmd_build; break; }
	done
	# 先存进变量再 grep：直接用管道接 grep -q，grep 提前退出会让 claude 收到 SIGPIPE，在 pipefail 下误判。
	installed=$(claude plugin list --json 2>/dev/null || true)
	markets=$(claude plugin marketplace list --json 2>/dev/null || true)
	# 别的 marketplace 里的同名插件命令前缀相同，同时装会冲突，例如所有 pstack 移植版都是 /pstack:*。
	# mattpocock-skills 是 Matt 的完整版：skill 和 spec 重复，还带 implement 编排，会和 poteto-mode 抢主编排。
	conflicts=$(grep -oE "\"id\": *\"($(tr ' ' '|' <<<"$PLUGINS")|mattpocock-skills)@[^\"]*\"" <<<"$installed" |
		sed 's/.*"\([^"]*\)"$/\1/' | grep -v "@$MARKETPLACE\$" || true)
	[ -z "$conflicts" ] || die "已经装了 $(echo $conflicts)，和 jstack 的插件冲突：同名插件的命令前缀相同；mattpocock-skills 的 skill 和 spec 重复，还带 implement 编排。先卸载：$(printf '\n  claude plugin uninstall %s' $conflicts)"
	if grep -q "\"name\": *\"$MARKETPLACE\"" <<<"$markets"; then
		claude plugin marketplace update "$MARKETPLACE"
	else
		claude plugin marketplace add "$ROOT" --scope "$scope"
	fi
	for p in $PLUGINS; do
		if grep -q "\"id\": *\"$p@$MARKETPLACE\"" <<<"$installed"; then
			claude plugin enable "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			# 本地 marketplace 的插件本来就从源目录加载；update 让 claude plugin list 里记的版本号跟上，
			# marketplace 来自 GitHub 时则真正拉取新版本。
			claude plugin update "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			say "✓ $p@$MARKETPLACE 已是最新，重开会话或运行 /reload-plugins 生效。"
		else
			claude plugin install "$p@$MARKETPLACE" --scope "$scope"
		fi
	done
	for tool in bun gh rg jq; do
		command -v "$tool" >/dev/null || case $tool in
			bun) say "! 没找到 bun：poteto-mode 的 watch-pr 和 statechart 脚本要用它" ;;
			gh) say "! 没找到 gh：开 PR、看 CI 的流程要用它" ;;
			rg) say "! 没找到 rg：搜索代码和 worktree-audit 要用它" ;;
			jq) say "! 没找到 jq：worktree-audit 要用它" ;;
			esac
	done
	cat <<'EOF'

接下来在 Claude Code 里：
  1. 运行 /reload-plugins，或新开一个会话
  2. 运行 /pstack:setup-pstack，写入模型角色表 ~/.claude/rules/pstack-models.md（只需一次）
  3. 在要用 spec 的仓库里运行一次 /spec:setup-matt-pocock-skills，选定 issue tracker 和领域文档的位置
  4. 运行 /pstack:poteto-mode <任务描述> 开始工作。需求不清或任务较大时，先用 /spec:grill-with-docs、
     /spec:to-spec、/spec:to-tickets 澄清和拆解，再把 spec 或 ticket 交给 poteto-mode
EOF
}

case "${1:-}" in
install) shift; cmd_install "$@" ;;
sync) shift; cmd_sync "$@" ;;
build) cmd_build ;;
check) cmd_check ;;
"" | -h | --help | help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
*) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
