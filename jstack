	if ! install_project "$dir" 0 codex >"$dir/install.log" 2>&1; then
		say "✗ Codex 项目级安装失败："
		tail -10 "$dir/install.log" | sed 's/^/  /'
		return 1
	fi
	# 隔离 CODEX_HOME：只软链真实 auth.json / config.toml，插件缓存留空，
	# 这样测的是项目级安装本身，不会因为用户级装过 jstack 而蒙混过关。
	local home="$dir/.codex-home" real=${CODEX_HOME:-$HOME/.codex} f
	mkdir -p "$home"
	for f in auth.json config.toml; do
		[ -e "$real/$f" ] && ln -sfn "$real/$f" "$home/$f"
	done
	# 用一个固定模型跑，避免跟随用户的默认模型烧 premium（评测统一 deepseek flash xhigh）。
	# Codex 的 hooks 默认要落过信任才执行（交互式会话里同意一次）；smoke 是自动化，
	# 来源已经审查过，用 --dangerously-bypass-hook-trust 跳过信任检查。
	# shell 只继承核心环境变量（shell_environment_policy inherit="core"），门禁测试用的
	# JSTACK_STATE_DIR 要 export（hook 子进程直接继承）并用 -c 显式传进 shell 工具。
	cat >"$dir/run-codex.sh" <<'SH'
#!/usr/bin/env bash
cd "$1" || exit 1
export CODEX_HOME="$1/.codex-home"
export JSTACK_STATE_DIR="$1/.gate-state"
exec codex exec --ephemeral --skip-git-repo-check --dangerously-bypass-hook-trust -s danger-full-access \
	-m "$2" -c 'model_reasoning_effort="xhigh"' -c 'features.multi_agent_v2=true' \
	-c "shell_environment_policy.set.JSTACK_STATE_DIR=\"$1/.gate-state\"" "$3" </dev/null
SH
	chmod +x "$dir/run-codex.sh"
	# 1. skill 发现：Codex 给 skill 加上 <目录>: 前缀；.agents/skills 的入口要能看到。
	out="$dir/skills.txt"
	if smoke_run "Codex skill catalog" "$out" "$dir/run-codex.sh" "$dir" "$model" \
		'List the names of the skills available to you that are named route or poteto-mode, one per line, then reply SKILLS-DONE. Do not use tools.'; then
		for s in 'flow:route' 'pstack:poteto-mode'; do
			grep -qF -- "$s" "$out" || {
				say "✗ Codex skill catalog 缺少 $s"
				rc=1 bad=1
			}
		done
		[ "$bad" -eq 0 ] && say "✓ Codex: 项目 .agents/skills 里的入口可见（flow:route、pstack:poteto-mode）"
	else
		rc=1
	fi
	# 2. route 在 Codex 的项目安装布局（vendor）下运行 locate.sh，覆盖阶段表的全部提供者。
	out="$dir/route.txt"
	prompt='$flow:route 只运行 .agents/skills/route/locate.sh，逐行列出它打印的全部提供者，然后停止。不要进入任何阶段。'
	if smoke_run "Codex route" "$out" "$dir/run-codex.sh" "$dir" "$model" "$prompt"; then
		bad=0
		for s in $(local_providers); do
			grep -qF -- "$s" "$out" || {
				say "✗ Codex route 输出缺少 $s"
				rc=1 bad=1
			}
		done
		[ "$bad" -eq 0 ] && say "✓ Codex: route 定位到阶段表的全部 $(local_providers | wc -l | tr -d ' ') 个提供者"
	else
		rc=1
	fi
	# 3. 自定义 agent：.codex/agents/poteto-agent.toml 由项目级安装生成，spawn_agent 按名字派出去。
	out="$dir/subagent.txt"
	prompt="Use spawn_agent exactly once with agent_type \"poteto-agent\" and the task \"Read $dir/.agents/skills/poteto-mode/SKILL.md only if you need it. Then compute 137+248 and reply with only the number. Do not start the workflow or edit files.\" Then wait for its reply and report that reply verbatim, then stop."
	if smoke_run "Codex poteto-agent" "$out" "$dir/run-codex.sh" "$dir" "$model" "$prompt"; then
		grep -qF '385' "$out" || {
			say "✗ Codex: 没有看到 poteto-agent 的计算结果"
			rc=1
		}
		grep -qF '385' "$out" && say "✓ Codex: poteto-agent 作为自定义 agent 派出并返回结果"
	else
		rc=1
	fi
	# 4. 阶段门禁：项目级安装写的 .codex/hooks.json 指向 vendor；PreToolUse 不认 ask，
	#    guard 降级为 deny。非交互模式没有确认框，must-stop 直接拦下；路径含 verify 却没证据时，
	#    Stop 门禁把理由交回模型。
	out="$dir/gates.txt"
	stagedir="$dir/.gate-state"
	rm -rf "$stagedir"
	prompt="This is a test of jstack's stage-gate hooks; nothing will be deleted. Do all of this in one turn and don't stop early: 1) Run this exact shell command: rm -rf /tmp/jstack-smoke-gate-nonexistent (the path does not exist). 2) Run this exact shell command: \"$dir/.jstack/vendor/plugins/flow/skills/route/stage.sh\" start execute,verify. 3) Then stop. If step 1 was blocked by a hook, include GUARD-SEEN in your reply. If stopping was blocked by a hook that told you to record verification evidence, include GATE-SEEN in your reply. Do not record any evidence."
	if smoke_run "Codex 门禁" "$out" "$dir/run-codex.sh" "$dir" "$model" "$prompt"; then
		bad=0
		grep -q 'GUARD-SEEN' "$out" || {
			say "✗ Codex: must-stop 没有拦下 rm -rf"
			rc=1 bad=1
		}
		grep -q 'GATE-SEEN' "$out" || {
			say "✗ Codex: Stop 门禁没有在缺证据时提醒模型"
			rc=1 bad=1
		}
		[ "$bad" -eq 0 ] && say "✓ Codex: 阶段门禁（must-stop 拦下、Stop 缺证据提醒）"
	else
		rc=1
	fi
	return $rc
}

cmd_smoke() {
	local which=${1:-all} rc=0
	command -v jq >/dev/null || die "smoke 需要 jq"
	mkdir -p "$WORK/smoke"
	case $which in
	all)
		smoke_pi || rc=1
		smoke_omp || rc=1
		smoke_cursor || rc=1
		smoke_codex || rc=1
		;;
	pi) smoke_pi || rc=1 ;;
	omp) smoke_omp || rc=1 ;;
	cursor) smoke_cursor || rc=1 ;;
	codex) smoke_codex || rc=1 ;;
	*) die "用法：./jstack smoke [pi|omp|cursor|codex|all]" ;;
	esac
	[ "$rc" -eq 0 ] && say "✓ smoke 通过" || say "✗ smoke 未通过"
	return $rc
}

# 第二份解析，独立于 locate.sh：stages.md 的 Stages 表第 4 列里的提供者，按首次出现去重。
stage_providers() {
	sed -n '/^## Stages[[:space:]]*$/,/^## /p' "$1" | grep '^|' | tail -n +3 | cut -d'|' -f5 |
		grep -oE '`[a-z][a-z0-9-]*:[A-Za-z0-9._/-]+`' | tr -d '`' | awk '!seen[$0]++'
}

# 用假 HOME 跑 locate.sh，避免命中用户真实的安装。$1 是假 HOME，其余是 locate.sh 的路径。
locate_in() {
	local h=$1
	shift
	HOME=$h CLAUDE_PLUGINS_DIR=$h/.claude/plugins OMP_PLUGINS_DIR=$h/.omp/plugins \
		CURSOR_PLUGINS_DIR=$h/.cursor/plugins PI_AGENT_DIR=$h/.pi/agent CODEX_HOME=$h/.codex bash "$@"
}

# 阶段表的每个提供者在每种安装布局下都找得到：用 plugins/ 产物复制出各布局，从布局自己的 flow 副本运行 locate.sh。
check_locate() {
	local L="$WORK/layouts" want n p v fv lay name flow tree out path bad rc=0 err="$WORK/locate.err"
	want=$(stage_providers "$ROOT/plugins/flow/skills/route/stages.md")
	[ -n "$want" ] || { say "✗ plugins/flow/skills/route/stages.md 的 Stages 表里没有提供者"; return 1; }
	n=$(printf '%s\n' "$want" | wc -l | tr -d ' ')
	mkdir -p "$L/empty" "$L/omp/.omp/plugins/cache/plugins" "$L/cursor/.cursor/plugins/local" \
		"$L/pi/.pi/agent/npm/node_modules/jstack/plugins"
	L=$(cd "$L" && pwd -P)
	for p in $PLUGINS; do
		v=$(json_get version "$ROOT/plugins/$p/.claude-plugin/plugin.json")
		mkdir -p "$L/claude/.claude/plugins/cache/jstack/$p"
		cp -R "$ROOT/plugins/$p" "$L/claude/.claude/plugins/cache/jstack/$p/$v"
		cp -R "$ROOT/plugins/$p" "$L/omp/.omp/plugins/cache/plugins/jstack___${p}___$v"
		# Codex 安装时把 semver 的构建元数据（+jstack.<hash>）丢掉，缓存目录只留主版本。
		mkdir -p "$L/codex/.codex/plugins/cache/jstack/$p"
		cp -R "$ROOT/plugins/$p" "$L/codex/.codex/plugins/cache/jstack/$p/${v%%+*}"
	done
	cp -R "$ROOT/plugins/pstack-cursor" "$L/cursor/.cursor/plugins/local/pstack"
	cp -R "$ROOT/plugins/spec" "$ROOT/plugins/flow" "$L/cursor/.cursor/plugins/local/"
	cp "$ROOT/package.json" "$L/pi/.pi/agent/npm/node_modules/jstack/"
	cp -R "$ROOT/plugins/pstack" "$ROOT/plugins/spec" "$ROOT/plugins/flow" "$L/pi/.pi/agent/npm/node_modules/jstack/plugins/"
	# 软链入口：项目级接入把入口 skill 链进仓库的发现目录，locate 必须按物理路径找到兄弟插件。
	mkdir -p "$L/link/.agents/skills"
	ln -sfn "$ROOT/plugins/flow/skills/route" "$L/link/.agents/skills/route"
	fv=$(json_get version "$ROOT/plugins/flow/.claude-plugin/plugin.json")
	for lay in \
		"本地 marketplace|$ROOT/plugins/flow|$ROOT/plugins|$L/empty" \
		"Claude GitHub 缓存|$L/claude/.claude/plugins/cache/jstack/flow/$fv|$L/claude|$L/claude" \
		"OMP 缓存|$L/omp/.omp/plugins/cache/plugins/jstack___flow___$fv|$L/omp|$L/omp" \
		"Cursor 本地插件|$L/cursor/.cursor/plugins/local/flow|$L/cursor|$L/cursor" \
		"Pi npm 包|$L/pi/.pi/agent/npm/node_modules/jstack/plugins/flow|$L/pi|$L/pi" \
		"Codex 缓存|$L/codex/.codex/plugins/cache/jstack/flow/${fv%%+*}|$L/codex|$L/codex" \
		"软链入口|$L/link/.agents|$ROOT/plugins|$L/link"; do
		IFS='|' read -r name flow tree home <<<"$lay"
		bad=
		if ! out=$(JSTACK_STAGES_FILE= locate_in "$home" "$flow/skills/route/locate.sh" 2>"$err"); then
			bad="locate.sh 失败"
		elif [ "$(printf '%s\n' "$out" | cut -f1)" != "$want" ]; then
			bad="打印的提供者与 stages.md 不一致"
		else
			while IFS= read -r path; do
				case $path in
				"$tree"/*) [ -f "$path" ] || bad="${bad:+$bad, }$path 不存在" ;;
				*) bad="${bad:+$bad, }$path 不在该布局的树里" ;;
				esac
			done < <(printf '%s\n' "$out" | cut -f2)
		fi
		if [ -n "$bad" ]; then
			say "✗ 阶段表提供者在 ${name} 布局下找不全：${bad}"
			sed 's/^/  /' "$err" | head -20
			rc=1
		else
			say "✓ 阶段表的 $n 个提供者在 ${name} 布局下都找得到"
		fi
	done
	# 反例：把一个提供者换成不存在的名字，locate.sh 必须失败并点名它。
	sed "s|\`$(printf '%s\n' "$want" | head -1)\`|\`spec:no-such-skill\`|" \
		"$ROOT/plugins/flow/skills/route/stages.md" >"$WORK/stages-bad.md"
	if JSTACK_STAGES_FILE="$WORK/stages-bad.md" locate_in "$L/empty" "$ROOT/plugins/flow/skills/route/locate.sh" >/dev/null 2>"$err"; then
		say "✗ 阶段表里有不存在的提供者 spec:no-such-skill 时，locate.sh 没有失败"
		rc=1
	elif ! grep -qF 'spec:no-such-skill' "$err"; then
		say "✗ locate.sh 失败了，但 stderr 没有点名 spec:no-such-skill："
		sed 's/^/  /' "$err" | head -5
		rc=1
	else
		say "✓ 阶段表里有不存在的提供者时 locate.sh 失败并点名：$(grep -F 'spec:no-such-skill' "$err" | head -1)"
	fi
	return $rc
}

# 仓库级配置（.jstack/config.json，ADR-0006）：校验当前仓库的配置，并在临时仓库里验证 hooks 与 stage.sh 的行为。
repo_config_errors() {
	local root=$1 cfg=$1/.jstack/config.json f p re rows out st rc=0
	[ -f "$cfg" ] || return 0
	if ! jq -e 'type == "object"' "$cfg" >/dev/null 2>&1; then
		echo "不是合法的 JSON 对象"
		return 1
	fi
	out=$(jq -r '
		(if has("models") then "仓库级不能有 models：模型只在用户级配置" else empty end),
		(if has("providers") then "仓库级不能有 providers：模型只在用户级配置" else empty end),
		(if has("api_key") then "仓库级不能有 api_key" else empty end),
		(if (.tracker.type? != null) and ((.tracker.type | type) != "string" or ((.tracker.type == "github" or .tracker.type == "local") | not)) then "tracker.type 只能是 github 或 local" else empty end),
		(if (.verify.command? != null) and ((.verify.command | type) != "string") then "verify.command 必须是字符串" else empty end),
		(if (.verify.timeout_s? != null) and ((.verify.timeout_s | type) != "number") then "verify.timeout_s 必须是数字" else empty end),
		(if (.stages_file? != null) and ((.stages_file | type) != "string") then "stages_file 必须是字符串" else empty end),
		(if (.must_stop? != null) and ((.must_stop | type) != "array") then "must_stop 必须是数组" else empty end),
		((.must_stop // [])[] | select((.action? // "") == "") | "must_stop 的每一项都要有非空 action")
	' "$cfg") || rc=1
	if [ -n "$out" ]; then
		printf '%s\n' "$out"
		rc=1
	fi
	f=$(jq -r '.stages_file // empty' "$cfg") || rc=1
	if [ -n "$f" ]; then
		case $f in
		/*) p=$f ;;
		*) p=$root/$f ;;
		esac
		if [ ! -f "$p" ]; then
			echo "stages_file 指向的文件不存在：$p"
			rc=1
		else
			rows=$(awk -F'|' '
				/^## / { sec = ($0 ~ /^## Stages[ \t]*$/); next }
				!sec { next }
				/^\|/ { rows++ }
				rows && !/^\|/ { exit }
				!/^\|/ || rows == 1 || /^\|[-:| \t]+$/ { next }
				{ gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2 }
			' "$p")
			if [ -z "$rows" ]; then
				echo "stages_file 里没有解析出阶段：$p"
				rc=1
			elif ! printf '%s\n' "$rows" | grep -qx execute; then
				echo "stages_file 缺少 execute 阶段：$p"
				rc=1
			fi
		fi
	fi
	# 每条 regex 要是能编译的 ERE；grep -E 的退出码 2 表示编译失败。
	while IFS= read -r re; do
		[ -n "$re" ] || continue
		st=0
		printf '' | grep -E -- "$re" >/dev/null 2>&1 || st=$?
		if [ "$st" -gt 1 ]; then
			echo "must_stop 的 regex 不是合法的 ERE：$re"
			rc=1
		fi
	done < <(jq -r '(.must_stop // [])[] | .regex // empty' "$cfg")
	return $rc
}
check_repo_config() {
	local r="$WORK/repo-config" flow="$ROOT/plugins/flow" rc=0 out errs
	if [ -f "$ROOT/.jstack/config.json" ]; then
		if ! errs=$(repo_config_errors "$ROOT"); then
			say "✗ 仓库级配置不合法："
			printf '%s\n' "$errs" | sed 's/^/  /' | head -20
			rc=1
		else
			say "✓ 仓库级配置合法"
		fi
	fi
	if ! command -v jq >/dev/null; then
		say "- 没有 jq，跳过仓库级配置的行为用例"
		return $rc
	fi
	mkdir -p "$r/.jstack" "$r/.git" "$r/state"
	cat >"$r/.jstack/config.json" <<'JSON'
{
  "tracker": { "type": "local" },
  "must_stop": [
    { "action": "运行 ./deploy.sh", "hook": "deploy", "regex": "(^|[[:space:]/])\\./deploy\\.sh([[:space:]]|$)" }
  ],
  "stages_file": ".jstack/stages.md",
  "verify": { "command": "./scripts/verify.sh" }
}
JSON
cat >"$r/.jstack/stages.md" <<'MD'
# 仓库自己的阶段表

## Stages

| Stage | Output | Gate | Providers |
|---|---|---|---|
| size | One sentence | None | `flow:route` |
| execute | The change | None | `pstack:poteto-mode` |
| verify | Evidence | No evidence means not done | `pstack:principle-prove-it-works` |
| land | Commits | must-stop | `pstack:poteto-mode/playbooks/opening-a-pr.md` |
MD
	if ! errs=$(repo_config_errors "$r"); then
		say "✗ 仓库级配置的正例被误判："
		printf '%s\n' "$errs" | sed 's/^/  /' | head -10
		rc=1
	fi
	# stage.sh 读 stages_file：接受表里的阶段，拒绝表外的阶段。
	if ! out=$(cd "$r" && CLAUDE_CODE_SESSION_ID=cfg-check JSTACK_STATE_DIR="$r/state" \
		bash "$flow/skills/route/stage.sh" start execute,verify 2>&1); then
		say "✗ 仓库 stages_file：stage.sh start 拒绝了表里的阶段：$out"
		rc=1
	elif (cd "$r" && CLAUDE_CODE_SESSION_ID=cfg-check JSTACK_STATE_DIR="$r/state" \
		bash "$flow/skills/route/stage.sh" start clarify >/dev/null 2>&1); then
		say "✗ 仓库 stages_file：stage.sh start 接受了表外的 clarify"
		rc=1
	fi
	# guard.sh 合并仓库追加的模式，reason 标明来源。
	out=$(cd "$r" && printf '%s' '{"session_id":"cfg-check","tool_name":"Bash","tool_input":{"command":"./deploy.sh --all"}}' |
		bash "$flow/hooks/guard.sh" 2>/dev/null)
	case $out in
	*'"permissionDecision":"ask"'*'（仓库追加）'*) ;;
	*)
		say "✗ 仓库追加的 must-stop 没有被 guard.sh 拦下并标明来源：$out"
		rc=1
		;;
	esac
	# prompt.sh 注入仓库配置，route 才能看到 stages_file / tracker / 验证命令。
	out=$(cd "$r" && printf '%s' '{"session_id":"cfg-check"}' |
		JSTACK_STATE_DIR="$r/state" bash "$flow/hooks/prompt.sh" 2>/dev/null)
	case $out in
	*"仓库配置："*"阶段表=.jstack/stages.md"*"验证命令=./scripts/verify.sh"*) ;;
	*)
		say "✗ prompt.sh 没有注入仓库配置：$out"
		rc=1
		;;
	esac
	# 坏配置要报出来，而不是静默当成没有。
	mkdir -p "$r/bad/.jstack" "$r/bad/.git"
	printf '{ "must_stop": [\n' >"$r/bad/.jstack/config.json"
	if errs=$(repo_config_errors "$r/bad"); then
		say "✗ 非法的仓库配置没有被 check 发现"
		rc=1
	fi
	mkdir -p "$r/forbidden/.jstack" "$r/forbidden/.git"
	printf '{"models":{"claude-code":{"premium":"p/x"}}}\n' >"$r/forbidden/.jstack/config.json"
	if errs=$(repo_config_errors "$r/forbidden"); then
		say "✗ 仓库级配置里的 models 没有被 check 拒绝"
		rc=1
	fi
	mkdir -p "$r/badstage/.jstack" "$r/badstage/.git"
	printf '{"stages_file":".jstack/stages.md"}\n' >"$r/badstage/.jstack/config.json"
	printf '# x\n\n## Stages\n\n| Stage | Output | Gate | Providers |\n|---|---|---|---|\n| clarify | x | x | `flow:route` |\n' >"$r/badstage/.jstack/stages.md"
	if errs=$(repo_config_errors "$r/badstage"); then
		say "✗ 缺 execute 的 stages_file 没有被 check 发现"
		rc=1
	fi
	if [ "$rc" -eq 0 ]; then
		say "✓ 仓库级配置：current 校验、stages_file、guard 追加模式、提示注入、坏配置检测都通过"
	fi
	return $rc
}

# 断言一份模型规则文件有 17 个角色行，判断类落到给定模型，双模型角色有两个不同值。
models_check_roles() { # <file> <quality-value>
	local file=$1 q=$2 role a b
	while IFS= read -r role; do
		if [ "$(grep -Fc "${role}: " "$file" || true)" -ne 1 ]; then
			return 1
		fi
	done <<'EOF'
feature, refactoring
bug-fix
perf-issue
hillclimb
judgment and prose
hardest tasks
how explorer
how explainer
why investigators
why synthesizer
reflect tooling
reflect judgment, divergent, synthesizer
arena runners
arena cross-judge pool
swarm workers
architect runners
interrogate reviewers
EOF
	grep -qx "judgment and prose: ${q}" "$file" || return 1
	for role in 'arena runners' 'interrogate reviewers'; do
		a=$(grep -F "${role}: " "$file" | head -1 || true)
		a=${a#*: }
		b=${a#*, }
		a=${a%%,*}
		[ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ] || return 1
	done
	return 0
}

models_hashes() { # <HOME>
