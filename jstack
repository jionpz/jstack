# doctor：只读列出每个 harness × 作用域装了什么，核对版本漂移与 <repo>/.jstack/lock.json。
doctor_repo_root() {
	local d=${JSTACK_REPO:-$PWD}
	[ -n "$d" ] || return 1
	while :; do
		[ -f "$d/.jstack/config.json" ] && { printf '%s\n' "$d"; return 0; }
		[ -d "$d/.git" ] && { printf '%s\n' "$d"; return 0; }
		[ "$d" = / ] && return 1
		d=$(dirname "$d")
	done
}

doctor_manifest_version() { # <插件目录>
	local f v
	for f in "$1/.claude-plugin/plugin.json" "$1/.cursor-plugin/plugin.json" "$1/.omp-plugin/plugin.json"; do
		[ -f "$f" ] || continue
		v=$(jq -r '.version // empty' "$f" 2>/dev/null) || v=
		if [ -n "$v" ]; then
			printf '%s\n' "$v"
			return 0
		fi
	done
	return 1
}

doctor_add() { # <文件> <harness> <scope> <plugin> <version> <path> <source> <in_repo> <stale>
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" >>"$1"
}

doctor_pi_tree() { # <文件> <已见文件> <包目录>
	local file=$1 seen=$2 pkg=${3%/} plugin v
	[ -d "$pkg" ] || return 0
	pkg=$(cd "$pkg" && pwd -P) || return 0
	[ -f "$pkg/package.json" ] || return 0
	[ "$(jq -r '.name // empty' "$pkg/package.json" 2>/dev/null)" = jstack ] || return 0
	if grep -Fxq "$pkg" "$seen" 2>/dev/null; then
		return 0
	fi
	printf '%s\n' "$pkg" >>"$seen"
	for plugin in pstack spec flow; do
		[ -d "$pkg/plugins/$plugin" ] || continue
		v=$(doctor_manifest_version "$pkg/plugins/$plugin") || v=
		[ -n "$v" ] || v=$(jq -r '.version // empty' "$pkg/package.json" 2>/dev/null) || v=
		[ -n "$v" ] || v=-
		doctor_add "$file" pi package "$plugin" "$v" "$pkg/plugins/$plugin" "path:$pkg" 0 0
	done
}

cmd_doctor() {
	local json=0 nofail=0 repo= out file="$WORK/doctor-rows" seen="$WORK/doctor-seen" rc=0
	local h scope plugin version path source inrepo stale lock lockver lock_cell n drift=0 stale_n=0 tab
	local lock_tree actual_tree tree_bad= missing_rec= rec rec_source rec_config
	local pi_agent omp_plugins cursor_plugins codex_plugins id fold proj
	while [ $# -gt 0 ]; do
		case $1 in
		--json) json=1; shift ;;
		--no-fail) nofail=1; shift ;;
		--repo)
			repo=${2:?--repo 后面要跟仓库路径}
			[ -d "$repo" ] || die "--repo 指向的目录不存在：${repo}"
			shift 2
			;;
		*) die "未知参数：$1（用法：./jstack doctor [--json] [--no-fail] [--repo <dir>]）" ;;
		esac
	done
	command -v jq >/dev/null || die "doctor 需要 jq"
	[ -n "$repo" ] || repo=$(doctor_repo_root) || repo=
	: >"$file"
	: >"$seen"

	# Claude Code：plugin list 跨 scope 返回同一插件的多条记录，全部保留。
	if command -v claude >/dev/null; then
		out=$(claude plugin list --json 2>/dev/null || true)
		if [ -n "$out" ]; then
			printf '%s\n' "$out" |
				jq -r '.[] | select((.id // "") | endswith("@jstack")) |
					[.id, (.scope // ""), (.version // ""), (.installPath // ""),
					 (.readFromFolder // ""), (.folderVersion // ""), (.projectPath // "")]
					| join("\u0001")' 2>/dev/null | tr '\001' '\t' |
				while IFS=$'\t' read -r id scope version path source fold proj; do
					[ -n "$id" ] || continue
					plugin=${id%@*}
					stale=0
					[ -z "$fold" ] || [ "$fold" = "$version" ] || stale=1
					inrepo=0
					if [ -n "$repo" ] && [ "$scope" = project ] && [ "$proj" = "$repo" ]; then
						inrepo=1
					fi
					[ -n "$source" ] || source=marketplace:jstack
					[ -z "$proj" ] || source="$source project:$proj"
					doctor_add "$file" claude-code "$scope" "$plugin" "$version" "$path" "$source" "$inrepo" "$stale"
				done
		fi
	fi

	# Pi package：settings 里的本地路径包，以及 npm node_modules 下的 jstack。
	pi_agent=${PI_AGENT_DIR:-$HOME/.pi/agent}
	doctor_pi_tree "$file" "$seen" "$pi_agent/npm/node_modules/jstack"
	if [ -f "$pi_agent/settings.json" ]; then
		out=$(jq -r '(.packages // [])[] | select(type == "string" and (startswith("npm:") | not))' \
			"$pi_agent/settings.json" 2>/dev/null || true)
		while IFS= read -r path; do
			[ -n "$path" ] || continue
			case $path in
			/*) ;;
			*) path="$pi_agent/$path" ;;
			esac
			doctor_pi_tree "$file" "$seen" "$path"
		done <<<"$out"
	fi

	# OMP：marketplace 缓存目录名里带版本。
	omp_plugins=${OMP_PLUGINS_DIR:-$HOME/.omp/plugins}
	for path in "$omp_plugins"/cache/plugins/jstack___*; do
		[ -d "$path" ] || continue
		h=${path##*/}
		plugin=${h#jstack___}
		plugin=${plugin%%___*}
		version=${h##*___}
		[ -n "$plugin" ] && [ "$version" != "$h" ] && [ -n "$version" ] || continue
		doctor_add "$file" omp cache "$plugin" "$version" "$path" omp-cache 0 0
	done

	# Cursor：本地插件目录。
	cursor_plugins=${CURSOR_PLUGINS_DIR:-$HOME/.cursor/plugins}
	for path in "$cursor_plugins"/local/*; do
		[ -d "$path" ] || continue
		plugin=${path##*/}
		version=$(doctor_manifest_version "$path") || continue
		doctor_add "$file" cursor local "$plugin" "$version" "$path" cursor-local 0 0
	done

	# Codex：marketplace 缓存是 <CODEX_HOME>/plugins/cache/<marketplace>/<插件>/<版本>。
	codex_plugins=${CODEX_HOME:-$HOME/.codex}/plugins
	for path in "$codex_plugins"/cache/jstack/*/*; do
		[ -d "$path" ] || continue
		plugin=$(dirname "$path")
		plugin=${plugin##*/}
		version=${path##*/}
		doctor_add "$file" codex cache "$plugin" "$version" "$path" codex-cache 0 0
	done

	# 仓库 vendor 树。
	if [ -n "$repo" ] && [ -d "$repo/.jstack/vendor/plugins" ]; then
		for path in "$repo/.jstack/vendor/plugins"/*; do
			[ -d "$path" ] || continue
			plugin=${path##*/}
			version=$(doctor_manifest_version "$path") || continue
			doctor_add "$file" vendor project "$plugin" "$version" "$path" vendor 1 0
		done
	fi

	# 核对 lock 与漂移，生成七列。
	lock=
	[ -z "$repo" ] || [ ! -f "$repo/.jstack/lock.json" ] || lock="$repo/.jstack/lock.json"
	if [ -n "$lock" ]; then
		if [ ! -d "$repo/.jstack/vendor" ]; then
			tree_bad="lock 存在但 .jstack/vendor 不存在"
		else
			lock_tree=$(jq -r '.vendor.tree // empty' "$lock" 2>/dev/null || true)
			actual_tree=$(tree_hash "$repo/.jstack/vendor")
			if [ -z "$lock_tree" ]; then
				tree_bad="lock 缺少 vendor.tree（运行 ./jstack install --all --scope project 重新生成）"
			elif [ "$lock_tree" != "$actual_tree" ]; then
				tree_bad="vendor 树哈希与 lock 不一致（lock $(printf '%s' "$lock_tree" | cut -c1-12)…，实际 $(printf '%s' "$actual_tree" | cut -c1-12)…）"
			fi
		fi
	fi
	: >"$WORK/doctor-final"
	sort -t "$(printf '\t')" -k1,1 -k2,2 -k3,3 "$file" |
		while IFS=$'\t' read -r h scope plugin version path source inrepo stale; do
			[ -n "$h" ] || continue
			if [ "$stale" = 1 ]; then
				lock_cell=stale
			elif [ "$inrepo" != 1 ]; then
				lock_cell=-
			elif [ -z "$lock" ]; then
				lock_cell=no-lock
			else
				lockver=$(jq -r --arg p "$plugin" \
					'.plugins[$p] | if type == "object" then (.version // empty) else (. // empty) end' \
					"$lock" 2>/dev/null || true)
				if [ -z "$lockver" ]; then
					lock_cell=missing
				elif [ "$lockver" != "$version" ]; then
					lock_cell="drift $version!=$lockver"
				else
					lock_cell=ok
				fi
			fi
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$h" "$scope" "$plugin" "$version" "$path" "$source" "$lock_cell" \
				>>"$WORK/doctor-final"
		done

	n=$(wc -l <"$WORK/doctor-final" | tr -d ' ')
	drift=$(awk -F'\t' '$7 ~ /^(drift|missing|stale)( |$)/ { n++ } END { print n + 0 }' "$WORK/doctor-final")
	stale_n=$(awk -F'\t' '$7 == "stale" { n++ } END { print n + 0 }' "$WORK/doctor-final")
	[ "$drift" -eq 0 ] || rc=1
	# lock 里的安装入口必须还在，删掉一个入口 skill 也算安装与 lock 不一致。
	if [ -n "$lock" ]; then
		while IFS= read -r rec; do
			[ -n "$rec" ] || continue
			if [ -e "$repo/$rec" ]; then
				continue
			fi
			case " $missing_rec " in
			*" $rec "*) ;;
			*) missing_rec="$missing_rec${missing_rec:+, }$rec" ;;
			esac
		done < <(jq -r '.harnesses[]?.records[]?' "$lock" 2>/dev/null || true)
	fi
	[ -z "$tree_bad" ] || rc=1
	[ -z "$missing_rec" ] || rc=1
	if [ -n "$lock" ]; then
		project_ignored_files "$repo" || rc=1
		rec_source=$(jq -r '.recommended.pi.source // empty' "$lock" 2>/dev/null || true)
		if [ -n "$rec_source" ]; then
			rec_config=$(jq -r '.recommended.pi.config // empty' "$lock" 2>/dev/null || true)
			if [ -z "$rec_config" ] || [ ! -f "$repo/$rec_config" ]; then
				say "! lock 记录的 Pi 推荐包配置不存在：${rec_config:-（缺 config）}；重跑项目级 install" >&2
				rc=1
			elif ! jq -e '(.packages // []) | any(.[]; type == "string" and contains("pi-subagents"))' \
				"$repo/$rec_config" >/dev/null 2>&1; then
				say "! ${rec_config} 里没有 @tintinweb/pi-subagents；重跑项目级 install" >&2
				rc=1
			fi
		fi
		for h in pi omp; do
			if jq -e --arg h "$h" '.harnesses[$h] != null' "$lock" >/dev/null; then
				if ! grep -qxF "export { default } from \"../../.jstack/vendor/plugins/flow/extensions/$h.ts\";" \
					"$repo/.$h/extensions/jstack-flow-gates.ts" 2>/dev/null; then
					say "! $h 项目门禁扩展没有转出 lock 对应的 vendor；重跑项目级 install" >&2
					rc=1
				fi
			fi
		done
	fi

	if [ "$json" -eq 1 ]; then
		python3 -I - "$WORK/doctor-final" <<'PY'
import json, sys
rows = []
with open(sys.argv[1], encoding="utf-8") as f:
	for line in f:
		line = line.rstrip("\n")
		if not line:
			continue
		parts = line.split("\t")
		if len(parts) < 7:
			continue
		rows.append(dict(zip(("harness", "scope", "plugin", "version", "path", "source", "lock"), parts)))
print(json.dumps(rows, ensure_ascii=False, indent=2))
PY
		[ "$stale_n" -eq 0 ] || say "! ${stale_n} 条安装的记录版本落后于源目录（本地 marketplace 直接从源目录加载）" >&2
		[ "$drift" -eq 0 ] || say "! ${drift} 条安装有版本漂移或与 lock 不一致" >&2
	else
		if [ "$n" -eq 0 ]; then
			say "没有发现 jstack 安装。"
		else
			tab=$(printf '\t')
			if command -v column >/dev/null; then
				{
					printf 'HARNESS\tSCOPE\tPLUGIN\tVERSION\tPATH\tSOURCE\tLOCK\n'
					cat "$WORK/doctor-final"
				} | column -t -s "$tab"
			else
				printf 'HARNESS\tSCOPE\tPLUGIN\tVERSION\tPATH\tSOURCE\tLOCK\n'
				cat "$WORK/doctor-final"
			fi
			say ""
			say "共 ${n} 条安装：${drift} 条与源目录或 lock 不一致（其中 ${stale_n} 条记录版本落后于源目录）。"
		fi
	fi
	[ -z "$tree_bad" ] || say "! $tree_bad" >&2
	[ -z "$missing_rec" ] || say "! lock 记录的安装入口不存在：$missing_rec" >&2
	if [ "$rc" -ne 0 ] && [ "$nofail" -eq 1 ]; then
		say "! 有版本漂移或 lock 不一致；--no-fail 下不返回失败。" >&2
		rc=0
	fi
	return $rc
}

# ---- 安装：harness 探测、项目级 vendor 与 lock ----

harness_present() { # <harness>
	case $1 in
	claude-code) command -v claude >/dev/null 2>&1 ;;
	pi) command -v pi >/dev/null 2>&1 ;;
	omp) command -v omp >/dev/null 2>&1 ;;
	cursor) command -v cursor >/dev/null 2>&1 || [ -d "${CURSOR_HOME:-$HOME/.cursor}" ] ;;
	codex) command -v codex >/dev/null 2>&1 ;;
	*) return 1 ;;
	esac
}

entry_skills() { # <插件>：要链进各 harness 项目 skill 目录的入口
	case $1 in
	flow) printf '%s\n' route archive ;;
	pstack) printf '%s\n' poteto-mode ;;
	spec) printf '%s\n' grill-with-docs to-spec to-tickets wayfinder handoff setup-matt-pocock-skills ;;
	esac
}

plugin_skill_rel() { # <vendor> <插件> <入口>：skill 目录相对仓库根的路径
	local vendor=$1 plugin=$2 name=$3 rel
	for rel in "$name" "engineering/$name" "productivity/$name"; do
		if [ -f "$vendor/plugins/$plugin/skills/$rel/SKILL.md" ]; then
			printf '.jstack/vendor/plugins/%s/skills/%s\n' "$plugin" "$rel"
			return 0
		fi
	done
	return 1
}

sha256_stream() {
	if command -v shasum >/dev/null 2>&1; then
		shasum -a 256 | awk '{print $1}'
	else
		sha256sum | awk '{print $1}'
	fi
}

link_entry() { # <仓库> <相对目录> <名字> <相对目标> <dry>
	local repo=$1 dir=$2 name=$3 target=$4 dry=$5 path shared=0
	path="$repo/$dir/$name"
	# .agents/skills 是多个 harness 共用的位置：用户已经放了同名入口时，它是权威版本，不再覆盖。
	[ "$dir" = .agents/skills ] && shared=1
	if [ "$dry" -eq 1 ]; then
		say "  链接 $dir/$name -> $target"
		return 0
	fi
	mkdir -p "$repo/$dir"
	if [ -L "$path" ]; then
		[ "$(readlink "$path")" = "$target" ] && return 0
		if [ "$shared" -eq 1 ]; then
			say "! $path 已指向 $(readlink "$path")，保留它并跳过（.agents 优先）"
			return 0
		fi
		die "$path 已指向 $(readlink "$path")，不是这次安装的入口；先移走再装"
	elif [ -e "$path" ]; then
		if [ "$shared" -eq 1 ]; then
			say "! $path 已存在且不是 jstack 的入口，保留它并跳过（.agents 优先）"
			return 0
		fi
		die "$path 已存在且不是符号链接；先移走再装"
	else
		ln -s "$target" "$path"
	fi
}

link_entry_skills() { # <仓库> <相对目录> <vendor> <dry>
	local repo=$1 dir=$2 vendor=$3 dry=$4 p e rel n=0
	if [ "$dry" -eq 1 ]; then
		for p in $PLUGINS; do
			n=$((n + $(entry_skills "$p" | wc -l | tr -d ' ')))
		done
		say "  链接 $n 个入口 skill 到 $dir"
		return 0
	fi
	for p in $PLUGINS; do
		for e in $(entry_skills "$p"); do
			rel=$(plugin_skill_rel "$vendor" "$p" "$e") || die "vendor 里缺少 $p 的入口 skill $e"
			link_entry "$repo" "$dir" "$e" "../../$rel" 0
		done
	done
}

# Cursor 从 3.x 起同时读 .cursor/skills 和 .agents/skills。入口统一放到 .agents/skills 后，
# 旧版 jstack 留在 .cursor/skills 的软链要清掉，否则同名入口会加载两遍。
cleanup_cursor_skills() { # <仓库> <dry>
	local repo=$1 dry=$2 p e path target
	for p in $PLUGINS; do
		for e in $(entry_skills "$p"); do
			path="$repo/.cursor/skills/$e"
			[ -L "$path" ] || continue
			target=$(readlink "$path")
			case $target in
			*/.jstack/vendor/*)
				if [ "$dry" -eq 1 ]; then
					say "  移除旧的 .cursor/skills/${e}（Cursor 改读 .agents/skills）"
				else
					rm "$path"
					say "✓ 移除旧的 .cursor/skills/${e}（Cursor 改读 .agents/skills）"
				fi
				;;
			esac
		done
	done
	if [ "$dry" -eq 0 ] && [ -d "$repo/.cursor/skills" ] &&
		[ -n "$(find "$repo/.cursor/skills" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
		say "! .cursor/skills 里还有非 jstack 的入口；Cursor 会同时读 .agents/skills，同名会冲突"
	fi
}

install_vendor() { # <仓库> <dry>
	local repo=$1 dry=$2 vendor="$repo/.jstack/vendor" p need=0
	for p in $PLUGINS; do
		[ -f "$ROOT/plugins/$p/.claude-plugin/plugin.json" ] || need=1
	done
	if [ "$need" -eq 1 ]; then
		if [ "$dry" -eq 1 ]; then
			say "  先运行 ./jstack build"
		else
			cmd_build
		fi
	fi
	if [ "$dry" -eq 1 ]; then
		say "  复制 plugins/{pstack,spec,flow} 到 .jstack/vendor/plugins/"
		say "  复制 .claude-plugin/marketplace.json 到 .jstack/vendor/.claude-plugin/"
		return 0
	fi
	command -v rsync >/dev/null 2>&1 || die "项目级安装需要 rsync"
	[ -f "$ROOT/.claude-plugin/marketplace.json" ] || die "缺少 .claude-plugin/marketplace.json"
	mkdir -p "$vendor/plugins" "$vendor/.claude-plugin"
	for p in $PLUGINS; do
		rsync -a --delete "$ROOT/plugins/$p/" "$vendor/plugins/$p/"
	done
	cp "$ROOT/.claude-plugin/marketplace.json" "$vendor/.claude-plugin/marketplace.json"
}

install_agent() { # <仓库> <vendor> <名字> <dry>
	local repo=$1 vendor=$2 name=$3 dry=$4 src dst
	src="$vendor/plugins/pstack/agents/$name.md"
	dst="$repo/.claude/agents/$name.md"
	if [ "$dry" -eq 1 ]; then
		say "  复制 pstack agents/$name.md 到 .claude/agents/"
		return 0
	fi
	[ -f "$src" ] || die "vendor 里缺少 pstack agents/$name.md"
	mkdir -p "$repo/.claude/agents"
	if [ -e "$dst" ] && ! grep -q 'generated by jstack install' "$dst"; then
		die "$dst 已存在且不是 jstack 生成的；先备份或移走"
	fi
	{
		cat "$src"
		printf '\n<!-- generated by jstack install --scope project; source: .jstack/vendor/plugins/pstack/agents/%s.md -->\n' "$name"
	} >"$dst"
}

# 项目 agent 保留各 harness 所需的 frontmatter；已有非 jstack 文件不覆盖。
install_project_agents() { # <仓库> <vendor> <harness> <dry>
	local repo=$1 vendor=$2 h=$3 dry=$4 name src dst dir
	case $h in
	pi) dir=.agents/agents ;;
	omp) dir=.omp/agents ;;
	cursor) dir=.cursor/agents ;;
	esac
	for name in poteto-agent comment-sicko; do
		src="$vendor/plugins/pstack/agents/$name.md"
		[ "$h" != cursor ] || src="$ROOT/plugins/pstack-cursor/agents/$name.md"
		dst="$repo/$dir/$name.md"
		if [ "$dry" -eq 1 ]; then
			say "  安装 $h agent $name.md 到 $dir/"
			continue
		fi
		[ -f "$src" ] || die "缺少 $src，先运行 ./jstack build"
		mkdir -p "$repo/$dir"
		if [ -L "$dst" ] || { [ -e "$dst" ] && ! grep -q 'generated by jstack install' "$dst"; }; then
			if [ "$h" = pi ]; then
				say "! $dst 已存在且不是 jstack 生成的，保留它并跳过（.agents 优先）"
				continue
			fi
			die "$dst 已存在且不是 jstack 生成的普通文件；先备份或移走"
		fi
		if [ "$h" = pi ]; then
			sed 's/^background: true$/run_in_background: true/' "$src" |
				awk -v name="$name" 'BEGIN{fm=0} /^---$/{fm++; print; if(fm==2) print "\n<!-- generated by jstack install --scope project; source: pstack/agents/" name ".md -->"; next} {print}' >"$dst"
			if [ "$name" = poteto-agent ]; then
				grep -q '^run_in_background: true$' "$dst" || die "$src 的 background 字段没有转成 run_in_background"
			fi
		else
			{
				cat "$src"
				printf '\n<!-- generated by jstack install --scope project; source: pstack/agents/%s.md -->\n' "$name"
			} >"$dst"
		fi
	done
}

install_project_extension() { # <仓库> <harness> <dry>
	local repo=$1 h=$2 dry=$3 dir target src
	dir=".$h/extensions"
	target="$repo/$dir/jstack-flow-gates.ts"
	src="../../.jstack/vendor/plugins/flow/extensions/$h.ts"
	if [ "$dry" -eq 1 ]; then
		say "  写 $dir/jstack-flow-gates.ts，转出 $src"
		return 0
	fi
	[ -f "$repo/.jstack/vendor/plugins/flow/extensions/$h.ts" ] || die "vendor 里缺少 flow extensions/$h.ts"
	mkdir -p "$repo/$dir"
	if [ -L "$target" ] || { [ -e "$target" ] && ! grep -q 'generated by jstack install' "$target"; }; then
		die "$target 已存在且不是 jstack 生成的普通文件；先备份或移走"
	fi
	{
		printf '// generated by jstack install --scope project\n'
		printf 'export { default } from "%s";\n' "$src"
	} >"$target"
}

# Codex 的自定义 agent 是 TOML（.codex/agents/<name>.toml），Claude 的是带 YAML frontmatter 的 Markdown。
# 项目级安装按 name / description / developer_instructions 转换；Codex 没有 background 字段，frontmatter 其余键丢弃。
# developer_instructions 用 TOML 的无转义多行字面量（'''），正文里的反斜杠、引号和反引号都原样保留。
install_codex_agents() { # <仓库> <vendor> <dry>
	local repo=$1 vendor=$2 dry=$3 name src dst desc body
	for name in poteto-agent comment-sicko; do
		src="$vendor/plugins/pstack/agents/$name.md"
		dst="$repo/.codex/agents/$name.toml"
		if [ "$dry" -eq 1 ]; then
			say "  转换 pstack agents/$name.md 到 .codex/agents/$name.toml"
			continue
		fi
		[ -f "$src" ] || die "vendor 里缺少 pstack agents/$name.md"
		desc=$(awk 'NR == 1 && $0 == "---" { fm = 1; next }
			fm == 1 && $0 == "---" { exit }
			fm == 1 && /^description:/ { sub(/^description:[[:space:]]*/, ""); print; exit }' "$src")
		[ -n "$desc" ] || die "$src 的 frontmatter 里没有 description"
		desc=$(printf '%s' "$desc" | sed 's/\\/\\\\/g; s/"/\\"/g')
		body=$(awk 'BEGIN { fm = 0 } /^---$/ { fm++; next } fm >= 2' "$src")
		mkdir -p "$repo/.codex/agents"
		if [ -e "$dst" ] && ! grep -q 'generated by jstack install' "$dst"; then
			die "$dst 已存在且不是 jstack 生成的；先备份或移走"
		fi
		{
			printf '# generated by jstack install --scope project; source: .jstack/vendor/plugins/pstack/agents/%s.md\n' "$name"
			printf 'name = "%s"\n' "$name"
			printf 'description = "%s"\n' "$desc"
			printf "developer_instructions = '''\n"
			printf '%s\n' "$body"
			printf "'''\n"
		} >"$dst"
	done
}

install_claude_hooks() { # <仓库> <dry>：项目级 hooks 指向 vendor，重复运行不重复追加
	local repo=$1 dry=$2 settings cur new
	settings="$repo/.claude/settings.json"
	if [ "$dry" -eq 1 ]; then
		say "  写 .claude/settings.json 的 flow hooks（UserPromptSubmit / PreToolUse / Stop）"
		return 0
	fi
	mkdir -p "$repo/.claude"
	cur=
	[ ! -f "$settings" ] || cur=$(cat "$settings")
	[ -n "$cur" ] || cur='{}'
	new=$(printf '%s\n' "$cur" | jq --arg root '${CLAUDE_PROJECT_DIR}/.jstack/vendor/plugins/flow' '
		def clean($mark):
			map(.hooks = ((.hooks // []) | map(select((.command // "") | contains($mark) | not))))
			| map(select((.hooks | length) > 0));
		.hooks = (.hooks // {}) |
		.hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) | clean(".jstack/vendor/plugins/flow"))
			+ [{hooks: [{type: "command", command: ("\"" + $root + "\"/hooks/prompt.sh"), timeout: 10}]}] |
		.hooks.PreToolUse = ((.hooks.PreToolUse // []) | clean(".jstack/vendor/plugins/flow"))
			+ [{matcher: "Bash", hooks: [{type: "command", command: ("\"" + $root + "\"/hooks/guard.sh"), timeout: 10}]}] |
		.hooks.Stop = ((.hooks.Stop // []) | clean(".jstack/vendor/plugins/flow"))
			+ [{hooks: [{type: "command", command: ("\"" + $root + "\"/hooks/stop.sh"), timeout: 10}]}]
	') || die "写 $settings 失败：现有内容不是合法的 JSON"
	[ "$new" = "$cur" ] || printf '%s\n' "$new" >"$settings"
}

install_cursor_hooks() { # <仓库> <dry>：项目级 Cursor hooks 指向 vendor，重复运行不重复追加
	local repo=$1 dry=$2 hooks cur new
	hooks="$repo/.cursor/hooks.json"
	if [ "$dry" -eq 1 ]; then
		say "  写 .cursor/hooks.json 的 flow hooks（beforeShellExecution / beforeSubmitPrompt / stop）"
		return 0
	fi
	mkdir -p "$repo/.cursor"
	cur=
	[ ! -f "$hooks" ] || cur=$(cat "$hooks")
	[ -n "$cur" ] || cur='{}'
	new=$(printf '%s\n' "$cur" | jq --arg root '${CURSOR_PROJECT_DIR}/.jstack/vendor/plugins/flow' '
		def clean:
			map(select(((.command // "") | contains(".jstack/vendor/plugins/flow")) | not));
		.version = 1 |
		.hooks = (.hooks // {}) |
		.hooks.beforeShellExecution = ((.hooks.beforeShellExecution // []) | clean)
			+ [{command: ("\"" + $root + "\"/hooks/guard.sh"), timeout: 10}] |
		.hooks.beforeSubmitPrompt = ((.hooks.beforeSubmitPrompt // []) | clean)
			+ [{command: ("\"" + $root + "\"/hooks/prompt.sh"), timeout: 10}] |
		.hooks.stop = ((.hooks.stop // []) | clean)
			+ [{command: ("\"" + $root + "\"/hooks/stop.sh"), timeout: 10, loop_limit: 3}]
	') || die "写 $hooks 失败：现有内容不是合法的 JSON"
	[ "$new" = "$cur" ] || printf '%s\n' "$new" >"$hooks"
}

install_codex_hooks() { # <仓库> <dry>：项目级 hooks 指向 vendor，重复运行不重复追加
	local repo=$1 dry=$2 hooks cur new
	hooks="$repo/.codex/hooks.json"
	if [ "$dry" -eq 1 ]; then
		say "  写 .codex/hooks.json 的 flow hooks（UserPromptSubmit / PreToolUse / Stop）"
		return 0
	fi
	mkdir -p "$repo/.codex"
	cur=
	[ ! -f "$hooks" ] || cur=$(cat "$hooks")
	[ -n "$cur" ] || cur='{}'
	# Codex 不给项目 hooks 暴露 PROJECT_DIR 一类的变量（0.166.0），命令只能写仓库内 vendor 的绝对路径；
	# 仓库搬家后重跑一次 install。
	new=$(printf '%s\n' "$cur" | jq --arg root "$repo/.jstack/vendor/plugins/flow" '
		def clean($mark):
			map(.hooks = ((.hooks // []) | map(select((.command // "") | contains($mark) | not))))
			| map(select((.hooks | length) > 0));
		.hooks = (.hooks // {}) |
		.hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) | clean(".jstack/vendor/plugins/flow"))
			+ [{hooks: [{type: "command", command: ("\"" + $root + "\"/hooks/prompt.sh"), timeout: 10}]}] |
		.hooks.PreToolUse = ((.hooks.PreToolUse // []) | clean(".jstack/vendor/plugins/flow"))
			+ [{matcher: "Bash", hooks: [{type: "command", command: ("\"" + $root + "\"/hooks/guard.sh"), timeout: 10}]}] |
		.hooks.Stop = ((.hooks.Stop // []) | clean(".jstack/vendor/plugins/flow"))
			+ [{hooks: [{type: "command", command: ("\"" + $root + "\"/hooks/stop.sh"), timeout: 10}]}]
	') || die "写 $hooks 失败：现有内容不是合法的 JSON"
	[ "$new" = "$cur" ] || printf '%s\n' "$new" >"$hooks"
}

harness_records() { # <harness>：lock 里记录、doctor 会核对的安装入口
	local h=$1 d p e
	case $h in
	claude-code) d=.claude/skills ;;
	pi | omp | codex | cursor) d=.agents/skills ;;
	*) return 1 ;;
	esac
	for p in $PLUGINS; do
		for e in $(entry_skills "$p"); do
			printf '%s\n' "$d/$e"
		done
	done
	if [ "$h" = claude-code ]; then
		printf '%s\n' .claude/agents/poteto-agent.md .claude/agents/comment-sicko.md .claude/settings.json
	fi
	if [ "$h" = pi ]; then
		printf '%s\n' .pi/extensions/jstack-flow-gates.ts .pi/settings.json .agents/agents/poteto-agent.md .agents/agents/comment-sicko.md
	fi
	if [ "$h" = omp ]; then
		printf '%s\n' .omp/extensions/jstack-flow-gates.ts .omp/agents/poteto-agent.md .omp/agents/comment-sicko.md
	fi
	if [ "$h" = cursor ]; then
		printf '%s\n' .cursor/hooks.json .cursor/agents/poteto-agent.md .cursor/agents/comment-sicko.md
	fi
	if [ "$h" = codex ]; then
		printf '%s\n' .codex/agents/poteto-agent.toml .codex/agents/comment-sicko.toml .codex/hooks.json
	fi
}

write_lock() { # <仓库> <harness>...：install 是唯一写 lock 的命令
	local repo=$1 vendor tree ver commit upstream plugins harnesses h recs recommended='{}'
	shift
	vendor="$repo/.jstack/vendor"
	tree=$(tree_hash "$vendor")
	ver=$(json_get version "$ROOT/package.json")
	commit=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)
	upstream=$(for h in pstack spec; do
		[ -f "$ROOT/upstream/$h.lock.json" ] || continue
		printf '%s\t%s\n' "$h" "$(jq -r '.sha // ""' "$ROOT/upstream/$h.lock.json")"
	done | jq -Rn '[inputs | split("\t") | {key: .[0], value: .[1]}] | from_entries')
	plugins=$(for h in $PLUGINS; do
		printf '%s\t%s\n' "$h" "$(json_get version "$ROOT/plugins/$h/.claude-plugin/plugin.json")"
	done | jq -Rn '[inputs | split("\t") | {key: .[0], value: {version: .[1]}}] | from_entries')
	harnesses='{}'
	for h in "$@"; do
		recs=$(harness_records "$h" | jq -Rn '[inputs]')
		harnesses=$(printf '%s\n' "$harnesses" |
			jq --arg h "$h" --argjson r "$recs" '. + {($h): {scope: "project", records: $r}}')
	done
	if printf '%s\n' "$@" | grep -qx pi; then
		recommended=$(python3 "$ROOT/scripts/pi-recommended.py" --metadata --scope project --repo "$repo" |
			jq '{pi: {source: .source, version: .pinned_version, scope: .scope, config: .config}}') ||
			die "读取 Pi 推荐包元数据失败"
	fi
	printf '%s\n' "$harnesses" | jq --arg ver "$ver" --arg commit "$commit" --arg tree "$tree" \
		--argjson upstream "$upstream" --argjson plugins "$plugins" --argjson recommended "$recommended" '
		{
			version: 1,
			jstack: ({version: $ver} + (if $commit == "" then {} else {commit: $commit} end)),
			vendor: {tree: $tree},
			upstream: $upstream,
			plugins: $plugins,
			recommended: $recommended,
			harnesses: .
		}' >"$WORK/lock.json" || die "生成 lock 失败"
	mkdir -p "$repo/.jstack"
	mv "$WORK/lock.json" "$repo/.jstack/lock.json"
}

# 只检查可提交性，不改目标仓库的忽略规则。已跟踪文件不受 ignore 影响。
project_ignored_files() { # <仓库>：诊断写 stderr，保持 doctor --json 可解析
	python3 -I - "$1" <<'PY'
import json, os, subprocess, sys
repo = sys.argv[1]
probe = subprocess.run(["git", "-C", repo, "rev-parse", "--is-inside-work-tree"], capture_output=True)
if probe.returncode or probe.stdout.strip() != b"true":
    sys.exit(0)
with open(os.path.join(repo, ".jstack/lock.json"), encoding="utf-8") as f:
    lock = json.load(f)
paths = {".jstack/lock.json"}
for h in lock.get("harnesses", {}).values():
    paths.update(h.get("records", []))
for root, dirs, files in os.walk(os.path.join(repo, ".jstack/vendor")):
    for name in files + [d for d in dirs if os.path.islink(os.path.join(root, d))]:
        paths.add(os.path.relpath(os.path.join(root, name), repo))
result = subprocess.run(["git", "-C", repo, "check-ignore", "--stdin", "-z"],
                        input=b"".join(os.fsencode(p) + b"\0" for p in sorted(paths)), capture_output=True)
if result.returncode not in (0, 1):
    print("! git check-ignore 失败：" + os.fsdecode(result.stderr), file=sys.stderr)
    sys.exit(1)
ignored = [os.fsdecode(p) for p in result.stdout.split(b"\0") if p]
if not ignored:
    sys.exit(0)
print(f"! 项目级安装有 {len(ignored)} 个路径被 Git 忽略，同事 clone 后会缺文件：", file=sys.stderr)
for p in ignored:
    print("  " + p, file=sys.stderr)
# gitignore 的 ! 不能穿过被忽略的父目录；按根到叶的顺序同时给出父目录白名单。
prefix = subprocess.check_output(["git", "-C", repo, "rev-parse", "--show-prefix"]).decode().strip()
rules = set()
for path in ignored:
    path = prefix + path
    if path.startswith(prefix + ".jstack/"):
        path = prefix + ".jstack/"
    parts = path.rstrip("/").split("/")
    for i in range(1, len(parts)):
        rules.add("/".join(parts[:i]) + "/")
    rules.add(path)
    if path.endswith("/"):
        rules.add(path + "**")
def escape(pattern):
    return pattern.replace("\\", "\\\\").replace("[", "\\[").replace("?", "\\?").replace("*", "\\*")
print("  请在 Git 根目录的 .gitignore 末尾加入所需白名单，并确认嵌套 .gitignore 没有再次排除：", file=sys.stderr)
for rule in sorted(rules):
    pattern = escape(rule[:-2]) + "**" if rule.endswith("/**") else escape(rule)
    print("  !/" + pattern, file=sys.stderr)
sys.exit(1)
PY
}

install_project() { # <仓库> <dry> <harness>...
	local repo=$1 dry=$2 vendor h
	shift 2
	for h in "$@"; do
		case $h in
		claude-code | pi | omp | cursor | codex) ;;
		*) die "未知 harness：$h" ;;
		esac
	done
	vendor="$repo/.jstack/vendor"
	install_vendor "$repo" "$dry"
	# Pi、OMP、Codex、Cursor 都能读 .agents/skills，共用一份入口；Claude Code 只读 .claude/skills。
	if printf '%s\n' "$@" | grep -qxE 'pi|omp|cursor|codex'; then
		link_entry_skills "$repo" .agents/skills "$vendor" "$dry"
	fi
	if printf '%s\n' "$@" | grep -qx claude-code; then
		link_entry_skills "$repo" .claude/skills "$vendor" "$dry"
	fi
	# Claude Code 走仓库内的 skill 软链、agents 副本和项目 hooks，不注册 marketplace。
	if printf '%s\n' "$@" | grep -qx claude-code; then
		install_agent "$repo" "$vendor" poteto-agent "$dry"
		install_agent "$repo" "$vendor" comment-sicko "$dry"
		install_claude_hooks "$repo" "$dry"
	fi
	for h in pi omp; do
		if printf '%s\n' "$@" | grep -qx "$h"; then
			install_project_extension "$repo" "$h" "$dry"
			install_project_agents "$repo" "$vendor" "$h" "$dry"
		fi
	done
	if printf '%s\n' "$@" | grep -qx pi; then
		install_pi_recommended project "$dry" "$repo"
	fi
	# Cursor 的项目 hooks 与 Claude 同源，但事件名和输出协议是 Cursor 原生的。
	if printf '%s\n' "$@" | grep -qx cursor; then
		cleanup_cursor_skills "$repo" "$dry"
		install_project_agents "$repo" "$vendor" cursor "$dry"
		install_cursor_hooks "$repo" "$dry"
	fi
	# Codex 从 .agents/skills 读 skill（和 Pi/OMP 共用），自定义 agent 要转成 TOML；
	# 门禁走 .codex/hooks.json，命令用 vendor 的绝对路径。
	if printf '%s\n' "$@" | grep -qx codex; then
		install_codex_agents "$repo" "$vendor" "$dry"
		install_codex_hooks "$repo" "$dry"
	fi
	if [ "$dry" -eq 0 ]; then
		write_lock "$repo" "$@"
		project_ignored_files "$repo" || die "安装文件被 Git 忽略；调整白名单后重新运行 install"
		if printf '%s\n' "$@" | grep -qx codex; then
			say "! Codex 项目门禁使用本机 clone 的绝对路径；其他机器 clone 或移动目录后须重跑 install（仅 skills 和 agents 可直接随仓库使用）。"
		fi
		say "✓ 项目级安装完成（${*}）：vendor 在 .jstack/vendor/，lock 在 .jstack/lock.json，提交这些文件和入口链接。"
		say "  Pi / OMP / Codex / Cursor 共用 .agents/skills；Pi / OMP 首次读取时会要求信任项目，Cursor 需要重开窗口。"
	else
		say "（--dry-run，不写任何文件）"
	fi
}

# OMP 的门禁扩展：OMP 的插件清单只收 skills/agents，不收 flow 的 Claude 格式 hooks，
# 所以在 ~/.omp/agent/extensions/ 放一个入口文件，转出 flow 插件里的扩展本身。
install_omp_extension() {
	local dir="$HOME/.omp/agent/extensions" target="$dir/jstack-flow-gates.ts" src="$ROOT/plugins/flow/extensions/omp.ts"
	[ -f "$src" ] || die "缺少 ${src#"$ROOT"/}，先运行 ./jstack build"
	mkdir -p "$dir"
	if [ -e "$target" ] && ! grep -q 'generated by jstack install' "$target"; then
		die "$target 已存在且不是 jstack 生成的；先备份或移走"
	fi
	{
		printf '// generated by jstack install; source: %s\n' "$src"
		printf 'export { default } from "%s";\n' "$src"
	} >"$target"
	say "✓ 已把 flow 的 OMP 门禁扩展接到 $target"
}

install_omp_user() {
	command -v omp >/dev/null 2>&1 || die "需要 OMP CLI（omp）"
	if ! omp plugin marketplace list 2>/dev/null | grep -q '^[[:space:]]*jstack[[:space:]]'; then
		omp plugin marketplace add "$ROOT"
	fi
	omp plugin install pstack@jstack spec@jstack flow@jstack
	install_omp_extension
	say "✓ 已安装 OMP 插件；重开 OMP 会话生效。"
}

install_codex_user() {
	local p
	command -v codex >/dev/null 2>&1 || die "需要 Codex CLI（codex）"
	codex plugin marketplace add "$ROOT" --json >/dev/null 2>&1 ||
		die "codex plugin marketplace add $ROOT 失败"
	for p in $PLUGINS; do
		# 已在 jstack marketplace 下装过就跳过；codex plugin add 不是幂等的幂等写法。
		if codex plugin list 2>/dev/null | grep -qE "^${p}@jstack[[:space:]]+installed"; then
			continue
		fi
		codex plugin add "$p@jstack" --json >/dev/null 2>&1 ||
			die "codex plugin add $p@jstack 失败"
	done
	say "✓ 已在 Codex 里添加 jstack marketplace 并安装 pstack、spec、flow"
	say "重开 Codex 会话；用 \$flow:route 或 /skills 选择器验证。"
}

install_claude_user() { # <scope>
	local scope=$1 p conflicts tool installed scoped by_scope=0 installed_now=0 markets
	command -v claude >/dev/null || die "需要 Claude Code CLI（claude）"
	for p in $PLUGINS; do
		[ -f "$ROOT/plugins/$p/.claude-plugin/plugin.json" ] || { cmd_build; break; }
	done
	# 先存进变量再 grep：直接用管道接 grep -q，grep 提前退出会让 claude 收到 SIGPIPE，在 pipefail 下误判。
	installed=$(claude plugin list --json 2>/dev/null || true)
	markets=$(claude plugin marketplace list --json 2>/dev/null || true)
	# 同一插件在 user / project / local 各有一条记录；只把本次 scope 的记录当成“已装”。
	scoped=$installed
	if command -v jq >/dev/null 2>&1; then
		scoped=$(printf '%s\n' "$installed" |
			jq -r --arg s "$scope" '.[] | select((.scope // "") == $s) | .id' 2>/dev/null || true)
		by_scope=1
	fi
	# 别的 marketplace 里的同名插件命令前缀相同，同时装会冲突，例如所有 pstack 移植版都是 /pstack:*。
	# mattpocock-skills 是 Matt 的完整版：skill 和 spec 重复，还带 implement 编排，会和 poteto-mode 抢主编排。
	conflicts=$(grep -oE "\"id\": *\"($(tr ' ' '|' <<<"$PLUGINS")|mattpocock-skills)@[^\"]*\"" <<<"$installed" |
		sed 's/.*"\([^"]*\)"$/\1/' | grep -v "@$MARKETPLACE\$" || true)
	[ -z "$conflicts" ] || die "已经装了 $(echo $conflicts)，和 jstack 的插件冲突：同名插件的命令前缀相同；mattpocock-skills 的 skill 和 spec 重复，还带 implement 编排。先卸载：$(printf '\n  claude plugin uninstall %s' $conflicts)"
	if grep -q "\"name\": *\"$MARKETPLACE\"" <<<"$markets"; then
		claude plugin marketplace update "$MARKETPLACE"
	else
		claude plugin marketplace add "$ROOT" --scope "$scope"
	fi
	for p in $PLUGINS; do
		if [ "$by_scope" -eq 1 ]; then
			grep -qx "$p@$MARKETPLACE" <<<"$scoped" && installed_now=1 || installed_now=0
		else
			grep -q "\"id\": *\"$p@$MARKETPLACE\"" <<<"$scoped" && installed_now=1 || installed_now=0
		fi
		if [ "$installed_now" -eq 1 ]; then
			claude plugin enable "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			# 本地 marketplace 的插件本来就从源目录加载；update 让 claude plugin list 里记的版本号跟上，
			# marketplace 来自 GitHub 时则真正拉取新版本。
			claude plugin update "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			say "✓ $p@$MARKETPLACE 已是最新，重开会话或运行 /reload-plugins 生效。"
		else
			claude plugin install "$p@$MARKETPLACE" --scope "$scope"
		fi
	done
	for tool in bun gh rg jq; do
		command -v "$tool" >/dev/null || case $tool in
			bun) say "! 没找到 bun：poteto-mode 的 watch-pr 和 statechart 脚本要用它" ;;
			gh) say "! 没找到 gh：开 PR、看 CI 的流程要用它" ;;
			rg) say "! 没找到 rg：搜索代码和 worktree-audit 要用它" ;;
			jq) say "! 没找到 jq：worktree-audit 要用它" ;;
			esac
	done
	cat <<'EOF'

接下来在 Claude Code 里：
  1. 运行 /reload-plugins，或新开一个会话
  2. 运行 ./jstack models init 配置各 harness 的模型，再运行 ./jstack models apply：
     写入 ~/.claude/rules/pstack-models.md 和 ~/.claude/settings.json 的模型 env（只需一次）
  3. 在要用 spec 的仓库里运行一次 /spec:setup-matt-pocock-skills，选定 issue tracker 和领域文档的位置
  4. 运行 /pstack:poteto-mode <任务描述> 开始工作。需求不清或任务较大时，先用 /spec:grill-with-docs、
     /spec:to-spec、/spec:to-tickets 澄清和拆解，再把 spec 或 ticket 交给 poteto-mode
EOF
}

cmd_install() {
	local scope=user all=0 repo= dry=0 h hs= any=0
	while [ $# -gt 0 ]; do
		case $1 in
		--all) all=1; shift ;;
		--dry-run) dry=1; shift ;;
		--repo)
			repo=${2:?--repo 后面要跟仓库路径}
			shift 2
			;;
		--scope)
			scope=${2:?--scope 后面要跟 user、project 或 local}
			shift 2
			;;
		--scope=*) scope=${1#*=}; shift ;;
		*) die "未知参数：$1（用法：./jstack install [--all] [--scope user|project] [--repo <dir>] [--dry-run]）" ;;
		esac
	done
	case $scope in user | project | local) ;; *) die "未知作用域：$scope（user、project 或 local）" ;; esac

	if [ "$scope" = project ]; then
		[ -n "$repo" ] || repo=$PWD
		repo=$(cd "$repo" 2>/dev/null && pwd -P) || die "--repo 指向的目录不存在"
		if [ "$all" -eq 1 ]; then
			for h in claude-code pi omp cursor codex; do
				if harness_present "$h"; then
					hs="$hs $h"
				else
					say "! 没找到 $h，跳过"
				fi
			done
		else
			harness_present claude-code ||
				die "没找到 Claude Code；加 --all 探测全部 harness，或先安装 claude"
			hs=" claude-code"
		fi
		[ -n "$hs" ] || die "没有探测到已安装的 harness"
		install_project "$repo" "$dry" $hs
		return
	fi

	[ "$dry" -eq 0 ] || die "--dry-run 只用于 --scope project"
	if [ "$all" -eq 1 ]; then
		if harness_present claude-code; then
			install_claude_user "$scope"
			any=1
		else
			say "! 没找到 Claude Code，跳过"
		fi
		if harness_present pi; then
			cmd_install_pi
			any=1
		else
			say "! 没找到 Pi，跳过"
		fi
		if harness_present omp; then
			install_omp_user
			any=1
		else
			say "! 没找到 OMP，跳过"
		fi
		if harness_present cursor; then
			cmd_install_cursor
			any=1
		else
			say "! 没找到 Cursor，跳过"
		fi
		if harness_present codex; then
			install_codex_user
			any=1
		else
			say "! 没找到 Codex，跳过"
		fi
		[ "$any" -eq 1 ] || die "没有探测到已安装的 harness"
		return
	fi
	install_claude_user "$scope"
}

cmd_install_cursor() {
	local target_root="$HOME/.cursor/plugins/local" name src target missing= link
	while [ $# -gt 0 ]; do
		case $1 in
		--copy) shift ;;
		--link) die "Cursor 的 user-local 插件加载器拒绝指向 ~/.cursor/plugins/local 之外的符号链接；install-cursor 只支持复制，去掉 --link 再运行" ;;
		*) die "未知参数：$1（install-cursor 默认复制，--copy 可省略）" ;;
		esac
	done
	# pstack 用 plugins/pstack 转换出的 Cursor 树；spec 和 flow 用带双 manifest 的同一份产物。
	for name in pstack spec flow; do
		case $name in
		pstack) src="$ROOT/plugins/pstack-cursor" ;;
		*) src="$ROOT/plugins/$name" ;;
		esac
		[ -f "$src/.cursor-plugin/plugin.json" ] || missing=1
	done
	[ -z "$missing" ] || cmd_build
	mkdir -p "$target_root"
	for name in pstack spec flow; do
		case $name in
		pstack) src="$ROOT/plugins/pstack-cursor" ;;
		*) src="$ROOT/plugins/$name" ;;
		esac
		[ -f "$src/.cursor-plugin/plugin.json" ] ||
			die "构建后仍没有 ${src#"$ROOT"/}/.cursor-plugin/plugin.json"
		target="$target_root/$name"
		if [ -e "$target" ] || [ -L "$target" ]; then
			if [ -f "$target/.cursor-plugin/plugin.json" ] &&
				[ "$(json_get name "$target/.cursor-plugin/plugin.json")" = "$name" ]; then
				:
			else
				die "$target 已存在且不是 $name Cursor 插件，先备份或移走再装"
			fi
		fi
		# 旧版 install-cursor 建过指向仓库的符号链接；Cursor 会拒绝它，这里自动换成副本。
		if [ -L "$target" ]; then
			link=$(readlink "$target")
			case $link in
			"$ROOT"/plugins/*) rm "$target" ;;
			*) die "$target 是指向 $link 的符号链接，不是 jstack 的构建产物；先移走再装" ;;
			esac
		fi
		mkdir -p "$target"
		# flow 的 .cursor-plugin/plugin.json 指向 hooks/hooks.cursor.json，Cursor 加载器会自己发现并运行；
		# hooks/hooks.json 是 Claude Code 的格式，留在副本里不影响 Cursor（清单只认 cursor 那份）。
		rsync -a --delete "$src/" "$target/"
		say "✓ 已复制 Cursor $name 到 $target"
	done
	say "在 Cursor 里重开窗口或运行 /reload；用 /poteto-mode、/route 验证。"
}

install_pi_recommended() { # <scope> <dry> <repo>
	local scope=$1 dry=$2 repo=$3
	local args=(--scope "$scope")
	[ "$scope" != project ] || args+=(--repo "$repo")
	[ "$dry" -eq 0 ] || args+=(--dry-run)
	python3 "$ROOT/scripts/pi-recommended.py" "${args[@]}" ||
		die "安装 Pi 推荐包失败：npm:@tintinweb/pi-subagents@0.23.2；网络不可用时先手动运行 pi install"
}

cmd_install_pi() {
	local agent_dir="${PI_AGENT_DIR:-$HOME/.pi/agent}"
	local agents="$agent_dir/agents" src spec
	command -v pi >/dev/null || die "需要 Pi CLI（pi）"
	[ -f "$ROOT/package.json" ] || die "缺少 package.json（Pi package manifest）"
	for spec in poteto-agent comment-sicko; do
		src="$ROOT/plugins/pstack/agents/$spec.md"
		[ -f "$src" ] || die "缺少 $src，先运行 ./jstack build"
		if [ -e "$agents/$spec.md" ] && ! grep -q 'generated by jstack install-pi' "$agents/$spec.md"; then
			die "$agents/$spec.md 已存在且不是 jstack 生成的；先备份或移走"
		fi
	done
	pi install "$ROOT" --approve
	# Pi 同时读 ~/.agents/skills 和 package skills；同名时让 .agents 里的那份生效。
	if ! python3 -I "$ROOT/scripts/pi-skill-filter.py" \
		--settings "$agent_dir/settings.json" \
		--agents "$HOME/.agents/skills" \
		--root "$ROOT"; then
		say "! 无法按 ~/.agents/skills 过滤 Pi package 的同名 skill；Pi 可能同时加载两份"
	fi
	mkdir -p "$agents"
	# Pi 的后台字段是 run_in_background，不是 Claude Code 的 background；装的时候转换。
	sed 's/^background: true$/run_in_background: true/' "$ROOT/plugins/pstack/agents/poteto-agent.md" |
		awk 'BEGIN{fm=0} /^---$/{fm++; print; if(fm==2) print "\n<!-- generated by jstack install-pi; source: plugins/pstack/agents/poteto-agent.md -->"; next} {print}' >"$agents/poteto-agent.md"
	awk 'BEGIN{fm=0} /^---$/{fm++; print; if(fm==2) print "\n<!-- generated by jstack install-pi; source: plugins/pstack/agents/comment-sicko.md -->"; next} {print}' \
		"$ROOT/plugins/pstack/agents/comment-sicko.md" >"$agents/comment-sicko.md"
	grep -q '^run_in_background: true$' "$agents/poteto-agent.md" ||
		die "poteto-agent 的 background 字段没有转成 run_in_background，检查上游 frontmatter"
	say "✓ 已安装 Pi package 和 pstack agents 到 $agents"
	install_pi_recommended user 0 ""
	say "重开 Pi 会话；用 /skill:poteto-mode 验证。"
}

case "${1:-}" in
