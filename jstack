		python3 -I - "${HOME}/.omp/agent/config.yml" <<'PY'
import re, sys
roles = {}
inside = False
try:
	with open(sys.argv[1], encoding="utf-8") as f:
		lines = f.readlines()
except OSError:
	lines = []
for line in lines:
	if re.match(r"^modelRoles:\s*$", line):
