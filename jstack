		backup="${path}.bak-models-$(date +%Y%m%d-%H%M%S)"
		cp -p "$path" "$backup"
		say "✓ 已备份 ${backup}"
	fi
	mv "$tmp" "$path"
	say "✓ 已写入 ${path}"
}

# 共享文件（OMP config.yml、Pi AGENTS.md）里只改 jstack 标记块，块外不碰。
# 退出码：0 已写，1 未变化，2 符号链接（不跟随），3 跳过。
models_merge_block() { # <path> <md|yaml> <content-file> <dry>
	local path=$1 kind=$2 file=$3 dry=$4 rc=0
	python3 -I - "$path" "$kind" "$file" "$dry" <<'PY' || rc=$?
import datetime, json, os, re, shutil, sys
path, kind, content_file, dry = sys.argv[1:5]
with open(content_file, encoding="utf-8") as f:
	block = f.read().rstrip("\n") + "\n"
begin = "<!-- jstack:models:begin -->" if kind == "md" else "# jstack:models:begin"
end = "<!-- jstack:models:end -->" if kind == "md" else "# jstack:models:end"
if os.path.islink(path):
	print(f"SKIP {path}: 是符号链接，不跟随写入")
	sys.exit(2)
exists = os.path.exists(path)
old = ""
if exists:
	with open(path, encoding="utf-8") as f:
		old = f.read()
new = None
if begin in old and end in old:
	pre, rest = old.split(begin, 1)
	_, post = rest.split(end, 1)
	new = pre + begin + "\n" + block + end + post
elif kind == "yaml":
	lines = old.splitlines(keepends=True)
	out = []
	i = 0
	while i < len(lines):
		if re.match(r"^modelRoles:\s*(#.*)?$", lines[i]):
			out.append(begin + "\n" + block + end + "\n")
			i += 1
			while i < len(lines) and (lines[i].startswith((" ", "\t"))):
				i += 1
			continue
		out.append(lines[i])
		i += 1
	if out and (not old or "".join(out) != old):
		new = "".join(out)
if new is None:
	sep = ""
	if old and not old.endswith("\n"):
		sep = "\n\n"
	elif old:
		sep = "\n"
	new = old + sep + begin + "\n" + block + end + "\n"
if new == old:
	print(f"= {path}（未变化）")
	sys.exit(1)
if dry == "1":
	print(f"- 将更新 {path}：")
	for line in block.splitlines():
		print("  " + line)
	sys.exit(0)
os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
if exists:
	stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
	backup = f"{path}.bak-models-{stamp}"
	shutil.copy2(path, backup)
	print(f"✓ 已备份 {backup}")
tmp = path + f".tmp.{os.getpid()}"
with open(tmp, "w", encoding="utf-8") as f:
	f.write(new)
if exists:
	shutil.copymode(path, tmp)
os.replace(tmp, path)
print(f"✓ 已更新 {path}")
PY
	return $rc
}

