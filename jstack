	esac
}

cmd_install() {
	local scope=user p conflicts tool installed markets
	while [ $# -gt 0 ]; do
		case $1 in
		--scope) scope=${2:?--scope 后面要跟 user、project 或 local}; shift 2 ;;
		--scope=*) scope=${1#*=}; shift ;;
		*) die "未知参数：$1" ;;
		esac
	done
	command -v claude >/dev/null || die "需要 Claude Code CLI（claude）"
	for p in $PLUGINS; do
		[ -f "$ROOT/plugins/$p/.claude-plugin/plugin.json" ] || { cmd_build; break; }
	done
	# 先存进变量再 grep：直接用管道接 grep -q，grep 提前退出会让 claude 收到 SIGPIPE，在 pipefail 下误判。
	installed=$(claude plugin list --json 2>/dev/null || true)
	markets=$(claude plugin marketplace list --json 2>/dev/null || true)
	# 别的 marketplace 里的同名插件命令前缀相同，同时装会冲突，例如所有 pstack 移植版都是 /pstack:*。
	# mattpocock-skills 是 Matt 的完整版：skill 和 spec 重复，还带 implement 编排，会和 poteto-mode 抢主编排。
	conflicts=$(grep -oE "\"id\": *\"($(tr ' ' '|' <<<"$PLUGINS")|mattpocock-skills)@[^\"]*\"" <<<"$installed" |
		sed 's/.*"\([^"]*\)"$/\1/' | grep -v "@$MARKETPLACE\$" || true)
	[ -z "$conflicts" ] || die "已经装了 $(echo $conflicts)，和 jstack 的插件冲突：同名插件的命令前缀相同；mattpocock-skills 的 skill 和 spec 重复，还带 implement 编排。先卸载：$(printf '\n  claude plugin uninstall %s' $conflicts)"
	if grep -q "\"name\": *\"$MARKETPLACE\"" <<<"$markets"; then
		claude plugin marketplace update "$MARKETPLACE"
	else
		claude plugin marketplace add "$ROOT" --scope "$scope"
	fi
	for p in $PLUGINS; do
		if grep -q "\"id\": *\"$p@$MARKETPLACE\"" <<<"$installed"; then
			claude plugin enable "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			# 本地 marketplace 的插件本来就从源目录加载；update 让 claude plugin list 里记的版本号跟上，
			# marketplace 来自 GitHub 时则真正拉取新版本。
			claude plugin update "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			say "✓ $p@$MARKETPLACE 已是最新，重开会话或运行 /reload-plugins 生效。"
		else
			claude plugin install "$p@$MARKETPLACE" --scope "$scope"
		fi
	done
	for tool in bun gh rg jq; do
		command -v "$tool" >/dev/null || case $tool in
			bun) say "! 没找到 bun：poteto-mode 的 watch-pr 和 statechart 脚本要用它" ;;
			gh) say "! 没找到 gh：开 PR、看 CI 的流程要用它" ;;
			rg) say "! 没找到 rg：搜索代码和 worktree-audit 要用它" ;;
			jq) say "! 没找到 jq：worktree-audit 要用它" ;;
			esac
	done
	cat <<'EOF'

接下来在 Claude Code 里：
  1. 运行 /reload-plugins，或新开一个会话
  2. 运行 ./jstack models init 配置各 harness 的模型，再运行 ./jstack models apply：
     写入 ~/.claude/rules/pstack-models.md 和 ~/.claude/settings.json 的模型 env（只需一次）
  3. 在要用 spec 的仓库里运行一次 /spec:setup-matt-pocock-skills，选定 issue tracker 和领域文档的位置
  4. 运行 /pstack:poteto-mode <任务描述> 开始工作。需求不清或任务较大时，先用 /spec:grill-with-docs、
     /spec:to-spec、/spec:to-tickets 澄清和拆解，再把 spec 或 ticket 交给 poteto-mode
EOF
}

cmd_install_cursor() {
	local target_root="$HOME/.cursor/plugins/local" name src target missing= link
	while [ $# -gt 0 ]; do
		case $1 in
		--copy) shift ;;
		--link) die "Cursor 的 user-local 插件加载器拒绝指向 ~/.cursor/plugins/local 之外的符号链接；install-cursor 只支持复制，去掉 --link 再运行" ;;
		*) die "未知参数：$1（install-cursor 默认复制，--copy 可省略）" ;;
		esac
	done
	# pstack 用 Cursor 原生树；spec 和 flow 用带双 manifest 的同一份产物。
	for name in pstack spec flow; do
		case $name in
		pstack) src="$ROOT/plugins/pstack-cursor" ;;
		*) src="$ROOT/plugins/$name" ;;
		esac
		[ -f "$src/.cursor-plugin/plugin.json" ] || missing=1
	done
	[ -z "$missing" ] || cmd_build
	mkdir -p "$target_root"
	for name in pstack spec flow; do
		case $name in
		pstack) src="$ROOT/plugins/pstack-cursor" ;;
		*) src="$ROOT/plugins/$name" ;;
		esac
		[ -f "$src/.cursor-plugin/plugin.json" ] ||
			die "构建后仍没有 ${src#"$ROOT"/}/.cursor-plugin/plugin.json"
		target="$target_root/$name"
		if [ -e "$target" ] || [ -L "$target" ]; then
			if [ -f "$target/.cursor-plugin/plugin.json" ] &&
				[ "$(json_get name "$target/.cursor-plugin/plugin.json")" = "$name" ]; then
				:
			else
				die "$target 已存在且不是 $name Cursor 插件，先备份或移走再装"
			fi
		fi
		# 旧版 install-cursor 建过指向仓库的符号链接；Cursor 会拒绝它，这里自动换成副本。
		if [ -L "$target" ]; then
			link=$(readlink "$target")
			case $link in
			"$ROOT"/plugins/*) rm "$target" ;;
			*) die "$target 是指向 $link 的符号链接，不是 jstack 的构建产物；先移走再装" ;;
			esac
		fi
		mkdir -p "$target"
		# flow 的 hooks 只为 Claude Code 写过、测过；Cursor 会自动加载 hooks/hooks.json，所以不带过去。
		if [ "$name" = flow ]; then
			rsync -a --delete --delete-excluded --exclude /hooks/ "$src/" "$target/"
		else
			rsync -a --delete "$src/" "$target/"
		fi
		say "✓ 已复制 Cursor $name 到 $target"
	done
	say "在 Cursor 里重开窗口或运行 /reload；用 /poteto-mode、/route 验证。"
}

cmd_install_pi() {
	local agents="$HOME/.pi/agent/agents" src spec
	command -v pi >/dev/null || die "需要 Pi CLI（pi）"
	[ -f "$ROOT/package.json" ] || die "缺少 package.json（Pi package manifest）"
	for spec in poteto-agent comment-sicko; do
		src="$ROOT/plugins/pstack/agents/$spec.md"
		[ -f "$src" ] || die "缺少 $src，先运行 ./jstack build"
		if [ -e "$agents/$spec.md" ] && ! grep -q 'generated by jstack install-pi' "$agents/$spec.md"; then
			die "$agents/$spec.md 已存在且不是 jstack 生成的；先备份或移走"
		fi
	done
	pi install "$ROOT" --approve
	mkdir -p "$agents"
	# Pi 的后台字段是 run_in_background，不是 Claude Code 的 background；装的时候转换。
	sed 's/^background: true$/run_in_background: true/' "$ROOT/plugins/pstack/agents/poteto-agent.md" |
		awk 'BEGIN{fm=0} /^---$/{fm++; print; if(fm==2) print "\n<!-- generated by jstack install-pi; source: plugins/pstack/agents/poteto-agent.md -->"; next} {print}' >"$agents/poteto-agent.md"
	awk 'BEGIN{fm=0} /^---$/{fm++; print; if(fm==2) print "\n<!-- generated by jstack install-pi; source: plugins/pstack/agents/comment-sicko.md -->"; next} {print}' \
		"$ROOT/plugins/pstack/agents/comment-sicko.md" >"$agents/comment-sicko.md"
	grep -q '^run_in_background: true$' "$agents/poteto-agent.md" ||
		die "poteto-agent 的 background 字段没有转成 run_in_background，检查上游 frontmatter"
	say "✓ 已安装 Pi package 和 pstack agents 到 $agents"
	say "重开 Pi 会话；用 /skill:poteto-mode 验证。"
	if ! pi list 2>/dev/null | grep -q 'pi-subagents'; then
		say "! 没找到 @tintinweb/pi-subagents：pstack 的子 agent 需要它，先运行 pi install npm:@tintinweb/pi-subagents"
	fi
}

case "${1:-}" in
install) shift; cmd_install "$@" ;;
install-pi) cmd_install_pi ;;
install-cursor) shift; cmd_install_cursor "$@" ;;
sync) shift; cmd_sync "$@" ;;
build) cmd_build ;;
check) shift; cmd_check "$@" ;;
smoke) shift; cmd_smoke "$@" ;;
models) shift; cmd_models "$@" ;;
eval) shift; "$ROOT/evals/run.sh" "$@" ;;
"" | -h | --help | help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
*) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
