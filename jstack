if exists:
	shutil.copymode(path, tmp)
os.replace(tmp, path)
print(f"✓ 已更新 {path} 的 4 个模型 env")
PY
}

models_usage_text() {
	cat <<'EOF'
用法：
  ./jstack models [show]                 显示配置路径、各 harness 的模型、预算和 apply 会写的文件
  ./jstack models init [--harness <h>] [--premium <id>] [--bulk <a,b>] [--force]
                                         引导配置 ~/.config/jstack/models.json；JSTACK_MODELS_CONFIG 可覆盖路径。
                                         非交互模式要同时给 --premium 和 --bulk；不给 --harness 时写入全部四个 harness
  ./jstack models set premium <id> [--harness <h>]
  ./jstack models set bulk <a,b> [--harness <h>]
                                         改一个值并自动 apply；--harness 默认 claude-code
  ./jstack models apply [--dry-run]      把配置写成各 harness 的规则文件
  ./jstack models status                 统计 premium 今日 token 用量
EOF
}

cmd_models_show() {
	local cfg harnesses h premium bulk0 bulk1 cap conc
	cfg=$(models_config_path)
	command -v python3 >/dev/null || die "models 需要 python3"
	printf '配置：%s\n' "$cfg"
	if [ ! -f "$cfg" ]; then
		say "尚未配置。运行 ./jstack models init 开始。"
		return 0
	fi
	harnesses=$(models_json "$cfg" harnesses)
	if [ -z "$harnesses" ]; then
		say "配置里还没有任何 harness。运行 ./jstack models init。"
		return 0
	fi
	for h in $harnesses; do
		premium=$(models_json "$cfg" get "$h" premium)
		bulk0=$(models_json "$cfg" get "$h" bulk0)
		bulk1=$(models_json "$cfg" get "$h" bulk1)
		printf '%-12s premium=%s  bulk=%s, %s\n' "$h" "$premium" "$bulk0" "$bulk1"
	done
	cap=$(models_json "$cfg" budget premium_daily_tokens)
	conc=$(models_json "$cfg" budget premium_concurrency)
	printf '预算：premium_daily_tokens=%s  premium_concurrency=%s\n' "$(models_unlimited "$cap")" "$(models_unlimited "$conc")"
	say "apply 会写："
	for h in $harnesses; do
		case $h in
		claude-code) say "  claude-code  ${HOME}/.claude/rules/pstack-models.md（无 frontmatter）；${HOME}/.claude/settings.json 的 4 个 env，改前备份 settings.json.bak-models-<时间>" ;;
		cursor) say "  cursor       ${HOME}/.cursor/rules/pstack-models.mdc（frontmatter: alwaysApply）" ;;
		omp) say "  omp          ${HOME}/.omp/agent/rules/pstack-models.md（frontmatter: alwaysApply）" ;;
		pi) say "  pi           不写文件，只打印角色表（~/.pi/agent/AGENTS.md 是符号链接，不能改）" ;;
		esac
	done
}

cmd_models_init() {
	local harness= premium= bulk= force=0 interactive=1 cfg cand targets h det
	local p_default b0_default b1_default p b0 b1 input answer skipped=0
	while [ $# -gt 0 ]; do
		case $1 in
		--harness) harness=${2:?--harness 后面要跟 harness 名}; shift 2 ;;
		--premium) premium=${2:?--premium 后面要跟模型 id}; shift 2 ;;
		--bulk) bulk=${2:?--bulk 后面要跟 a,b}; shift 2 ;;
		--force) force=1; shift ;;
		*) die "未知参数：$1（用法：./jstack models init [--harness <h>] [--premium <id>] [--bulk <a,b>] [--force]）" ;;
		esac
	done
	if [ -n "$harness" ]; then
		case $harness in
		claude-code|cursor|omp|pi) ;;
		*) die "未知 harness：${harness}（可用 claude-code、cursor、omp、pi）" ;;
		esac
	fi
	if [ -n "$premium" ] || [ -n "$bulk" ]; then
		interactive=0
		[ -n "$premium" ] && [ -n "$bulk" ] || die "非交互模式要同时给 --premium 和 --bulk"
		models_valid_id "$premium" || die "premium 不是合法的模型 id：${premium}"
		case $bulk in
		*,*,*) die "bulk 必须是正好两个模型 id，用逗号分隔" ;;
		esac
		b0=${bulk%%,*}
		b1=${bulk#*,}
		[ -n "$b0" ] && [ -n "$b1" ] || die "bulk 必须是正好两个模型 id，用逗号分隔"
		[ "$b0" != "$b1" ] || die "bulk 的两个模型必须不同"
		models_valid_id "$b0" || die "bulk 里的模型 id 不合法：${b0}"
		models_valid_id "$b1" || die "bulk 里的模型 id 不合法：${b1}"
	fi
	command -v python3 >/dev/null || die "models 需要 python3"
	cfg=$(models_config_path)
	cand="$WORK/models-candidate.json"
	rm -f "$cand"
	if [ -f "$cfg" ]; then cp "$cfg" "$cand"; fi
	if [ -n "$harness" ]; then targets=$harness; else targets="claude-code cursor omp pi"; fi
	if [ "$interactive" -eq 1 ]; then
		for h in $targets; do
			det=$(models_detect "$h")
			p_default=$(printf '%s\n' "$det" | sed -n '1p')
			b0_default=$(printf '%s\n' "$det" | sed -n '2p')
			b1_default=$(printf '%s\n' "$det" | sed -n '3p')
			if [ "$force" -eq 0 ] && [ -f "$cand" ] && models_json "$cand" has "$h" 2>/dev/null; then
				p_default=$(models_json "$cand" get "$h" premium)
				b0_default=$(models_json "$cand" get "$h" bulk0)
				b1_default=$(models_json "$cand" get "$h" bulk1)
			fi
			say "配置 ${h}（回车接受默认值，输入 q 跳过这个 harness）"
			skipped=0
			while :; do
				printf '  premium [%s]: ' "${p_default:-未检测到}"
				read -r input || { say "  读取结束，跳过 ${h}"; skipped=1; break; }
				if [ "$input" = q ] || [ "$input" = Q ]; then skipped=1; break; fi
				if [ -n "$input" ]; then p=$input; else p=$p_default; fi
				printf '  bulk0 [%s]: ' "${b0_default:-未检测到}"
				read -r input || { say "  读取结束，跳过 ${h}"; skipped=1; break; }
				if [ "$input" = q ] || [ "$input" = Q ]; then skipped=1; break; fi
				if [ -n "$input" ]; then b0=$input; else b0=$b0_default; fi
				printf '  bulk1 [%s]: ' "${b1_default:-未检测到}"
				read -r input || { say "  读取结束，跳过 ${h}"; skipped=1; break; }
				if [ "$input" = q ] || [ "$input" = Q ]; then skipped=1; break; fi
				if [ -n "$input" ]; then b1=$input; else b1=$b1_default; fi
				if ! models_valid_id "$p"; then say "  premium 不是合法的模型 id：${p}"; continue; fi
				if ! models_valid_id "$b0"; then say "  bulk0 不是合法的模型 id：${b0}"; continue; fi
				if ! models_valid_id "$b1"; then say "  bulk1 不是合法的模型 id：${b1}"; continue; fi
				if [ "$b0" = "$b1" ]; then say "  两个 bulk 必须不同，重新输入"; continue; fi
				models_write_harness "$cand" "$h" "$p" "$b0" "$b1"
				say "  ✓ ${h}: premium=${p} bulk=${b0}, ${b1}"
				break
			done
			if [ "$skipped" -eq 1 ]; then say "  已跳过 ${h}"; fi
		done
	else
		for h in $targets; do
			models_write_harness "$cand" "$h" "$premium" "$b0" "$b1"
			say "✓ ${h}: premium=${premium} bulk=${b0}, ${b1}"
		done
	fi
	if [ ! -f "$cand" ]; then
		say "没有配置任何 harness，未写入。"
		return 0
	fi
	if [ "$interactive" -eq 1 ]; then
		say "将写入 ${cfg}："
		sed 's/^/  /' "$cand"
		printf '确认写入？[y/N] '
		read -r answer || answer=
		case $answer in
		y|Y) ;;
		*)
			say "已取消，未写入。"
			return 0
			;;
		esac
	fi
	mkdir -p "$(dirname "$cfg")"
	cp "$cand" "${cfg}.tmp.$$"
	mv "${cfg}.tmp.$$" "$cfg"
	say "✓ 已写入 ${cfg}"
	say "下一步：./jstack models apply"
}

cmd_models_set() {
	local field= value= harness=claude-code cfg old_premium old_b0 old_b1 premium b0 b1
	while [ $# -gt 0 ]; do
		case $1 in
		--harness) harness=${2:?--harness 后面要跟 harness 名}; shift 2 ;;
		*)
			if [ -z "$field" ]; then
				field=$1
			elif [ -z "$value" ]; then
				value=$1
			else
				die "用法：./jstack models set premium|bulk <值> [--harness <h>]"
			fi
			shift
			;;
		esac
	done
	[ -n "$field" ] && [ -n "$value" ] || die "用法：./jstack models set premium|bulk <值> [--harness <h>]"
	case $harness in
	claude-code|cursor|omp|pi) ;;
	*) die "未知 harness：${harness}（可用 claude-code、cursor、omp、pi）" ;;
	esac
	cfg=$(models_config_path)
	[ -f "$cfg" ] || die "没有模型配置 ${cfg}，先运行 ./jstack models init"
	command -v python3 >/dev/null || die "models 需要 python3"
	if ! models_json "$cfg" has "$harness"; then
		die "配置里没有 ${harness}，先运行 ./jstack models init --harness ${harness}"
	fi
	old_premium=$(models_json "$cfg" get "$harness" premium)
	old_b0=$(models_json "$cfg" get "$harness" bulk0)
	old_b1=$(models_json "$cfg" get "$harness" bulk1)
	case $field in
	premium)
		models_valid_id "$value" || die "premium 不是合法的模型 id：${value}"
		premium=$value b0=$old_b0 b1=$old_b1
		;;
	bulk)
		case $value in
		*,*,*) die "bulk 必须是正好两个模型 id，用逗号分隔" ;;
		*,*) ;;
		*) die "bulk 必须是正好两个模型 id，用逗号分隔" ;;
		esac
		b0=${value%%,*}
		b1=${value#*,}
		[ -n "$b0" ] && [ -n "$b1" ] || die "bulk 必须是正好两个模型 id，用逗号分隔"
		[ "$b0" != "$b1" ] || die "bulk 的两个模型必须不同"
		models_valid_id "$b0" || die "bulk 里的模型 id 不合法：${b0}"
		models_valid_id "$b1" || die "bulk 里的模型 id 不合法：${b1}"
		premium=$old_premium
		;;
	*) die "未知字段：${field}（可用 premium、bulk）" ;;
	esac
	models_write_harness "$cfg" "$harness" "$premium" "$b0" "$b1"
	say "✓ 已更新 ${harness}：premium=${premium} bulk=${b0}, ${b1}"
	cmd_models_apply
}

cmd_models_apply() {
	local dry=0 cfg harnesses h premium bulk0 bulk1 cap conc degraded=0 tokens= stats_h stats_bulk0 summary= content
	while [ $# -gt 0 ]; do
		case $1 in
		--dry-run) dry=1; shift ;;
		*) die "未知参数：$1（用法：./jstack models apply [--dry-run]）" ;;
		esac
	done
	cfg=$(models_config_path)
	[ -f "$cfg" ] || die "没有模型配置 ${cfg}，先运行 ./jstack models init"
	command -v python3 >/dev/null || die "models 需要 python3"
	harnesses=$(models_json "$cfg" harnesses)
	[ -n "$harnesses" ] || die "配置里没有可用的 harness，先运行 ./jstack models init"
	cap=$(models_json "$cfg" budget premium_daily_tokens)
	conc=$(models_json "$cfg" budget premium_concurrency)
	if [ "$cap" != null ]; then
		stats_h=$(models_stats_harness "$cfg") || true
		if [ -n "$stats_h" ]; then
			premium=$(models_json "$cfg" get "$stats_h" premium)
			stats_bulk0=$(models_json "$cfg" get "$stats_h" bulk0)
			if tokens=$(models_usage "$premium"); then
				if [ "$tokens" -ge "$cap" ]; then
					degraded=1
					say "⚠ premium 今日已用 ${tokens} tokens，超过上限 ${cap}，判断类角色降级为 ${stats_bulk0}"
				fi
			fi
		fi
	fi
	if [ "$conc" != null ]; then
		say "! premium_concurrency=${conc} 只记录、不强制：Claude Code 没有按层并发控制。"
	fi
	for h in $harnesses; do
		premium=$(models_json "$cfg" get "$h" premium)
		bulk0=$(models_json "$cfg" get "$h" bulk0)
		bulk1=$(models_json "$cfg" get "$h" bulk1)
		case $h in
		claude-code)
			content=$(models_rule_content claude-code "$premium" "$bulk0" "$bulk1" "$degraded" "$cap" "$conc")
			models_emit_file "${HOME}/.claude/rules/pstack-models.md" "$content" "$dry"
			models_sync_settings "${HOME}/.claude/settings.json" "$premium" "$bulk0" "$bulk1" "$dry"
			summary="${summary} claude-code(opus=${premium}, sonnet=${bulk0}, haiku=${bulk1})"
			;;
		cursor)
			content=$(models_rule_content cursor "$premium" "$bulk0" "$bulk1" "$degraded" "$cap" "$conc")
			models_emit_file "${HOME}/.cursor/rules/pstack-models.mdc" "$content" "$dry"
			summary="${summary} cursor(premium=${premium}, bulk0=${bulk0}, bulk1=${bulk1})"
			;;
		omp)
			content=$(models_rule_content omp "$premium" "$bulk0" "$bulk1" "$degraded" "$cap" "$conc")
			models_emit_file "${HOME}/.omp/agent/rules/pstack-models.md" "$content" "$dry"
			summary="${summary} omp(premium=${premium}, bulk0=${bulk0}, bulk1=${bulk1})"
			;;
		esac
	done
	if printf '%s\n' "$harnesses" | grep -qx pi; then
		premium=$(models_json "$cfg" get pi premium)
		bulk0=$(models_json "$cfg" get pi bulk0)
		bulk1=$(models_json "$cfg" get pi bulk1)
		say "Pi 不写规则文件：~/.pi/agent/AGENTS.md 是指向全局治理文档的符号链接，不能改。"
		say "Pi 没有分角色的规则机制，角色模型要按配置手动传给子 agent（Agent 的 model 与 thinking）："
		printf '# premium = %s, bulk = %s, %s\n' "$premium" "$bulk0" "$bulk1"
		[ "$degraded" -eq 0 ] || printf '# premium degraded to %s: daily token cap reached\n' "$bulk0"
		models_budget_line "$cap" "$conc"
		models_role_lines pi "$premium" "$bulk0" "$bulk1" "$degraded"
	fi
	[ -n "$summary" ] || summary=" pi(不写文件)"
	if [ "$dry" -eq 1 ]; then
		say "- 模型配置将应用：${summary# }"
	else
		say "✓ 模型配置已应用：${summary# }"
	fi
}

cmd_models_status() {
	local cfg h premium tokens cap
	cfg=$(models_config_path)
	[ -f "$cfg" ] || die "没有模型配置 ${cfg}，先运行 ./jstack models init"
	command -v python3 >/dev/null || die "models 需要 python3"
	h=$(models_stats_harness "$cfg") || die "配置里没有可用的 harness"
	premium=$(models_json "$cfg" get "$h" premium)
	cap=$(models_json "$cfg" budget premium_daily_tokens)
	if tokens=$(models_usage "$premium"); then :; else tokens=-; fi
	if [ "$cap" = null ]; then
		printf 'premium 今日 tokens: %s / 上限 -（不限）\n' "$tokens"
	else
		printf 'premium 今日 tokens: %s / 上限 %s\n' "$tokens" "$cap"
	fi
}

cmd_models() {
	local sub=${1:-show}
	if [ $# -gt 0 ]; then shift; fi
	case $sub in
	show) cmd_models_show "$@" ;;
	init) cmd_models_init "$@" ;;
	set) cmd_models_set "$@" ;;
	apply) cmd_models_apply "$@" ;;
	status) cmd_models_status "$@" ;;
	-h|--help|help) models_usage_text ;;
