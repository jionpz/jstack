	printf '{"version":1,"vendor":{"tree":"%s"},"plugins":{"pstack":{"version":"9.9.9"},"flow":{"version":"1.0.0"}}}\n' "$tree" >"$r/.jstack/lock.json"
	cat >"$bin/claude" <<EOF
#!/usr/bin/env bash
printf '%s\n' '[{"id":"pstack@jstack","version":"9.9.9","scope":"user","installPath":"/fake/user/pstack","readFromFolder":"/fake/src/pstack","folderVersion":"9.9.10"},{"id":"flow@jstack","version":"1.0.0","scope":"project","installPath":"/fake/proj/flow","readFromFolder":"/fake/src/flow","folderVersion":"1.0.0","projectPath":"$r"}]'
EOF
	chmod +x "$bin/claude"
	if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1; then
		say "✗ 源目录版本漂移时 doctor 没有失败"
		rc=1
	fi

	if [ "$rc" -eq 0 ]; then
		say "✓ doctor：七种来源的安装矩阵、--json、lock 漂移、--no-fail 都通过"
	fi
	return $rc
}

# 项目级安装：vendor、入口软链、Claude hooks、lock，以及 doctor 的树哈希与入口核对。
# 只比较入口名称、链接目标和内容；ls -l 的分钟级 mtime 会让跨分钟运行误报不幂等。
install_entry_snapshot() {
	python3 - "$1" <<'PY'
import hashlib, json, os, sys
from pathlib import Path
root = Path(sys.argv[1])
rows = []
for name in ('.claude/skills', '.agents/skills', '.codex/agents'):
    directory = root / name
    for entry in sorted(directory.iterdir()):
        value = ('link', os.readlink(entry)) if entry.is_symlink() else ('file', hashlib.sha256(entry.read_bytes()).hexdigest())
        rows.append((str(entry.relative_to(root)), value))
print(json.dumps(rows, sort_keys=True))
PY
}

check_install_project() {
	local h="$WORK/install-home" r="$WORK/install-repo" bin="$WORK/install-bin" out want rc=0
	local d count p e v tree before after link path err="$WORK/install.err"
	rm -rf "$h" "$r" "$bin"
	mkdir -p "$h" "$r" "$bin"
	# mktemp 在 macOS 上给出 /var/...，locate.sh 会解析成 /private/var/...；先统一成物理路径再比较。
	h=$(cd "$h" && pwd -P)
	r=$(cd "$r" && pwd -P)
	bin=$(cd "$bin" && pwd -P)
	for p in claude pi omp cursor codex; do
		cat >"$bin/$p" <<'SH'
#!/usr/bin/env bash
if [ "${1:-} ${2:-}" = "plugin list" ]; then printf '[]\n'; fi
if [ "${1:-}" = install ]; then
	shift
	src=
	scope_local=0
	for a in "$@"; do
		case $a in
		-l | --local) scope_local=1 ;;
		npm:*) src=$a ;;
		esac
	done
	if [ "$scope_local" -eq 1 ]; then d=.pi; else d="$HOME/.pi/agent"; fi
	mkdir -p "$d"
	[ -f "$d/settings.json" ] || printf '{}\n' >"$d/settings.json"
	jq --arg s "$src" '.packages = (((.packages // []) + [$s]) | unique)' "$d/settings.json" >"$d/settings.json.tmp" &&
		mv "$d/settings.json.tmp" "$d/settings.json"
	exit 0
fi
if [ "${1:-}" = list ]; then
	if [ -f .pi/settings.json ] &&
		jq -e '(.packages // []) | any(.[]; type == "string" and contains("pi-subagents"))' .pi/settings.json >/dev/null 2>&1; then
		printf 'Project packages:\n'
		jq -r '.packages[] | select(contains("pi-subagents")) | "  \(.)"' .pi/settings.json
	fi
	exit 0
fi
exit 0
SH
		chmod +x "$bin/$p"
	done
	want=$(stage_providers "$ROOT/plugins/flow/skills/route/stages.md")
	[ -n "$want" ] || { say "✗ stages.md 没有提供者"; return 1; }

	# --dry-run 不落盘。
	if ! out=$(PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" --dry-run 2>&1); then
		say "✗ install --dry-run 失败："
		printf '%s\n' "$out" | tail -10 | sed 's/^/  /'
		return 1
	fi
	if [ -e "$r/.jstack" ]; then
		say "✗ install --dry-run 写了 .jstack"
		return 1
	fi

	if ! out=$(PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" 2>&1); then
		say "✗ install --all --scope project 失败："
		printf '%s\n' "$out" | tail -20 | sed 's/^/  /'
		return 1
	fi

	for p in $PLUGINS; do
		[ -f "$r/.jstack/vendor/plugins/$p/.claude-plugin/plugin.json" ] || {
			say "✗ vendor 缺少 $p"
			rc=1
		}
	done
	[ -f "$r/.jstack/vendor/.claude-plugin/marketplace.json" ] || {
		say "✗ vendor 缺少 marketplace.json"
		rc=1
	}
	for d in .claude/skills .agents/skills; do
		count=$(LC_ALL=C /bin/ls -A "$r/$d" 2>/dev/null | wc -l | tr -d ' ')
		if [ "$count" != 9 ]; then
			say "✗ $d 有 $count 个入口，预期 9（不能平铺全部 skill）"
			rc=1
		fi
	done
	# Cursor 也读 .agents/skills，不再单独写 .cursor/skills。
	if [ -e "$r/.cursor/skills" ]; then
		say "✗ Cursor 不应再创建 .cursor/skills（应共用 .agents/skills）"
		rc=1
	fi
	for e in poteto-agent comment-sicko; do
		for d in .agents/agents .omp/agents .cursor/agents; do
			if ! grep -q 'generated by jstack install' "$r/$d/$e.md" 2>/dev/null; then
				say "✗ 项目 agent 缺失：$d/$e.md"
				rc=1
			fi
		done
		grep -q 'generated by jstack install' "$r/.claude/agents/$e.md" 2>/dev/null || {
			say "✗ 缺少 jstack 生成的 .claude/agents/$e.md"
			rc=1
		}
		grep -q "^name = \"$e\"" "$r/.codex/agents/$e.toml" 2>/dev/null &&
			grep -q "^developer_instructions = '''" "$r/.codex/agents/$e.toml" || {
			say "✗ 缺少 jstack 生成的 .codex/agents/$e.toml（name 或 developer_instructions）"
			rc=1
		}
	done
	if ! jq -e --arg mark '.jstack/vendor/plugins/flow' '
		[(.hooks.UserPromptSubmit // []), (.hooks.PreToolUse // []), (.hooks.Stop // [])]
		| map(.[]? | .hooks[]?.command // "")
		| map(select(contains($mark))) as $ours
		| (($ours | length) == 3) and ([$ours[] | select(contains("hooks/hooks"))] | length) == 0
	' "$r/.claude/settings.json" >/dev/null 2>&1; then
		say "✗ .claude/settings.json 里的 flow hooks 不是三条"
		rc=1
	fi
	if ! jq -e '
		(.version == 1) and
		([.hooks[][].command // empty] | map(select(contains(".jstack/vendor/plugins/flow"))) | length == 3) and
		([.hooks[][].command // empty] | map(select(contains("hooks/hooks"))) | length == 0)
	' "$r/.cursor/hooks.json" >/dev/null 2>&1; then
		say "✗ .cursor/hooks.json 里的 flow hooks 不是三条"
		rc=1
	fi
	if ! jq -e --arg root "\"$r/.jstack/vendor/plugins/flow\"" '
		([.hooks[][] | .hooks[]?.command // empty] | map(select(contains(".jstack/vendor/plugins/flow"))) | length == 3) and
		([.hooks[][] | .hooks[]?.command // empty] | map(select(startswith($root))) | length == 3) and
		([.hooks[][] | .hooks[]?.command // empty] | map(select(contains("hooks/hooks"))) | length == 0) and
		(.hooks.PreToolUse[0].matcher == "Bash")
	' "$r/.codex/hooks.json" >/dev/null 2>&1; then
		say "✗ .codex/hooks.json 里的 flow hooks 不是三条绝对路径"
		rc=1
	fi

	for p in pi omp; do
		if ! grep -qxF "export { default } from \"../../.jstack/vendor/plugins/flow/extensions/$p.ts\";" \
			"$r/.$p/extensions/jstack-flow-gates.ts"; then
			say "✗ $p 项目扩展没有相对转出 vendor"
			rc=1
		fi
	done
	grep -q '^run_in_background: true$' "$r/.agents/agents/poteto-agent.md" || rc=1
	grep -q '^is_background: true$' "$r/.cursor/agents/poteto-agent.md" || rc=1
	# lock：版本、树哈希、五个 harness 的记录。
	tree=$(jq -r '.vendor.tree // empty' "$r/.jstack/lock.json" 2>/dev/null || true)
	if [ "$tree" != "$(tree_hash "$r/.jstack/vendor")" ]; then
		say "✗ lock 的 vendor 树哈希与实际 vendor 不一致"
		rc=1
	fi
	for p in $PLUGINS; do
		v=$(json_get version "$ROOT/plugins/$p/.claude-plugin/plugin.json")
		if [ "$(jq -r --arg p "$p" '.plugins[$p].version // empty' "$r/.jstack/lock.json" 2>/dev/null)" != "$v" ]; then
			say "✗ lock 里 $p 的版本不是 $v"
			rc=1
		fi
	done
	if ! jq -e '(.harnesses | keys | sort) == ["claude-code", "codex", "cursor", "omp", "pi"]' "$r/.jstack/lock.json" >/dev/null 2>&1; then
		say "✗ lock 的 harnesses 不是五个都记录"
		rc=1
	fi

	# Claude Code 和共享 .agents/skills（Pi/OMP/Cursor/Codex）的 route 入口都要 locate 到阶段表的全部提供者，且路径落在 vendor 里。
	for link in .claude/skills/route .agents/skills/route; do
		if ! out=$(HOME="$h" bash "$r/$link/locate.sh" 2>"$err"); then
			say "✗ 从 $link 运行 locate.sh 失败："
			sed 's/^/  /' "$err" | head -10
			rc=1
			continue
		fi
		if [ "$(printf '%s\n' "$out" | cut -f1)" != "$want" ]; then
			say "✗ 从 $link 定位的提供者与 stages.md 不一致"
			rc=1
		fi
		while IFS= read -r path; do
			case $path in
			"$r/.jstack/vendor/"*) [ -f "$path" ] || {
				say "✗ $path 不存在"
				rc=1
			} ;;
			*) say "✗ $path 不在 vendor 里"; rc=1 ;;
			esac
		done < <(printf '%s\n' "$out" | cut -f2)
	done

	# Cursor 改读 .agents/skills：旧安装留下的 .cursor/skills 软链要被清掉，用户自己的入口保留。
	mkdir -p "$r/.cursor/skills"
	ln -s "../../.jstack/vendor/plugins/flow/skills/route" "$r/.cursor/skills/route"
	ln -s "../../somewhere/else" "$r/.cursor/skills/keep"
	if ! out=$(PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" 2>&1); then
		say "✗ 清理旧 .cursor/skills 时 install 失败"
		rc=1
	fi
	if [ -e "$r/.cursor/skills/route" ] || [ -L "$r/.cursor/skills/route" ]; then
		say "✗ 旧 .cursor/skills/route 软链没有被清理"
		rc=1
	fi
	[ -L "$r/.cursor/skills/keep" ] || {
		say "✗ 用户自己的 .cursor/skills/keep 被删了"
		rc=1
	}
	grep -q '.cursor/skills 里还有非 jstack 的入口' <<<"$out" || {
		say "✗ install 没有提示 .cursor/skills 里还有用户入口"
		rc=1
	}
	rm -f "$r/.cursor/skills/keep"
	rmdir "$r/.cursor/skills" 2>/dev/null || true

	# 重复运行：不新增链接、不重复 hooks、lock 不变。
	before=$({ tree_hash "$r/.pi"; tree_hash "$r/.omp"; tree_hash "$r/.agents/agents"; tree_hash "$r/.cursor/agents"
		install_entry_snapshot "$r"
		cat "$r/.claude/settings.json" "$r/.cursor/hooks.json" "$r/.codex/hooks.json" "$r/.jstack/lock.json" "$r"/.codex/agents/*.toml; } | sha256_stream)
	if ! PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1; then
		say "✗ 重复运行 install 失败"
		rc=1
	fi
	after=$({ tree_hash "$r/.pi"; tree_hash "$r/.omp"; tree_hash "$r/.agents/agents"; tree_hash "$r/.cursor/agents"
		install_entry_snapshot "$r"
		cat "$r/.claude/settings.json" "$r/.cursor/hooks.json" "$r/.codex/hooks.json" "$r/.jstack/lock.json" "$r"/.codex/agents/*.toml; } | sha256_stream)
	if [ "$before" != "$after" ]; then
		say "✗ 重复运行 install 改变了安装产物（hooks、链接或 lock）"
		rc=1
	fi

	# doctor：刚装完一致；改一个 vendor 文件或删一个入口都要报出来。
	if ! out=$(PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" --json 2>/dev/null); then
		say "✗ doctor 对刚安装的仓库报了失败"
		rc=1
	elif ! printf '%s\n' "$out" | python3 -I -c '
import json, sys
rows = json.load(sys.stdin)
vendor = [r for r in rows if r["harness"] == "vendor"]
assert len(vendor) == 3, rows
assert all(r["lock"] == "ok" for r in vendor), vendor
'; then
		say "✗ doctor --json 的 vendor 行不是三条 ok"
		rc=1
	fi
	printf 'x\n' >"$r/.jstack/vendor/plugins/flow/tampered"
	if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1; then
		say "✗ vendor 被改过后 doctor 没有失败"
		rc=1
	fi
	rm -f "$r/.jstack/vendor/plugins/flow/tampered"
	rm -f "$r/.agents/skills/route"
	if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1; then
		say "✗ 入口链接缺失时 doctor 没有失败"
		rc=1
	fi
	if ! PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1; then
		say "✗ 恢复入口链接失败"
		rc=1
	fi
	rm -f "$r/.cursor/hooks.json"
	if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1; then
		say "✗ .cursor/hooks.json 缺失时 doctor 没有失败"
		rc=1
	fi
	if ! PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1; then
		say "✗ 恢复 .cursor/hooks.json 失败"
		rc=1
	fi
	rm -f "$r/.codex/hooks.json"
	if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1; then
		say "✗ .codex/hooks.json 缺失时 doctor 没有失败"
		rc=1
	fi
	if ! PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1; then
		say "✗ 恢复 .codex/hooks.json 失败"
		rc=1
	fi

	# 新入口记入 lock：删除任一文件后 doctor 必须发现，install 能恢复。
	for path in .pi/extensions/jstack-flow-gates.ts .pi/settings.json .omp/extensions/jstack-flow-gates.ts \
		.agents/agents/poteto-agent.md .omp/agents/poteto-agent.md .cursor/agents/poteto-agent.md .claude/settings.json; do
		rm -f "$r/$path"
		if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1; then
			say "✗ $path 缺失时 doctor 没有失败"
			rc=1
		fi
		PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1 || rc=1
	done
	printf '// tampered\n' >>"$r/.pi/extensions/jstack-flow-gates.ts"
	sed -i.bak 's|../../.jstack|/wrong/.jstack|' "$r/.pi/extensions/jstack-flow-gates.ts"
	rm -f "$r/.pi/extensions/jstack-flow-gates.ts.bak"
	if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1; then
		say "✗ 项目扩展指向其他 checkout 时 doctor 没有失败"
		rc=1
	fi
	PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1 || rc=1
	# 没有 .agents 对应位置的 harness 专属文件，遇到用户文件必须报错并保留。
	for path in .pi/extensions/jstack-flow-gates.ts .cursor/agents/comment-sicko.md; do
		cp "$r/$path" "$WORK/saved-entry"
		printf 'user owned\n' >"$r/$path"
		if PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1 ||
			[ "$(cat "$r/$path")" != 'user owned' ]; then
			say "✗ install 没有保护已有的 $path"
			rc=1
		fi
		cp "$WORK/saved-entry" "$r/$path"
	done
	# .agents 是共享权威位置：同名用户文件保留并跳过，install 不失败。
	cp "$r/.agents/agents/poteto-agent.md" "$WORK/saved-entry"
	printf 'user owned\n' >"$r/.agents/agents/poteto-agent.md"
	if ! PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1 ||
		[ "$(cat "$r/.agents/agents/poteto-agent.md")" != 'user owned' ]; then
		say "✗ install 没有保留 .agents/agents 里已有的 poteto-agent.md"
		rc=1
	fi
	cp "$WORK/saved-entry" "$r/.agents/agents/poteto-agent.md"
	# .agents/skills 里的同名用户入口也保留并跳过。
	rm -f "$r/.agents/skills/route"
	mkdir -p "$r/.agents/skills/route"
	printf -- '---\nname: route\ndescription: user owned\n---\n' >"$r/.agents/skills/route/SKILL.md"
	if ! PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1 ||
		[ ! -f "$r/.agents/skills/route/SKILL.md" ]; then
		say "✗ install 没有保留 .agents/skills 里已有的 route"
		rc=1
	fi
	rm -f "$r/.agents/skills/route/SKILL.md"
	rmdir "$r/.agents/skills/route"
	PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1 || rc=1
	# 真实 Git 忽略规则：vendor 的目录、样本和项目入口都不能静默漏提交。
	git -C "$r" init -q
	printf 'research/\n*.out\n/.pi/\n.omp/\n/.claude/*\n' >"$r/.gitignore"
	printf 'fixture\n' >"$r/.jstack/vendor/plugins/flow/sample.out"
	for p in install doctor; do
		if [ "$p" = install ]; then
			out=$(PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" 2>"$err") && rc=1
		else
			out=$(PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" --json 2>"$err") && rc=1
			printf '%s\n' "$out" | python3 -I -c 'import json,sys; json.load(sys.stdin)' || rc=1
		fi
		grep -q '被 Git 忽略' "$err" && grep -q '!/.jstack/\*\*' "$err" && grep -q '.pi/extensions/jstack-flow-gates.ts' "$err" || rc=1
	done
	# 把诊断中的建议原样追加，必须能修复安装。
	sed -n 's/^  \(!\/.*\)/\1/p' "$err" >>"$r/.gitignore"
	PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" install --all --scope project --repo "$r" >/dev/null 2>&1 || rc=1
	PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1 || rc=1
	# 已提交的文件不受后加的忽略规则影响。
	git -C "$r" add -f .pi/extensions/jstack-flow-gates.ts .pi/settings.json
	printf '/.pi/\n' >"$r/.gitignore"
	PATH="$bin:$PATH" HOME="$h" "$ROOT/jstack" doctor --repo "$r" >/dev/null 2>&1 || rc=1
	if [ "$rc" -eq 0 ]; then
		say "✓ 项目级安装：vendor、9 入口（Cursor 共用 .agents/skills）、五 harness agents/hooks/extensions、lock、locate、幂等、dry-run、.agents 优先、旧 .cursor/skills 清理与 Git 忽略规则检查通过"
	fi
	return $rc
}

# Cursor 版 pstack 由 plugins/pstack 转换生成。重跑一次转换，核对产物没有被手改；
# 同时核对 rules.tsv 的每条规则都命中差异，转换改动的文件正好是规则命中的文件。
check_pstack_cursor() {
	local src="$WORK/check/pstack-cursor-src" out="$WORK/check/pstack-cursor"
	local rc=0 id kind scope from to n total=0 targets="$WORK/cursor-targets"
	local diffs skill_diffs agent_diffs want_skill want_agent unexpected manifest logo hits=
	: >"$targets"
	use_plugin pstack
	build_into "$src"
	cursor_rules >"$WORK/cursor-rules-check"
	while IFS=$'\t' read -r id kind scope from to; do
		if ! cursor_rule_kind_ok "$kind"; then
			say "✗ Cursor 转换规则 ${id} 的 kind 不认识：${kind}"
			rc=1
			continue
		fi
		if [ "$from" = - ]; then from=; fi
		n=$(cursor_rule_targets "$src" "$kind" "$scope" "$from" | wc -l | tr -d ' ')
		if [ "$n" -eq 0 ]; then
			say "✗ Cursor 转换规则 ${id} 在 pstack 构建结果里没有命中差异（上游可能改了措辞，同步规则表）"
			rc=1
		fi
		total=$((total + 1))
		cursor_rule_targets "$src" "$kind" "$scope" "$from" >>"$targets"
	done <"$WORK/cursor-rules-check"

	rm -rf "$out"
	mkdir -p "$out"
	rsync -a "$src/" "$out/"
	convert_pstack_cursor "$out"
	if diff -rq -x node_modules "$out" "$PSTACK_CURSOR" >"$WORK/cursor-diff" 2>&1 &&
		diff <(cd "$out" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) \
			<(cd "$PSTACK_CURSOR" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) >/dev/null; then
		say "✓ plugins/pstack-cursor 与 plugins/pstack 的 Cursor 转换结果一致（$(json_get version "$PSTACK_CURSOR/.cursor-plugin/plugin.json")）"
	else
		say "✗ plugins/pstack-cursor 与转换结果不一致：可能被手改过，或改了转换规则后没有运行 ./jstack build"
		sed 's/^/  /' "$WORK/cursor-diff" | head -20
		rc=1
	fi

	# 转换只允许改规则命中的文件，外加增删 .claude-plugin / .cursor-plugin / assets。
	diffs=$(diff -rq "$src" "$out" 2>&1 || true)
	skill_diffs=$(printf '%s\n' "$diffs" | grep -cE '/skills/.* differ$' || true)
	agent_diffs=$(printf '%s\n' "$diffs" | grep -cE '/agents/.* differ$' || true)
	want_skill=$(grep -F '/skills/' "$targets" | sort -u | wc -l | tr -d ' ')
	want_agent=$(grep -F '/agents/' "$targets" | sort -u | wc -l | tr -d ' ')
	unexpected=$(printf '%s\n' "$diffs" |
		grep -vE '/skills/.* differ$|/agents/.* differ$|Only in .*: \.claude-plugin$|Only in .*: \.cursor-plugin$|Only in .*: assets$' || true)
	if [ -z "$unexpected" ] && [ "$skill_diffs" -eq "$want_skill" ] && [ "$agent_diffs" -eq "$want_agent" ]; then
		say "✓ Cursor 转换只改动规则覆盖的文件：skills/ ${skill_diffs} 个、agents/ ${agent_diffs} 个（${total} 条规则）"
	else
		say "✗ Cursor 转换改动的文件与规则表不一致：skills/ ${skill_diffs}（规则 ${want_skill}）、agents/ ${agent_diffs}（规则 ${want_agent}）"
		[ -z "$unexpected" ] || printf '%s\n' "$unexpected" | sed "s|$WORK/check/||g; s/^/  /" | head -20
		rc=1
	fi

	manifest="$PSTACK_CURSOR/.cursor-plugin/plugin.json"
	if [ ! -f "$manifest" ]; then
		say "✗ plugins/pstack-cursor 缺少 .cursor-plugin/plugin.json"
		rc=1
	else
		[ "$(json_get name "$manifest")" = pstack ] || hits="${hits:+$hits, }name"
		[ "$(json_get skills "$manifest")" = ./skills/ ] || hits="${hits:+$hits, }skills"
		[ "$(json_get agents "$manifest")" = ./agents/ ] || hits="${hits:+$hits, }agents"
		[ -f "$PSTACK_CURSOR/skills/poteto-mode/SKILL.md" ] || hits="${hits:+$hits, }poteto-mode"
		[ -f "$PSTACK_CURSOR/agents/poteto-agent.md" ] || hits="${hits:+$hits, }poteto-agent"
		logo=$(json_get logo "$manifest")
		if [ -n "$logo" ] && [ ! -f "$PSTACK_CURSOR/$logo" ]; then
			hits="${hits:+$hits, }logo"
		fi
		[ ! -d "$PSTACK_CURSOR/.claude-plugin" ] || hits="${hits:+$hits, }.claude-plugin 残留"
		if [ -n "$hits" ]; then
			say "✗ plugins/pstack-cursor 不是完整的 Cursor pstack 产物：${hits}"
			rc=1
		else
			say "✓ plugins/pstack-cursor 是 Cursor 插件 pstack（$(json_get version "$manifest")），skills、agents 和 logo 齐全"
		fi
	fi
	if grep -rqF 'If you are not in Cursor, read [the harness adapter]' "$PSTACK_CURSOR/skills" 2>/dev/null; then
		say "✗ plugins/pstack-cursor 的 skill 里还有 adapter 提示，转换规则没有覆盖"
		rc=1
	fi
	if grep -rqE '^background: true$' "$PSTACK_CURSOR/agents" 2>/dev/null; then
		say "✗ plugins/pstack-cursor 的 agent 里还有 Claude Code 的 background 字段"
		rc=1
	fi
	if ! grep -qF '~/.cursor/projects' "$PSTACK_CURSOR/skills/poteto-mode/scripts/worktree-audit.sh" ||
		grep -qF '~/.claude/projects' "$PSTACK_CURSOR/skills/poteto-mode/scripts/worktree-audit.sh"; then
		say "✗ plugins/pstack-cursor 的 worktree-audit.sh 没有换成 Cursor 的会话记录路径"
		rc=1
	fi
	if ! grep -qF '[Claude Code adapter](../../docs/harness/claude-code.md)' "$PSTACK_CURSOR/skills/poteto-help/SKILL.md" ||
		grep -qF '[harness adapter](../../docs/harness/agents.md)' "$PSTACK_CURSOR/skills/poteto-help/SKILL.md"; then
		say "✗ plugins/pstack-cursor 的 poteto-help 没有换回 Claude Code adapter 链接"
		rc=1
	fi
	return $rc
}

# Codex 直接读 Claude Code 的 marketplace 和插件清单。用临时 CODEX_HOME 走一遍
# marketplace add / plugin add，核对三个插件都能装进缓存，且缓存里带 .claude-plugin/plugin.json 和 skills/。
check_codex_manifest() {
	local home="$WORK/codex-manifest-home" p hit rc=0
	if ! command -v codex >/dev/null 2>&1; then
		say "- 没找到 codex CLI，跳过 Codex manifest 校验"
		return 0
	fi
	rm -rf "$home"
	mkdir -p "$home"
	if ! CODEX_HOME="$home" codex plugin marketplace add "$ROOT" --json >"$WORK/codex-add" 2>"$WORK/codex.err"; then
		say "✗ Codex 无法添加 jstack marketplace："
		sed 's/^/  /' "$WORK/codex.err" | head -10
		return 1
	fi
	for p in $PLUGINS; do
		if ! CODEX_HOME="$home" codex plugin add "$p@jstack" --json >"$WORK/codex-add" 2>"$WORK/codex.err"; then
			say "✗ Codex 无法安装 $p@jstack："
			sed 's/^/  /' "$WORK/codex.err" | head -10
			rc=1
			continue
		fi
		hit=$(find "$home/plugins/cache/jstack/$p" -maxdepth 3 -name plugin.json -path '*/.claude-plugin/*' 2>/dev/null | head -1)
		[ -n "$hit" ] || {
			say "✗ Codex 缓存的 $p 里没有 .claude-plugin/plugin.json"
			rc=1
		}
		find "$home/plugins/cache/jstack/$p" -maxdepth 6 -name SKILL.md 2>/dev/null | grep . >/dev/null || {
			say "✗ Codex 缓存的 $p 里没有 skill"
			rc=1
		}
	done
	[ "$rc" -eq 0 ] && say "✓ Codex manifest：marketplace 可添加，pstack/spec/flow 可安装且带 Claude 清单与 skills"
	return $rc
}

cmd_check() {
	local rc=0 p hits failed= smoke= hooks_rel=
	while [ $# -gt 0 ]; do
		case $1 in
		--smoke) smoke=1; shift ;;
		*) die "未知参数：$1（可用 --smoke）" ;;
		esac
	done
	for p in $PLUGINS; do
		use_plugin "$p"
		build_into "$WORK/check/$p"
		if diff -rq -x node_modules "$WORK/check/$p" "$OUT" >"$WORK/diff" 2>&1 &&
			diff <(cd "$WORK/check/$p" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) \
				<(cd "$OUT" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) >/dev/null; then
			say "✓ plugins/$PLUGIN 与 upstream/ 加 patches/ 的构建结果一致（$(json_get version "$OUT/$MANIFEST")）"
		else
			say "✗ plugins/$PLUGIN 与构建结果不一致：可能被手改过，或改了补丁后没有运行 ./jstack build"
			sed 's/^/  /' "$WORK/diff" | head -20
			rc=1
		fi
		# 锁文件记着 sync 写入时副本的内容哈希。对不上，说明副本被手改过，或者不是用 sync 更新的。
		if [ -n "$OWN" ]; then
			say "- $PLUGIN 没有上游，跳过锁文件校验"
		elif [ "$(json_get tree "$LOCK")" = "$(tree_hash "$VENDOR")" ]; then
			say "✓ upstream/$PLUGIN 与锁文件一致（$(json_get version "$LOCK") @ $(json_get sha "$LOCK" | cut -c1-7)）"
		else
			say "✗ upstream/$PLUGIN 与 upstream/$PLUGIN.lock.json 记录的内容对不上：副本只能由 ./jstack sync 写入"
			rc=1
		fi
		# 上游 adapter 只翻译 Markdown 里的 Cursor 名称，脚本里写死的 Cursor 路径要靠补丁修。
		if hits=$(grep -rnIE '(\$HOME|~)/\.cursor/|agent-transcripts' --exclude='*.md' --exclude-dir=node_modules "$OUT"); then
			say "✗ plugins/$PLUGIN 的脚本里还有写死的 Cursor 路径，需要补丁："
			printf '%s\n' "$hits" | sed "s|$ROOT/||; s/^/  /" | head -20
			rc=1
		else
			say "✓ plugins/$PLUGIN 的脚本里没有写死的 Cursor 路径"
		fi
		# frontmatter 由 Claude Code 自己解析，也不经过 adapter。不认识的键会被静默忽略，claude plugin validate
		# 也不报，例如 Cursor 的 is_background。名单取自 https://code.claude.com/docs/en/claude-directory，
		# 插件 agent 会忽略的 permissionMode、hooks、mcpServers、initialPrompt 不在名单里。
		# skill 名单多放了 icon 和 color：它们是 Cursor 界面用的，Claude Code 忽略了也不影响行为。
		# pstack 的 skill 在 skills/<名字>/，spec 沿用上游的 skills/<分类>/<名字>/。
		hits=$(
			fm_unknown_keys 'name|description|when_to_use|argument-hint|arguments|disable-model-invocation|user-invocable|allowed-tools|disallowed-tools|model|effort|context|agent|background|hooks|paths|shell|metadata|license|compatibility|icon|color' \
				"$OUT"/skills/*/SKILL.md "$OUT"/skills/*/*/SKILL.md
			fm_unknown_keys 'name|description|tools|disallowedTools|model|maxTurns|autoCompactWindow|skills|memory|background|effort|isolation|color|omitClaudeMd|experimental' \
				"$OUT"/agents/*.md
		)
		bad_yaml=$(fm_plain_colon "$OUT"/skills/*/SKILL.md "$OUT"/skills/*/*/SKILL.md)
		if [ -n "$bad_yaml" ]; then
			say "✗ plugins/$PLUGIN 的 frontmatter 有未加引号又含「: 」的值，Cursor 加载器会丢掉整个 skill，需要加引号："
			printf '%s\n' "$bad_yaml" | sed 's/^/  /' | head -10
			rc=1
		fi
		if [ -n "$hits" ]; then
			say "✗ plugins/$PLUGIN 的 frontmatter 里有 Claude Code 不认识的键，会被静默忽略，需要补丁："
			printf '%s\n' "$hits" | sed 's/^/  /' | head -20
			rc=1
		else
			say "✓ plugins/$PLUGIN 的 skill 和 agent frontmatter 都是 Claude Code 认识的键"
		fi
		# spec 只收了上游的一部分 skill。收录的 skill 写着 'Call the Skill tool ... "<名字>"' 时，
		# 被调用的 skill 也必须加载得到：在 skills/<名字>/ 下，或者列在 plugin.json 的 skills 里。
		hits=$(grep -rhoE 'Skill tool[^.]*' --include='*.md' "$OUT" | grep -oE '"[a-z0-9-]+"' | tr -d '"' | sort -u |
			while read -r s; do
				[ -f "$OUT/skills/$s/SKILL.md" ] || grep -qE "\"\./skills/([^\"]*/)?$s\"" "$OUT/.claude-plugin/plugin.json" || echo "$s"
			done || true)
		if [ -n "$hits" ]; then
			say "✗ plugins/$PLUGIN 里的 skill 要调用这些 skill，但插件没有收录：$(echo $hits)"
			rc=1
		else
			say "✓ plugins/$PLUGIN 里的 skill 调用的 skill 都已收录"
		fi
		# spec/flow 同时发布给 Claude Code 和 Cursor：Cursor 清单的 name/version 必须与 Claude 清单一致。
		if [ "$MANIFEST" != .cursor-plugin/plugin.json ] && [ -f "$OUT/.cursor-plugin/plugin.json" ]; then
			hits=
			[ "$(json_get name "$OUT/.cursor-plugin/plugin.json")" = "$PLUGIN" ] || hits="name"
			[ "$(json_get version "$OUT/.cursor-plugin/plugin.json")" = "$(json_get version "$OUT/$MANIFEST")" ] ||
				hits="${hits:+$hits, }version"
			grep -q '"skills"[[:space:]]*:' "$OUT/.cursor-plugin/plugin.json" || hits="${hits:+$hits, }skills"
			# flow 的 Cursor 清单声明自己的 hooks 文件（Cursor 原生事件和协议，不复用 Claude 的 hooks.json）。
			if grep -q '"hooks"[[:space:]]*:' "$OUT/.cursor-plugin/plugin.json"; then
				hooks_rel=$(json_get hooks "$OUT/.cursor-plugin/plugin.json")
				if [ ! -f "$OUT/$hooks_rel" ]; then
					hits="${hits:+$hits, }hooks 文件不存在"
				elif ! jq -e '
					(.version == 1) and
					((.hooks.beforeShellExecution // []) | length == 1) and
					((.hooks.beforeSubmitPrompt // []) | length == 1) and
					((.hooks.stop // []) | length == 1)
				' "$OUT/$hooks_rel" >/dev/null 2>&1; then
					hits="${hits:+$hits, }hooks 事件不完整"
				fi
			fi
			# spec 的两个 manifest 都列了 10 个 skill 路径，增删时不能只改一边。
			if grep -q '"skills"[[:space:]]*:' "$OUT/$MANIFEST"; then
				diff <(grep -o '"\./skills/[^"]*"' "$OUT/$MANIFEST" | sort) \
					<(grep -o '"\./skills/[^"]*"' "$OUT/.cursor-plugin/plugin.json" | sort) >/dev/null ||
					hits="${hits:+$hits, }skills 列表不一致"
			fi
			if [ -n "$hits" ]; then
				say "✗ plugins/$PLUGIN 的 Cursor manifest 不完整：${hits}"
				rc=1
			else
				say "✓ plugins/$PLUGIN 的 Cursor manifest 与 Claude manifest 一致（$(json_get version "$OUT/.cursor-plugin/plugin.json")）"
			fi
		fi
	done
	check_pstack_cursor || rc=1
	# Pi package：根 package.json 的 pi.skills 必须覆盖三个插件的 skill 目录，pi.extensions 指向 flow 的门禁扩展，且都真实存在。
	hits=
	if [ ! -f "$ROOT/package.json" ]; then
		hits="package.json"
	else
		for rel in plugins/pstack/skills plugins/spec/skills plugins/flow/skills; do
			grep -qF "\"./$rel\"" "$ROOT/package.json" || hits="${hits:+$hits, }$rel 未列出"
			[ -d "$ROOT/$rel" ] || hits="${hits:+$hits, }$rel 不存在"
		done
		grep -qF '"./plugins/flow/extensions/pi.ts"' "$ROOT/package.json" ||
			hits="${hits:+$hits, }plugins/flow/extensions/pi.ts 未列出"
		for rel in pi.ts omp.ts common.ts; do
			[ -f "$ROOT/plugins/flow/extensions/$rel" ] || hits="${hits:+$hits, }extensions/$rel 不存在"
		done
	fi
	if [ -n "$hits" ]; then
		say "✗ Pi package manifest 不完整：${hits}"
		rc=1
	else
		say "✓ Pi package manifest 暴露了三个插件的 skills 和 flow 的门禁扩展"
	fi
	check_models || rc=1
	check_locate || rc=1
	check_repo_config || rc=1
	check_doctor || rc=1
	check_install_project || rc=1
	check_codex_manifest || rc=1
	# 阶段门禁对构建产物测。macOS 上用 /bin/bash 跑，确认 hook 在系统自带的 bash 3.2 下也能用。
	if python3 "$ROOT/tests/managed-export.py" >"$WORK/managed-export" 2>&1; then
		say "✓ managed 导出协议测试通过（调查包 + ticket 包 + route 包）"
	else
		say "✗ managed 只读导出协议测试失败："
		cat "$WORK/managed-export"
		rc=1
	fi
	if python3 -I "$ROOT/tests/pi-skill-filter.py" >"$WORK/pi-skill-filter" 2>&1; then
		say "✓ Pi package 的 ~/.agents/skills 去重测试通过（4 项）"
	else
		say "✗ Pi package 的 ~/.agents/skills 去重测试失败："
		cat "$WORK/pi-skill-filter"
		rc=1
	fi
	if python3 -I "$ROOT/tests/tool-policy.py" >"$WORK/tool-policy" 2>&1; then
		say "✓ 工具 profile 导出与原生工具解析测试通过"
	else
		say "✗ 工具 profile 导出或原生工具解析测试失败："
		cat "$WORK/tool-policy"
		rc=1
	fi
	if python3 -I "$ROOT/tests/pi-recommended.py" >"$WORK/pi-recommended" 2>&1; then
		say "✓ Pi 推荐包安装的幂等、dry-run、作用域与配置保护测试通过"
	else
		say "✗ Pi 推荐包安装测试失败："
		cat "$WORK/pi-recommended"
		rc=1
	fi
	if "$([ -x /bin/bash ] && echo /bin/bash || echo bash)" "$ROOT/tests/flow-hooks.sh" >"$WORK/hooks" 2>&1; then
		say "✓ flow 的 stage.sh 和 hooks 测试通过（$(grep -c '^✓' "$WORK/hooks") 项）"
	else
		say "✗ flow 的 stage.sh 和 hooks 测试未通过："
		grep -v '^✓' "$WORK/hooks" | sed 's/^/  /'
		rc=1
	fi
	if command -v claude >/dev/null; then
		claude plugin validate "$ROOT" >"$WORK/validate" 2>&1 || failed=1
		for p in $PLUGINS; do
			claude plugin validate "$ROOT/plugins/$p" >>"$WORK/validate" 2>&1 || failed=1
		done
		if [ -z "$failed" ]; then
			say "✓ claude plugin validate 通过（marketplace 和全部插件）"
		else
			say "✗ claude plugin validate 未通过："
			sed 's/^/  /' "$WORK/validate"
			rc=1
		fi
	else
		say "- 没找到 claude CLI，跳过 manifest 校验"
	fi
	# 评测题自检不调模型：初始状态下 check 必须失败，打上参考解后必须通过。
	if [ -d "$ROOT/evals" ]; then
		if "$ROOT/evals/run.sh" --selftest >"$WORK/selftest" 2>&1; then
			say "✓ evals/tasks 的 $(grep -c '^✓' "$WORK/selftest") 个任务自检通过（初始状态失败，参考解通过）"
		else
			say "✗ evals 自检未通过："
			grep -v '^✓' "$WORK/selftest" | sed 's/^/  /'
			rc=1
		fi
	fi
	if [ -n "$smoke" ]; then
		cmd_smoke all || rc=1
	fi
	return $rc
}

# 模型分层：~/.jstack/config.json 的 models 段是所有 harness 的唯一来源。
# 这里只校验模型 id 的形状，不联网、不调用 magpie；写文件才是 apply 的事。

models_config_path() { printf '%s\n' "${JSTACK_USER_CONFIG:-${JSTACK_MODELS_CONFIG:-$HOME/.jstack/config.json}}"; }
models_legacy_path() { printf '%s\n' "${JSTACK_MODELS_LEGACY:-$HOME/.config/jstack/models.json}"; }

# 模型 id 可以带上下文标记和推理深度后缀：deepseek:max、deepseek[1m]、deepseek[1m]:max。
models_valid_id() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*(\[[A-Za-z0-9]+\])?(:[a-z]+)?$ ]]; }

# 读取用户级配置的 models 段（旧文件里的 harnesses 也认）。用法：
#   models_json <cfg> harnesses
#   models_json <cfg> has <harness>
#   models_json <cfg> get <harness> premium|bulk0|bulk1
#   models_json <cfg> roles <harness>
#   models_json <cfg> budget premium_daily_tokens|premium_concurrency
# 配置缺失时 harnesses 输出空，has 返回 1，budget 输出 null。
models_json() {
	python3 -I - "$@" <<'PY'
import json, re, sys
cfg, op, *rest = sys.argv[1:]
shape = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*(\[[A-Za-z0-9]+\])?(:[a-z]+)?$")
tiers = ("premium", "bulk", "bulk0", "bulk1")
try:
	with open(cfg, encoding="utf-8") as f:
		doc = json.load(f)
except FileNotFoundError:
	doc = {}
except ValueError as error:
	sys.exit(f"{cfg}: 不是合法 JSON：{error}")
if not isinstance(doc, dict):
	sys.exit(f"{cfg}: 顶层必须是对象")
models = doc.get("models")
if models is None:
	models = doc.get("harnesses")
if models is None:
	models = {}
if not isinstance(models, dict):
	sys.exit(f"{cfg}: models 必须是对象")

def harness(name):
	value = models.get(name)
	if value is None:
		return None
	if not isinstance(value, dict):
		sys.exit(f"{cfg}: models.{name} 必须是对象")
	premium = value.get("premium")
	bulk = value.get("bulk")
	if not isinstance(premium, str) or not shape.fullmatch(premium):
		sys.exit(f"{cfg}: models.{name}.premium 不是合法的模型 id：{premium!r}")
	if not isinstance(bulk, list) or len(bulk) != 2 or not all(isinstance(x, str) and shape.fullmatch(x) for x in bulk):
		sys.exit(f"{cfg}: models.{name}.bulk 必须正好是两个合法的模型 id")
	if bulk[0] == bulk[1]:
		sys.exit(f"{cfg}: models.{name}.bulk 的两个模型必须不同")
	return premium, bulk

def role_map(name):
	value = models.get(name)
	if not isinstance(value, dict):
		return {}
	roles = value.get("roles")
	if roles is None:
		return {}
	if not isinstance(roles, dict):
		sys.exit(f"{cfg}: models.{name}.roles 必须是对象")
	out = {}
	for role, choice in roles.items():
		if not isinstance(role, str) or not role.strip():
			sys.exit(f"{cfg}: models.{name}.roles 的键必须是非空字符串")
		items = choice if isinstance(choice, list) else str(choice).split(",")
		values = []
		for item in items:
			item = item.strip() if isinstance(item, str) else ""
			if item not in tiers:
				sys.exit(f"{cfg}: models.{name}.roles.{role} 只能是 premium、bulk、bulk0、bulk1：{choice!r}")
			values.append("bulk0" if item == "bulk" else item)
		if not values:
			sys.exit(f"{cfg}: models.{name}.roles.{role} 不能为空")
		out[role] = values
	return out

if op == "harnesses":
	for name in ("claude-code", "cursor", "omp", "pi"):
		if harness(name) is not None:
			print(name)
elif op == "has":
	sys.exit(0 if harness(rest[0]) is not None else 1)
elif op == "get":
	name, field = rest
	value = harness(name)
	if value is None:
		sys.exit(1)
	premium, bulk = value
	print({"premium": premium, "bulk0": bulk[0], "bulk1": bulk[1]}[field])
elif op == "roles":
	for role, values in role_map(rest[0]).items():
		print(role + "\t" + ",".join(values))
elif op == "budget":
	budget = doc.get("budget")
	if budget is None:
		budget = {}
	if not isinstance(budget, dict):
		sys.exit(f"{cfg}: budget 必须是对象")
	value = budget.get(rest[0])
	if value is None:
		print("null")
	elif isinstance(value, bool) or not isinstance(value, int) or value < 0:
		sys.exit(f"{cfg}: budget.{rest[0]} 必须是非负整数或 null")
	else:
		print(value)
else:
	sys.exit(f"models_json: 未知操作 {op}")
PY
}

