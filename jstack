}

# 模型分层命令的验收：全部在临时 HOME 里跑，不碰真实配置，不联网。
check_models() {
	local h="$WORK/models-home" cfg settings rule usage out n role a b rc=0 backups before after today yesterday
	local cursor_rule omp_rule omp_cfg pi_file h2 h3
	rm -rf "$h"
