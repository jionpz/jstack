models_unlimited() { if [ "$1" = null ]; then printf 'unlimited\n'; else printf '%s\n' "$1"; fi; }

models_budget_line() { # <premium_daily_tokens> <premium_concurrency>
	if [ "$1" = null ] && [ "$2" = null ]; then
		printf '# budget: unlimited\n'
	else
		printf '# budget: premium_daily_tokens=%s, premium_concurrency=%s\n' "$(models_unlimited "$1")" "$(models_unlimited "$2")"
	fi
}

# 角色→层级映射。三个 harness 共用；这里把层级换成别名或真实模型 id。
models_role_lines() { # <harness> <premium> <bulk0> <bulk1> <degraded>
	local h=$1 premium=$2 bulk0=$3 bulk1=$4 degraded=$5 role tiers tier value values
	while IFS='|' read -r role tiers; do
		[ -n "$role" ] || continue
		values=
		for tier in ${tiers//,/ }; do
			case ${h}:${tier} in
			claude-code:premium) value=opus ;;
			claude-code:bulk0) value=sonnet ;;
			claude-code:bulk1) value=haiku ;;
			*:premium) value=$premium ;;
			*:bulk0) value=$bulk0 ;;
			*:bulk1) value=$bulk1 ;;
			esac
			if [ "$degraded" -eq 1 ] && [ "$tier" = premium ]; then
				case $h in
				claude-code) value=sonnet ;;
				*) value=$bulk0 ;;
				esac
			fi
			values="${values:+$values, }$value"
		done
		printf '%s: %s\n' "$role" "$values"
	done <<'EOF'
feature, refactoring|bulk0
bug-fix|bulk0
perf-issue|bulk0
hillclimb|bulk0
judgment and prose|premium
hardest tasks|premium
how explorer|bulk0
how explainer|premium
why investigators|bulk0
why synthesizer|premium
reflect tooling|bulk0
reflect judgment, divergent, synthesizer|premium
arena runners|bulk0,bulk1
arena cross-judge pool|premium,bulk1
swarm workers|bulk0
architect runners|premium,bulk1
interrogate reviewers|bulk0,bulk1
EOF
}

models_rule_content() { # <harness> <premium> <bulk0> <bulk1> <degraded> <cap> <concurrency>
	local h=$1 premium=$2 bulk0=$3 bulk1=$4 degraded=$5 cap=$6 concurrency=$7
	case $h in
	cursor)
		printf -- '---\ndescription: pstack per-role model choices (overrides skill defaults)\nalwaysApply: true\n---\n'
		;;
	omp)
		printf -- '---\nalwaysApply: true\n---\n'
		;;
	esac
	printf '%s\n' '# pstack model configuration, generated by jstack from ~/.config/jstack/models.json. Do not edit; run ./jstack models set instead.'
	case $h in
	claude-code) printf '# opus = premium (%s), sonnet = bulk (%s), haiku = bulk (%s)\n' "$premium" "$bulk0" "$bulk1" ;;
	*) printf '# premium = %s, bulk = %s, %s\n' "$premium" "$bulk0" "$bulk1" ;;
	esac
	[ "$degraded" -eq 0 ] || printf '# premium degraded to %s: daily token cap reached\n' "$bulk0"
	models_budget_line "$cap" "$concurrency"
	if [ "$h" = claude-code ] && [ "$concurrency" != null ]; then
		printf '# premium_concurrency=%s is recorded only; Claude Code has no per-tier concurrency control.\n' "$concurrency"
	fi
	models_role_lines "$@"
}

# 统计某 premium 模型今天的 in + out；magpie 日志不存在时以 3 退出。
models_usage() {
	python3 -I - "$1" "${HOME}/.config/magpie/usage.jsonl" <<'PY'
import datetime, json, os, re, sys
premium, log = sys.argv[1], sys.argv[2]
if not os.path.exists(log):
	sys.exit(3)
name = premium.rsplit("/", 1)[-1]
name = re.sub(r"\[[^]]*\]$", "", name)
name = re.sub(r":[a-z]+$", "", name)
if name.startswith("magpie/"):
	name = name[len("magpie/"):]
today = datetime.date.today().isoformat()
total = 0
with open(log, encoding="utf-8") as f:
	for line in f:
		line = line.strip()
		if not line:
			continue
		try:
			entry = json.loads(line)
		except ValueError:
			continue
		stamp = entry.get("t")
		if not isinstance(stamp, str) or not stamp.startswith(today):
			continue
		if entry.get("model") != name:
			continue
		for key in ("in", "out"):
			value = entry.get(key, 0)
			if isinstance(value, (int, float)) and not isinstance(value, bool):
				total += int(value)
print(total)
PY
