#!/usr/bin/env bash
# jstack：维护并安装 jstack marketplace。Claude Code marketplace 发布三个插件：
#   pstack  原版 pstack 的 Claude Code 版（cursor/plugins 的 harness/pstack/claude-code）
#   spec    Matt Pocock skills 里负责需求澄清和任务拆解的几个（mattpocock/skills），产出交给 pstack 执行
#   flow    jstack 自己写的衔接层（src/flow），按任务大小把 spec 和 pstack 接起来
# 另外构建 Cursor 原生版 pstack（同一个上游的 pstack/ 树），单独放在 plugins/pstack-cursor，不进 Claude marketplace；
# spec 和 flow 同时带 .claude-plugin 和 .cursor-plugin 两个 manifest，Claude Code 和 Cursor 共用同一份产物。
#
#   ./jstack install [--scope user|project|local]  安装全部 Claude Code 插件，已装则刷新
#   ./jstack install-pi                            安装 Pi package，并把 pstack agents 接到 ~/.pi/agent/agents
#   ./jstack install-cursor                        把 pstack、spec、flow 复制到 ~/.cursor/plugins/local/
#                                                  （Cursor 拒绝指向该目录之外的符号链接，所以只复制）
#   ./jstack sync [插件 [ref]]                     拉取上游（不写插件就全部同步，ref 默认 main），然后 build
#   ./jstack build                                 用 upstream/ + patches/（flow 用 src/flow）重建 plugins/
#   ./jstack check [--smoke]                       校验构建产物、锁文件、Cursor 残留、frontmatter、skill 依赖、manifest、Pi package；
#                                                  --smoke 额外跑已安装 harness 的 headless smoke（需要模型和网络）
#   ./jstack smoke [pi|omp|cursor|all]             跑 Pi/OMP/Cursor 的 headless smoke；Cursor 只做加载器和 route 检查
#
# upstream/<插件> 是上游原样副本，plugins/<插件> 是构建产物，两者都不要手改。
# 要改 pstack 或 spec，就在 patches/<插件>/ 下加补丁；flow 没有上游，直接改 src/flow。
set -euo pipefail
# 变量后紧跟中文标点时必须写成 ${VAR}：macOS 的 bash 3.2 在 UTF-8 locale 下会把标点的
# 首字节算进变量名，`$PLUGIN，` 会报 "PLUGIN?: unbound variable"。

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
MARKETPLACE=jstack
PLUGINS="pstack spec flow"
CURSOR_PLUGINS="pstack-cursor"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

die() { printf 'jstack: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
json_get() { sed -n "s/^[[:space:]]*\"$1\":[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$2" | head -1; }

# 切换到插件 $1：设置它的上游仓库、上游路径、只取哪些文件（PICK，空表示整个路径）和本地目录。
use_plugin() {
	PLUGIN=$1 PICK= OWN= MANIFEST=.claude-plugin/plugin.json
	VENDOR="$ROOT/upstream/$PLUGIN"
	LOCK="$ROOT/upstream/$PLUGIN.lock.json"
	case $PLUGIN in
	pstack)
		UPSTREAM_REPO=https://github.com/cursor/plugins.git
		UPSTREAM_PATH=harness/pstack/claude-code
		;;
	pstack-cursor)
		# Cursor 原生 pstack 树。manifest 是 .cursor-plugin/plugin.json，名字仍是 pstack。
		UPSTREAM_REPO=https://github.com/cursor/plugins.git
		UPSTREAM_PATH=pstack
		MANIFEST=.cursor-plugin/plugin.json
		;;
	spec)
		# 只取需求澄清、任务拆解的 5 个 skill（grill-with-docs 到 handoff），加上它们运行时要用的：
		# grilling 到 prototype 由它们通过 Skill 工具调用（check 会核对），setup-matt-pocock-skills
		# 是 to-spec、to-tickets、wayfinder 要求先运行的配置。实现交给 /pstack:poteto-mode，所以不取
		# implement、implement-spec 这类实现编排。增删时同步改 patches/spec/0001 里的 skills 清单。
		UPSTREAM_REPO=https://github.com/mattpocock/skills.git
		UPSTREAM_PATH=.
		PICK="LICENSE
			skills/engineering/grill-with-docs
			skills/engineering/to-spec
			skills/engineering/to-tickets
			skills/engineering/wayfinder
			skills/productivity/handoff
			skills/productivity/grilling
			skills/engineering/domain-modeling
			skills/engineering/research
			skills/engineering/prototype
			skills/engineering/setup-matt-pocock-skills"
		;;
	flow)
		# jstack 自己的插件，没有上游：源码在 src/flow，版本基数取它自己的 plugin.json。
		OWN=1 VENDOR="$ROOT/src/$PLUGIN" LOCK="$ROOT/src/$PLUGIN/.claude-plugin/plugin.json"
		;;
	*) die "没有插件 ${PLUGIN}，可选：$PLUGINS $CURSOR_PLUGINS" ;;
	esac
	PATCHES="$ROOT/patches/$PLUGIN"
	OUT="$ROOT/plugins/$PLUGIN"
}

# 目录 $1 的内容哈希，文件路径和内容都算在内；其余参数是额外的 find 过滤条件。
tree_hash() {
	local dir=$1
	shift
	(cd "$dir" && find . -type f ! -name .DS_Store ! -path '*/node_modules/*' "$@" -print0 |
		LC_ALL=C sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -d' ' -f1)
}

# 列出文件 frontmatter 里不在名单 $1 中的顶层键，每行"文件: 键"。不存在的文件跳过。
fm_unknown_keys() {
	local allow=$1 f
	shift
	for f in "$@"; do
		[ -f "$f" ] || continue
		awk 'NR==1 && $0!="---"{exit} NR>1 && /^---$/{exit} NR>1 && /^[A-Za-z_][A-Za-z0-9_-]*:/{sub(/:.*/,""); print}' "$f" |
			grep -vxE "$allow" | sed "s|^|${f#"$ROOT"/}: |" || true
	done
}

# 把 $1 manifest 里的 version 改成 $2。manifest 可以是 Claude 或 Cursor 方言。
set_manifest_version() {
	local manifest=$1 version=$2
	sed "s/^\([[:space:]]*\"version\":[[:space:]]*\"\)[^\"]*\"/\1$version\"/" "$manifest" >"$manifest.tmp"
	mv "$manifest.tmp" "$manifest"
}

# 把 upstream/ 加补丁构建到 $1。版本号写成 <上游版本>+jstack.<内容哈希>：
# 内容一变版本就变，从 GitHub 安装的机器才收得到更新。上游版本取自锁文件，
# 因为 spec 不收上游的 plugin.json，它的 manifest 由补丁新建。
build_into() {
	local dest=$1 patch manifest version hash
	version=$(json_get version "$LOCK" 2>/dev/null || true)
	[ -d "$VENDOR" ] && [ -n "$version" ] || die "缺少 ${VENDOR#"$ROOT"/} 或它的版本号$([ -n "$OWN" ] || echo "，先运行 ./jstack sync $PLUGIN")"
	mkdir -p "$dest"
	rsync -a --delete --exclude node_modules "$VENDOR/" "$dest/"
	for patch in "$PATCHES"/*.patch; do
		[ -e "$patch" ] || continue
		(cd "$dest" && git apply --check "$patch" 2>/dev/null && git apply "$patch") ||
			die "补丁 $(basename "$patch") 打不上，说明上游改了这段。对照 upstream/$PLUGIN 重做这个补丁；如果上游已经修好，就删掉它。"
	done
	manifest="$dest/$MANIFEST"
	[ -f "$manifest" ] || die "upstream/$PLUGIN 里没有 $MANIFEST，patches/$PLUGIN 也没有新建它"
	# 两个 manifest 都排除在哈希外，否则版本号会自我递归。spec/flow 同时带 Claude 和 Cursor 清单。
	hash=$(tree_hash "$dest" ! -path "./.claude-plugin/plugin.json" ! -path "./.cursor-plugin/plugin.json" | cut -c1-7)
	set_manifest_version "$manifest" "$version+jstack.$hash"
	if [ "$MANIFEST" != .cursor-plugin/plugin.json ] && [ -f "$dest/.cursor-plugin/plugin.json" ]; then
		set_manifest_version "$dest/.cursor-plugin/plugin.json" "$version+jstack.$hash"
	fi
	[ "$(json_get version "$manifest")" = "$version+jstack.$hash" ] || die "$PLUGIN 的 plugin.json 里没有 version"
}

build_plugin() {
	local patches
	build_into "$WORK/build/$PLUGIN"
	mkdir -p "$OUT"
	# 插件从这里原地加载，只改动内容变了的文件；node_modules 是 bun 在运行时装的，保留。
	rsync -rlpc --delete --exclude node_modules "$WORK/build/$PLUGIN/" "$OUT/"
	patches=("$PATCHES"/*.patch)
	[ -e "${patches[0]}" ] || patches=()
	say "✓ 已构建 plugins/${PLUGIN}，版本 $(json_get version "$OUT/$MANIFEST")，打了 ${#patches[@]} 个补丁"
}

cmd_build() {
	local p
	for p in $PLUGINS $CURSOR_PLUGINS; do
		use_plugin "$p"
		build_plugin
	done
}

sync_plugin() {
	local ref=$1 src="$WORK/upstream-$PLUGIN" stage="$WORK/pick-$PLUGIN" sha version changed path
	say "拉取 $UPSTREAM_REPO @ $ref ..."
	git init -q "$src"
	git -C "$src" remote add origin "$UPSTREAM_REPO"
	[ "$UPSTREAM_PATH" = . ] || git -C "$src" sparse-checkout set "$UPSTREAM_PATH"
	git -C "$src" fetch -q --depth 1 --filter=blob:none origin "$ref"
	git -C "$src" -c advice.detachedHead=false checkout -q FETCH_HEAD
	sha=$(git -C "$src" rev-parse HEAD)
	src="$src/$UPSTREAM_PATH"
	[ -f "$src/$MANIFEST" ] ||
		die "上游 ${sha:0:7} 里没有 $UPSTREAM_PATH/$MANIFEST，可能上游改了目录结构"
	version=$(json_get version "$src/$MANIFEST")
	if [ -n "$PICK" ]; then
		# 只取 PICK 列出的文件和目录，保留它们在上游的相对路径。
		for path in $PICK; do
			[ -e "$src/$path" ] || die "上游 ${sha:0:7} 里没有 ${path}，可能被改名或删掉了"
			mkdir -p "$stage/$(dirname "$path")"
			cp -R "$src/$path" "$stage/$(dirname "$path")/"
		done
		src=$stage
	fi
	mkdir -p "$VENDOR"
	# 按内容比对（-c），不同步 mtime：新 clone 的文件时间都是当前时间，按时间比会把每个文件都算成变化。
	# macOS 自带的 openrsync 仍会把每个文件列成 ".f..T...."（只是时间不同），计数时要排除这种行。
	changed=$(rsync -rlpci --delete "$src/" "$VENDOR/" | grep -cvE '^\.[^ ]\.\.[tT]\.* ' || true)
	cat >"$LOCK" <<EOF
{
  "repo": "$UPSTREAM_REPO",
  "path": "$UPSTREAM_PATH",
  "ref": "$ref",
  "sha": "$sha",
  "version": "$version",
  "tree": "$(tree_hash "$VENDOR")",
  "synced": "$(date -u +%Y-%m-%d)"
}
EOF
	if [ "$changed" = 0 ]; then
		say "上游 $PLUGIN 没有变化（$version @ ${sha:0:7}）"
	else
		printf '| %s | %s | %s | `%s` | %s 处文件变化 |\n' "$(date -u +%Y-%m-%d)" "$PLUGIN" "$version" "${sha:0:7}" "$changed" >>"$ROOT/SYNC-LOG.md"
		say "上游 $PLUGIN 有 $changed 处文件变化（$version @ ${sha:0:7}），已记入 SYNC-LOG.md"
	fi
	build_plugin
}

cmd_sync() {
	local p
	[ $# -le 2 ] || die "用法：./jstack sync [插件 [ref]]"
	for p in ${1:-$PLUGINS $CURSOR_PLUGINS}; do
		use_plugin "$p"
		[ -z "$OWN" ] || { [ -z "${1:-}" ] || die "$p 没有上游，直接改 src/$p"; continue; }
		sync_plugin "${2:-main}"
	done
}

# 跑一条 headless 命令，把完整 JSON 留在 $2，失败时打印 stderr 末尾。
smoke_run() {
	local label=$1 out=$2
	shift 2
	if "$@" >"$out" 2>"$out.err"; then
		return 0
	fi
	say "✗ $label 运行失败"
	tail -10 "$out.err" | sed 's/^/  /'
	return 1
}

smoke_pi() {
	command -v pi >/dev/null || { say "- 没找到 Pi CLI，跳过 Pi smoke"; return 0; }
	local dir="$WORK/smoke/pi" out skills s rc=0 bad=0 prompt
	mkdir -p "$dir"
	# 1. 系统提示里的 skill 目录：pstack 的 setup-pstack、spec 的 grilling、flow 的 route。
	out="$dir/catalog.jsonl"
	smoke_run "Pi skill catalog" "$out" pi -p --no-session --no-context-files --mode json "List the names of skills available to you that are named setup-pstack, grilling, or route, then stop." || return 1
	skills=$(jq -r 'select(.type=="message_end" and .message.role=="system") | .message.sections.skills // empty' "$out")
	for s in setup-pstack grilling route; do
		if ! grep -q "<name>$s</name>" <<<"$skills"; then
			say "✗ Pi skill catalog 缺少 $s"
			rc=1 bad=1
		fi
	done
	[ "$bad" -eq 0 ] && say "✓ Pi: 系统提示包含 pstack/spec/flow 的 skills"
	# 2. 隐藏入口：pstack 的入口 skill 都是 disable-model-invocation，用 /skill: 显式加载。
	out="$dir/hidden.jsonl"
	if smoke_run "Pi /skill:poteto-mode" "$out" pi -p --no-session --no-context-files --no-tools --mode json "/skill:poteto-mode 只回复 PI-SKILL-OK 并停止。"; then
		if grep -q 'poteto-mode/SKILL.md' "$out" && grep -q 'PI-SKILL-OK' "$out"; then
			say "✓ Pi: /skill:poteto-mode 加载了隐藏入口"
		else
			say "✗ Pi: /skill:poteto-mode 没有加载或没有返回标记"
			rc=1
		fi
	else
		rc=1
	fi
	# 3. route 在 Pi 安装树下运行 locate.sh。
	out="$dir/route.jsonl"
	if smoke_run "Pi /skill:route" "$out" pi -p --no-session --no-context-files --mode json "/skill:route 只运行 locate.sh 并列出 7 个入口名字，然后停止。"; then
		skills=$(jq -r 'select(.type=="tool_execution_end" and .toolName=="bash") | .result.content[]?.text' "$out" 2>/dev/null || true)
		bad=0
		for s in poteto-mode setup-matt-pocock-skills grill-with-docs to-spec to-tickets wayfinder handoff; do
			if ! grep -q -- "$s" <<<"$skills"; then
				say "✗ Pi route 输出缺少 $s"
				rc=1 bad=1
			fi
		done
		[ "$bad" -eq 0 ] && say "✓ Pi: route 定位到 7 个入口"
	else
		rc=1
	fi
	# 4. pstack 的 poteto-agent 后台派发。
	out="$dir/subagent.jsonl"
	prompt="Use the Agent tool exactly once with subagent_type \"poteto-agent\", description \"smoke\", prompt \"Read $ROOT/README.md and reply with its first line. Do not edit files.\" Then call get_subagent_result with wait true and report the result. Stop."
	if smoke_run "Pi poteto-agent" "$out" pi -p --no-session --no-context-files --mode json "$prompt"; then
		if jq -r 'select(.type=="tool_execution_start" and .toolName=="Agent") | .args.subagent_type // empty' "$out" | grep -qx poteto-agent &&
			jq -r 'select(.type=="tool_execution_end" and .toolName=="get_subagent_result") | .result.content[]?.text // empty' "$out" | grep -q 'completed'; then
			say "✓ Pi: poteto-agent 后台派发并返回结果"
		else
			say "✗ Pi: 没有看到 poteto-agent 或 get_subagent_result 结果"
			rc=1
		fi
	else
		rc=1
	fi
	return $rc
}

smoke_omp() {
	command -v omp >/dev/null || { say "- 没找到 OMP CLI，跳过 OMP smoke"; return 0; }
	if ! omp plugin list 2>/dev/null | grep -q 'pstack@jstack'; then
		say "- OMP 没有安装 jstack 插件，跳过 OMP smoke（先 omp plugin marketplace add jionpz/jstack && omp plugin install pstack@jstack spec@jstack flow@jstack）"
		return 0
	fi
	local dir="$WORK/smoke/omp" out text pstack_dir flow_dir s rc=0 bad=0 prompt
	mkdir -p "$dir"
	pstack_dir=$(ls -dt "$HOME/.omp/plugins/cache/plugins"/jstack___pstack___* 2>/dev/null | head -1 || true)
	flow_dir=$(ls -dt "$HOME/.omp/plugins/cache/plugins"/jstack___flow___* 2>/dev/null | head -1 || true)
	# 1. 三个插件的 skill URI。
	out="$dir/skills.jsonl"
	if smoke_run "OMP skill URIs" "$out" omp -p --no-session --mode json --auto-approve --tools=read "Read these three skill URIs with the read tool and report their paths, then stop: skill://setup-pstack, skill://grilling, skill://route"; then
		text=$(jq -r 'select(.type=="tool_execution_end" and .toolName=="read") | .result.content[]?.text // empty' "$out" 2>/dev/null || true)
		bad=0
		for s in jstack___pstack___ jstack___spec___ jstack___flow___; do
			if ! grep -q "$s" <<<"$text"; then
				say "✗ OMP skill URI 没有解析到 $s"
				rc=1 bad=1
			fi
		done
		[ "$bad" -eq 0 ] && say "✓ OMP: pstack/spec/flow 的 skills 都能加载"
	else
		rc=1
	fi
	# 2. 隐藏入口按绝对路径读。
	out="$dir/hidden.jsonl"
	if [ -n "$pstack_dir" ] && smoke_run "OMP poteto-mode" "$out" omp -p --no-session --mode json --auto-approve --tools=read "Read the first five lines of $pstack_dir/skills/poteto-mode/SKILL.md and report the name field, then stop."; then
		text=$(jq -r 'select(.type=="tool_execution_end" and .toolName=="read") | .result.content[]?.text // empty' "$out" 2>/dev/null || true)
		if grep -q 'name: poteto-mode' <<<"$text"; then
			say "✓ OMP: 隐藏入口可按路径读取"
		else
			say "✗ OMP: 没有读到 poteto-mode 的 frontmatter"
			rc=1
		fi
	elif [ -z "$pstack_dir" ]; then
		say "✗ OMP: 找不到 pstack 插件缓存"
		rc=1
	fi
	# 3. route 在 OMP 缓存布局下运行 locate.sh。
	out="$dir/route.jsonl"
	if [ -n "$flow_dir" ] && smoke_run "OMP route" "$out" omp -p --no-session --mode json --auto-approve --tools=bash "Run bash $flow_dir/skills/route/locate.sh and list the seven entry names it prints, then stop."; then
		text=$(jq -r 'select(.type=="tool_execution_end" and .toolName=="bash") | .result.content[]?.text // empty' "$out" 2>/dev/null || true)
		bad=0
		for s in poteto-mode setup-matt-pocock-skills grill-with-docs to-spec to-tickets wayfinder handoff; do
			if ! grep -q -- "$s" <<<"$text"; then
				say "✗ OMP route 输出缺少 $s"
				rc=1 bad=1
			fi
		done
		[ "$bad" -eq 0 ] && say "✓ OMP: route 定位到 7 个入口"
	elif [ -z "$flow_dir" ]; then
		say "✗ OMP: 找不到 flow 插件缓存"
		rc=1
	fi
	# 4. poteto-agent 通过 task 工具派发。
	out="$dir/subagent.jsonl"
	prompt="Use the task tool exactly once with agent \"poteto-agent\", name \"SmokeRead\", and task \"Read $ROOT/plugins/pstack/skills/poteto-mode/SKILL.md in full first, then read the first line of $ROOT/README.md and reply with exactly that line. Do not modify any files.\" Then report the result and stop."
	if smoke_run "OMP poteto-agent" "$out" omp -p --no-session --mode json --auto-approve --tools=task "$prompt"; then
		if jq -r 'select(.type=="tool_execution_start" and .toolName=="task") | .args.tasks[]?.agent // empty' "$out" | grep -qx poteto-agent &&
			jq -r 'select(.type=="message_end" and .message.role=="assistant") | .message.content[]?.text // empty' "$out" | grep -q '# jstack'; then
			say "✓ OMP: poteto-agent 通过 task 派发并返回结果"
		else
			say "✗ OMP: 没有看到 poteto-agent 或 # jstack 结果"
			rc=1
		fi
	else
		rc=1
	fi
	return $rc
}

smoke_cursor() {
	local loader=/Applications/Cursor.app/Contents/Resources/app/molten/dist/engine/plugins-loader.cjs
	local root="$HOME/.cursor/plugins/local" out
	[ -f "$loader" ] || { say "- 没找到 Cursor 插件加载器，跳过 Cursor smoke"; return 0; }
	[ -f "$root/flow/.cursor-plugin/plugin.json" ] || {
		say "- Cursor 本地插件未安装，跳过 Cursor smoke（先 ./jstack install-cursor）"
		return 0
	}
	out="$WORK/smoke/cursor-loader.txt"
	if ! node - "$HOME" "$loader" >"$out" 2>"$out.err" <<'JS'; then
const home = process.argv[2];
const loader = process.argv[3];
const { loadPlugins } = require(loader);
(async () => {
  const r = await loadPlugins({roots:[process.cwd()], home, backend:null, userLocal:true, projectSettings:undefined});
  const by = new Map(r.plugins.map(p => [p.identifier?.sourceInfo?.name, p]));
  const names = [...by.keys()].sort().join(',');
  if (r.failures.length || names !== 'flow,pstack,spec') {
    console.error(`Cursor loader: plugins=${names} failures=${r.failures.length}`);
    process.exit(1);
  }
  const has = (plugin, list, name) => (by.get(plugin)?.[list] || []).some(x => x.name === name);
  if (!has('flow', 'skills', 'route') || !has('pstack', 'skills', 'poteto-mode') ||
      !has('spec', 'skills', 'grill-with-docs') || !has('pstack', 'agents', 'poteto-agent')) {
    console.error('Cursor loader: 缺少 route / poteto-mode / grill-with-docs / poteto-agent');
    process.exit(1);
  }
  console.log(`plugins=${names} flow.skills=${by.get('flow').skills.length} pstack.skills=${by.get('pstack').skills.length} pstack.agents=${by.get('pstack').agents.length} spec.skills=${by.get('spec').skills.length}`);
})();
JS
		say "✗ Cursor 插件加载器失败"
		tail -10 "$out.err" | sed 's/^/  /'
		return 1
	fi
	say "✓ Cursor: $(cat "$out")"
	out="$WORK/smoke/cursor-route.txt"
	if bash "$root/flow/skills/route/locate.sh" >"$out" 2>"$out.err"; then
		if [ "$(wc -l <"$out" | tr -d ' ')" -eq 7 ]; then
			say "✓ Cursor: route 在 Cursor 布局下定位到 7 个入口"
		else
			say "✗ Cursor: route 没有返回 7 个入口"
			return 1
		fi
	else
		say "✗ Cursor: locate.sh 运行失败"
		tail -10 "$out.err" | sed 's/^/  /'
		return 1
	fi
	say "- Cursor 的交互部分（/route、澄清轮、subagent 面板）按 docs/testing/cursor.md 手动验证"
}

cmd_smoke() {
	local which=${1:-all} rc=0
	command -v jq >/dev/null || die "smoke 需要 jq"
	mkdir -p "$WORK/smoke"
	case $which in
	all)
		smoke_pi || rc=1
		smoke_omp || rc=1
		smoke_cursor || rc=1
		;;
	pi) smoke_pi || rc=1 ;;
	omp) smoke_omp || rc=1 ;;
	cursor) smoke_cursor || rc=1 ;;
	*) die "用法：./jstack smoke [pi|omp|cursor|all]" ;;
	esac
	[ "$rc" -eq 0 ] && say "✓ smoke 通过" || say "✗ smoke 未通过"
	return $rc
}

cmd_check() {
	local rc=0 p hits failed= smoke=
	while [ $# -gt 0 ]; do
		case $1 in
		--smoke) smoke=1; shift ;;
		*) die "未知参数：$1（可用 --smoke）" ;;
		esac
	done
	for p in $PLUGINS $CURSOR_PLUGINS; do
		use_plugin "$p"
		build_into "$WORK/check/$p"
		if diff -rq -x node_modules "$WORK/check/$p" "$OUT" >"$WORK/diff" 2>&1 &&
			diff <(cd "$WORK/check/$p" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) \
				<(cd "$OUT" && find . -type f -perm -u+x ! -path '*/node_modules/*' | sort) >/dev/null; then
			say "✓ plugins/$PLUGIN 与 upstream/ 加 patches/ 的构建结果一致（$(json_get version "$OUT/$MANIFEST")）"
		else
			say "✗ plugins/$PLUGIN 与构建结果不一致：可能被手改过，或改了补丁后没有运行 ./jstack build"
			sed 's/^/  /' "$WORK/diff" | head -20
			rc=1
		fi
		# 锁文件记着 sync 写入时副本的内容哈希。对不上，说明副本被手改过，或者不是用 sync 更新的。
		if [ -n "$OWN" ]; then
			say "- $PLUGIN 没有上游，跳过锁文件校验"
		elif [ "$(json_get tree "$LOCK")" = "$(tree_hash "$VENDOR")" ]; then
			say "✓ upstream/$PLUGIN 与锁文件一致（$(json_get version "$LOCK") @ $(json_get sha "$LOCK" | cut -c1-7)）"
		else
			say "✗ upstream/$PLUGIN 与 upstream/$PLUGIN.lock.json 记录的内容对不上：副本只能由 ./jstack sync 写入"
			rc=1
		fi
		if [ "$PLUGIN" = pstack-cursor ]; then
			# Cursor 原生产物：manifest 用 .cursor-plugin，frontmatter 和脚本按 Cursor 约定，不做 Claude Code 检查。
			hits=
			[ -f "$OUT/.cursor-plugin/plugin.json" ] || hits="${hits:+$hits, }manifest"
			[ "$(json_get name "$OUT/.cursor-plugin/plugin.json" 2>/dev/null || true)" = pstack ] || hits="${hits:+$hits, }name"
			[ -f "$OUT/skills/poteto-mode/SKILL.md" ] || hits="${hits:+$hits, }skills"
			[ -f "$OUT/agents/poteto-agent.md" ] || hits="${hits:+$hits, }agents"
			if [ -n "$hits" ]; then
				say "✗ plugins/$PLUGIN 不是完整的 Cursor pstack 产物：缺少 ${hits}。"
				rc=1
			else
				say "✓ plugins/$PLUGIN 是 Cursor 插件 pstack（$(json_get version "$OUT/.cursor-plugin/plugin.json")），skills 和 agents 齐全"
			fi
			continue
		fi
		# 上游 adapter 只翻译 Markdown 里的 Cursor 名称，脚本里写死的 Cursor 路径要靠补丁修。
		if hits=$(grep -rnIE '(\$HOME|~)/\.cursor/|agent-transcripts' --exclude='*.md' --exclude-dir=node_modules "$OUT"); then
			say "✗ plugins/$PLUGIN 的脚本里还有写死的 Cursor 路径，需要补丁："
			printf '%s\n' "$hits" | sed "s|$ROOT/||; s/^/  /" | head -20
			rc=1
		else
			say "✓ plugins/$PLUGIN 的脚本里没有写死的 Cursor 路径"
		fi
		# frontmatter 由 Claude Code 自己解析，也不经过 adapter。不认识的键会被静默忽略，claude plugin validate
		# 也不报，例如 Cursor 的 is_background。名单取自 https://code.claude.com/docs/en/claude-directory，
		# 插件 agent 会忽略的 permissionMode、hooks、mcpServers、initialPrompt 不在名单里。
		# skill 名单多放了 icon 和 color：它们是 Cursor 界面用的，Claude Code 忽略了也不影响行为。
		# pstack 的 skill 在 skills/<名字>/，spec 沿用上游的 skills/<分类>/<名字>/。
		hits=$(
			fm_unknown_keys 'name|description|when_to_use|argument-hint|arguments|disable-model-invocation|user-invocable|allowed-tools|disallowed-tools|model|effort|context|agent|background|hooks|paths|shell|metadata|license|compatibility|icon|color' \
				"$OUT"/skills/*/SKILL.md "$OUT"/skills/*/*/SKILL.md
			fm_unknown_keys 'name|description|tools|disallowedTools|model|maxTurns|autoCompactWindow|skills|memory|background|effort|isolation|color|omitClaudeMd|experimental' \
				"$OUT"/agents/*.md
		)
		if [ -n "$hits" ]; then
			say "✗ plugins/$PLUGIN 的 frontmatter 里有 Claude Code 不认识的键，会被静默忽略，需要补丁："
			printf '%s\n' "$hits" | sed 's/^/  /' | head -20
			rc=1
		else
			say "✓ plugins/$PLUGIN 的 skill 和 agent frontmatter 都是 Claude Code 认识的键"
		fi
		# spec 只收了上游的一部分 skill。收录的 skill 写着 'Call the Skill tool ... "<名字>"' 时，
		# 被调用的 skill 也必须加载得到：在 skills/<名字>/ 下，或者列在 plugin.json 的 skills 里。
		hits=$(grep -rhoE 'Skill tool[^.]*' --include='*.md' "$OUT" | grep -oE '"[a-z0-9-]+"' | tr -d '"' | sort -u |
			while read -r s; do
				[ -f "$OUT/skills/$s/SKILL.md" ] || grep -qE "\"\./skills/([^\"]*/)?$s\"" "$OUT/.claude-plugin/plugin.json" || echo "$s"
			done || true)
		if [ -n "$hits" ]; then
			say "✗ plugins/$PLUGIN 里的 skill 要调用这些 skill，但插件没有收录：$(echo $hits)"
			rc=1
		else
			say "✓ plugins/$PLUGIN 里的 skill 调用的 skill 都已收录"
		fi
		# spec/flow 同时发布给 Claude Code 和 Cursor：Cursor 清单的 name/version 必须与 Claude 清单一致。
		if [ "$MANIFEST" != .cursor-plugin/plugin.json ] && [ -f "$OUT/.cursor-plugin/plugin.json" ]; then
			hits=
			[ "$(json_get name "$OUT/.cursor-plugin/plugin.json")" = "$PLUGIN" ] || hits="name"
			[ "$(json_get version "$OUT/.cursor-plugin/plugin.json")" = "$(json_get version "$OUT/$MANIFEST")" ] ||
				hits="${hits:+$hits, }version"
			grep -q '"skills"[[:space:]]*:' "$OUT/.cursor-plugin/plugin.json" || hits="${hits:+$hits, }skills"
			# spec 的两个 manifest 都列了 10 个 skill 路径，增删时不能只改一边。
			if grep -q '"skills"[[:space:]]*:' "$OUT/$MANIFEST"; then
				diff <(grep -o '"\./skills/[^"]*"' "$OUT/$MANIFEST" | sort) \
					<(grep -o '"\./skills/[^"]*"' "$OUT/.cursor-plugin/plugin.json" | sort) >/dev/null ||
					hits="${hits:+$hits, }skills 列表不一致"
			fi
			if [ -n "$hits" ]; then
				say "✗ plugins/$PLUGIN 的 Cursor manifest 不完整：${hits}"
				rc=1
			else
				say "✓ plugins/$PLUGIN 的 Cursor manifest 与 Claude manifest 一致（$(json_get version "$OUT/.cursor-plugin/plugin.json")）"
			fi
		fi
	done
	# Pi package：根 package.json 的 pi.skills 必须覆盖三个插件的 skill 目录，且目录真实存在。
	hits=
	if [ ! -f "$ROOT/package.json" ]; then
		hits="package.json"
	else
		for rel in plugins/pstack/skills plugins/spec/skills plugins/flow/skills; do
			grep -qF "\"./$rel\"" "$ROOT/package.json" || hits="${hits:+$hits, }$rel 未列出"
			[ -d "$ROOT/$rel" ] || hits="${hits:+$hits, }$rel 不存在"
		done
	fi
	if [ -n "$hits" ]; then
		say "✗ Pi package manifest 不完整：${hits}"
		rc=1
	else
		say "✓ Pi package manifest 暴露了 pstack、spec、flow 三个插件的 skills"
	fi
	if command -v claude >/dev/null; then
		claude plugin validate "$ROOT" >"$WORK/validate" 2>&1 || failed=1
		for p in $PLUGINS; do
			claude plugin validate "$ROOT/plugins/$p" >>"$WORK/validate" 2>&1 || failed=1
		done
		if [ -z "$failed" ]; then
			say "✓ claude plugin validate 通过（marketplace 和全部插件）"
		else
			say "✗ claude plugin validate 未通过："
			sed 's/^/  /' "$WORK/validate"
			rc=1
		fi
	else
		say "- 没找到 claude CLI，跳过 manifest 校验"
	fi
	if [ -n "$smoke" ]; then
		cmd_smoke all || rc=1
	fi
	return $rc
}

cmd_install() {
	local scope=user p conflicts tool installed markets
	while [ $# -gt 0 ]; do
		case $1 in
		--scope) scope=${2:?--scope 后面要跟 user、project 或 local}; shift 2 ;;
		--scope=*) scope=${1#*=}; shift ;;
		*) die "未知参数：$1" ;;
		esac
	done
	command -v claude >/dev/null || die "需要 Claude Code CLI（claude）"
	for p in $PLUGINS; do
		[ -f "$ROOT/plugins/$p/.claude-plugin/plugin.json" ] || { cmd_build; break; }
	done
	# 先存进变量再 grep：直接用管道接 grep -q，grep 提前退出会让 claude 收到 SIGPIPE，在 pipefail 下误判。
	installed=$(claude plugin list --json 2>/dev/null || true)
	markets=$(claude plugin marketplace list --json 2>/dev/null || true)
	# 别的 marketplace 里的同名插件命令前缀相同，同时装会冲突，例如所有 pstack 移植版都是 /pstack:*。
	# mattpocock-skills 是 Matt 的完整版：skill 和 spec 重复，还带 implement 编排，会和 poteto-mode 抢主编排。
	conflicts=$(grep -oE "\"id\": *\"($(tr ' ' '|' <<<"$PLUGINS")|mattpocock-skills)@[^\"]*\"" <<<"$installed" |
		sed 's/.*"\([^"]*\)"$/\1/' | grep -v "@$MARKETPLACE\$" || true)
	[ -z "$conflicts" ] || die "已经装了 $(echo $conflicts)，和 jstack 的插件冲突：同名插件的命令前缀相同；mattpocock-skills 的 skill 和 spec 重复，还带 implement 编排。先卸载：$(printf '\n  claude plugin uninstall %s' $conflicts)"
	if grep -q "\"name\": *\"$MARKETPLACE\"" <<<"$markets"; then
		claude plugin marketplace update "$MARKETPLACE"
	else
		claude plugin marketplace add "$ROOT" --scope "$scope"
	fi
	for p in $PLUGINS; do
		if grep -q "\"id\": *\"$p@$MARKETPLACE\"" <<<"$installed"; then
			claude plugin enable "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			# 本地 marketplace 的插件本来就从源目录加载；update 让 claude plugin list 里记的版本号跟上，
			# marketplace 来自 GitHub 时则真正拉取新版本。
			claude plugin update "$p@$MARKETPLACE" --scope "$scope" >/dev/null 2>&1 || true
			say "✓ $p@$MARKETPLACE 已是最新，重开会话或运行 /reload-plugins 生效。"
		else
			claude plugin install "$p@$MARKETPLACE" --scope "$scope"
		fi
	done
	for tool in bun gh rg jq; do
		command -v "$tool" >/dev/null || case $tool in
			bun) say "! 没找到 bun：poteto-mode 的 watch-pr 和 statechart 脚本要用它" ;;
			gh) say "! 没找到 gh：开 PR、看 CI 的流程要用它" ;;
			rg) say "! 没找到 rg：搜索代码和 worktree-audit 要用它" ;;
			jq) say "! 没找到 jq：worktree-audit 要用它" ;;
			esac
	done
	cat <<'EOF'

接下来在 Claude Code 里：
  1. 运行 /reload-plugins，或新开一个会话
  2. 运行 /pstack:setup-pstack，写入模型角色表 ~/.claude/rules/pstack-models.md（只需一次）
  3. 在要用 spec 的仓库里运行一次 /spec:setup-matt-pocock-skills，选定 issue tracker 和领域文档的位置
  4. 运行 /pstack:poteto-mode <任务描述> 开始工作。需求不清或任务较大时，先用 /spec:grill-with-docs、
     /spec:to-spec、/spec:to-tickets 澄清和拆解，再把 spec 或 ticket 交给 poteto-mode
EOF
}

cmd_install_cursor() {
	local target_root="$HOME/.cursor/plugins/local" name src target missing= link
	while [ $# -gt 0 ]; do
		case $1 in
		--copy) shift ;;
		--link) die "Cursor 的 user-local 插件加载器拒绝指向 ~/.cursor/plugins/local 之外的符号链接；install-cursor 只支持复制，去掉 --link 再运行" ;;
		*) die "未知参数：$1（install-cursor 默认复制，--copy 可省略）" ;;
		esac
	done
	# pstack 用 Cursor 原生树；spec 和 flow 用带双 manifest 的同一份产物。
	for name in pstack spec flow; do
		case $name in
		pstack) src="$ROOT/plugins/pstack-cursor" ;;
		*) src="$ROOT/plugins/$name" ;;
		esac
		[ -f "$src/.cursor-plugin/plugin.json" ] || missing=1
	done
	[ -z "$missing" ] || cmd_build
	mkdir -p "$target_root"
	for name in pstack spec flow; do
		case $name in
		pstack) src="$ROOT/plugins/pstack-cursor" ;;
		*) src="$ROOT/plugins/$name" ;;
		esac
		[ -f "$src/.cursor-plugin/plugin.json" ] ||
			die "构建后仍没有 ${src#"$ROOT"/}/.cursor-plugin/plugin.json"
		target="$target_root/$name"
		if [ -e "$target" ] || [ -L "$target" ]; then
			if [ -f "$target/.cursor-plugin/plugin.json" ] &&
				[ "$(json_get name "$target/.cursor-plugin/plugin.json")" = "$name" ]; then
				:
			else
				die "$target 已存在且不是 $name Cursor 插件，先备份或移走再装"
			fi
		fi
		# 旧版 install-cursor 建过指向仓库的符号链接；Cursor 会拒绝它，这里自动换成副本。
		if [ -L "$target" ]; then
			link=$(readlink "$target")
			case $link in
			"$ROOT"/plugins/*) rm "$target" ;;
			*) die "$target 是指向 $link 的符号链接，不是 jstack 的构建产物；先移走再装" ;;
			esac
		fi
		mkdir -p "$target"
		rsync -a --delete "$src/" "$target/"
		say "✓ 已复制 Cursor $name 到 $target"
	done
	say "在 Cursor 里重开窗口或运行 /reload；用 /poteto-mode、/route 验证。"
}

cmd_install_pi() {
	local agents="$HOME/.pi/agent/agents" src spec
	command -v pi >/dev/null || die "需要 Pi CLI（pi）"
	[ -f "$ROOT/package.json" ] || die "缺少 package.json（Pi package manifest）"
	for spec in poteto-agent comment-sicko; do
		src="$ROOT/plugins/pstack/agents/$spec.md"
		[ -f "$src" ] || die "缺少 $src，先运行 ./jstack build"
		if [ -e "$agents/$spec.md" ] && ! grep -q 'generated by jstack install-pi' "$agents/$spec.md"; then
			die "$agents/$spec.md 已存在且不是 jstack 生成的；先备份或移走"
		fi
	done
	pi install "$ROOT" --approve
	mkdir -p "$agents"
	# Pi 的后台字段是 run_in_background，不是 Claude Code 的 background；装的时候转换。
	sed 's/^background: true$/run_in_background: true/' "$ROOT/plugins/pstack/agents/poteto-agent.md" |
		awk 'BEGIN{fm=0} /^---$/{fm++; print; if(fm==2) print "\n<!-- generated by jstack install-pi; source: plugins/pstack/agents/poteto-agent.md -->"; next} {print}' >"$agents/poteto-agent.md"
	awk 'BEGIN{fm=0} /^---$/{fm++; print; if(fm==2) print "\n<!-- generated by jstack install-pi; source: plugins/pstack/agents/comment-sicko.md -->"; next} {print}' \
		"$ROOT/plugins/pstack/agents/comment-sicko.md" >"$agents/comment-sicko.md"
	grep -q '^run_in_background: true$' "$agents/poteto-agent.md" ||
		die "poteto-agent 的 background 字段没有转成 run_in_background，检查上游 frontmatter"
	say "✓ 已安装 Pi package 和 pstack agents 到 $agents"
	say "重开 Pi 会话；用 /skill:poteto-mode 验证。"
	if ! pi list 2>/dev/null | grep -q 'pi-subagents'; then
		say "! 没找到 @tintinweb/pi-subagents：pstack 的子 agent 需要它，先运行 pi install npm:@tintinweb/pi-subagents"
	fi
}

case "${1:-}" in
install) shift; cmd_install "$@" ;;
install-pi) cmd_install_pi ;;
install-cursor) shift; cmd_install_cursor "$@" ;;
sync) shift; cmd_sync "$@" ;;
build) cmd_build ;;
check) shift; cmd_check "$@" ;;
smoke) shift; cmd_smoke "$@" ;;
"" | -h | --help | help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
*) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
