# 内容没变就不重写；写前备份旧文件；dry-run 只打印路径和内容。
models_emit_file() { # <path> <content> <dry>
	local path=$1 content=$2 dry=$3 tmp backup
	if [ "$dry" -eq 1 ]; then
		say "- 将写入 ${path}："
		printf '%s\n' "$content" | sed 's/^/  /'
		return 0
	fi
	tmp="${path}.tmp.$$"
	mkdir -p "$(dirname "$path")"
	printf '%s\n' "$content" >"$tmp"
	if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
		rm -f "$tmp"
		say "= ${path}（未变化）"
		return 0
