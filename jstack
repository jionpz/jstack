# 预算统计用哪个 harness 的 premium：优先 claude-code，否则第一个已配置的。
models_stats_harness() {
	local cfg=$1 h
	if models_json "$cfg" has claude-code 2>/dev/null; then
		printf 'claude-code\n'
		return 0
	fi
	for h in $(models_json "$cfg" harnesses); do
		printf '%s\n' "$h"
		return 0
	done
	return 1
}

# 内容没变就不重写；dry-run 只打印路径和内容。
models_emit_file() { # <path> <content> <dry>
	local path=$1 content=$2 dry=$3 tmp
	if [ "$dry" -eq 1 ]; then
		say "- 将写入 ${path}："
		printf '%s\n' "$content" | sed 's/^/  /'
		return 0
	fi
	tmp="${path}.tmp.$$"
	mkdir -p "$(dirname "$path")"
	printf '%s\n' "$content" >"$tmp"
	if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
		rm -f "$tmp"
		say "= ${path}（未变化）"
		return 0
	fi
	mv "$tmp" "$path"
	say "✓ 已写入 ${path}"
}

