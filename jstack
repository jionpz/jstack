	printf '{"name":"jstack","version":"0.1.0"}\n' >"$h/.pi/agent/npm/node_modules/jstack/package.json"
	printf '{"version":"4.4.4"}\n' >"$h/.pi/agent/npm/node_modules/jstack/plugins/pstack/.claude-plugin/plugin.json"
	printf '{"version":"3.3.3"}\n' >"$h/.cursor/plugins/local/spec/.claude-plugin/plugin.json"
	printf '{"version":"0.9.0"}\n' >"$h/.codex/plugins/cache/jstack/spec/0.9.0/.claude-plugin/plugin.json"
